        }

        def Cube "recess" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </screws/Looks/dark>
            double size = 1
            float3 xformOp:scale = (0.0066, 0.0066, 0.0004)
            double3 xformOp:translate = (0, 0, -0.02185)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "mark" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </screws/Looks/dark>
            double size = 1
            float3 xformOp:scale = (0.0002, 0.001, 0.0004)
            double3 xformOp:translate = (0.0034000000000000002, 0, -0.02185)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

