#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    def Xform "cradle" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 0.15
        bool physics:kinematicEnabled = true
        def Cube "Base" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            double3 xformOp:translate = (0, 0, 0.0025)
            float3 xformOp:scale = (0.052, 0.044, 0.005)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.04, 0.38, 0.62)]
        }
        def Cube "WallXPlus" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            double3 xformOp:translate = (0.0185, 0, 0.0125)
            float3 xformOp:scale = (0.007, 0.036, 0.015)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.04, 0.38, 0.62)]
        }
        def Cube "WallYPlus" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            double3 xformOp:translate = (0, 0.0145, 0.0125)
            float3 xformOp:scale = (0.03, 0.007, 0.015)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.04, 0.38, 0.62)]
        }
        def Cube "WallXMinus" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            double3 xformOp:translate = (-0.0185, 0, 0.0125)
            float3 xformOp:scale = (0.007, 0.036, 0.015)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.04, 0.38, 0.62)]
        }
        def Cube "WallYMinus" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            double3 xformOp:translate = (0, -0.0145, 0.0125)
            float3 xformOp:scale = (0.03, 0.007, 0.015)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.04, 0.38, 0.62)]
        }
    }
}
