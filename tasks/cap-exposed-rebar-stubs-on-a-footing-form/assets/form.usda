#usda 1.0
(
    defaultPrim = "form"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "form" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
)
{
    def "Looks"
    {
        def Material "ply"
        {
            token outputs:surface.connect = </form/Looks/ply/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.58, 0.38)
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "bar"
        {
            token outputs:surface.connect = </form/Looks/bar/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.3, 0.32)
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "pad"
        {
            token outputs:surface.connect = </form/Looks/pad/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.45, 0.46, 0.48)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    def Cube "floor" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </form/Looks/ply>
        color3f[] primvars:displayColor = [(0.72, 0.58, 0.38)]
        double size = 1
        float3 xformOp:scale = (0.1, 0.6, 0.02)
        double3 xformOp:translate = (0, 0, 0.01)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cylinder "bar_0" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.06
        rel material:binding = </form/Looks/bar>
        color3f[] primvars:displayColor = [(0.3, 0.3, 0.32)]
        double radius = 0.00635
        double3 xformOp:translate = (0, -0.24, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "bar_1" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.06
        rel material:binding = </form/Looks/bar>
        color3f[] primvars:displayColor = [(0.3, 0.3, 0.32)]
        double radius = 0.00635
        double3 xformOp:translate = (0, -0.12, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "bar_2" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.06
        rel material:binding = </form/Looks/bar>
        color3f[] primvars:displayColor = [(0.3, 0.3, 0.32)]
        double radius = 0.00635
        double3 xformOp:translate = (0, 0, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "bar_3" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.06
        rel material:binding = </form/Looks/bar>
        color3f[] primvars:displayColor = [(0.3, 0.3, 0.32)]
        double radius = 0.00635
        double3 xformOp:translate = (0, 0.12, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "bar_4" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.06
        rel material:binding = </form/Looks/bar>
        color3f[] primvars:displayColor = [(0.3, 0.3, 0.32)]
        double radius = 0.00635
        double3 xformOp:translate = (0, 0.24, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "pad_0" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </form/Looks/pad>
        color3f[] primvars:displayColor = [(0.45, 0.46, 0.48)]
        double size = 1
        float3 xformOp:scale = (0.07, 0.07, 0.004)
        double3 xformOp:translate = (-0.125, -0.12, 0.002)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "pad_1" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </form/Looks/pad>
        color3f[] primvars:displayColor = [(0.45, 0.46, 0.48)]
        double size = 1
        float3 xformOp:scale = (0.07, 0.07, 0.004)
        double3 xformOp:translate = (-0.125, 0, 0.002)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "pad_2" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </form/Looks/pad>
        color3f[] primvars:displayColor = [(0.45, 0.46, 0.48)]
        double size = 1
        float3 xformOp:scale = (0.07, 0.07, 0.004)
        double3 xformOp:translate = (-0.125, 0.12, 0.002)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

