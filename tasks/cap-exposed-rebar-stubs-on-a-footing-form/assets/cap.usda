    def "Looks"
    {
        def Material "plate"
        {
            token outputs:surface.connect = </cap/Looks/plate/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.45, 0.05)
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "body"
        {
            token outputs:surface.connect = </cap/Looks/body/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.14, 0.14, 0.15)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "jaw"
        {
            token outputs:surface.connect = </cap/Looks/jaw/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.3, 0.32)
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
    }

    def Xform "jaw_p" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
