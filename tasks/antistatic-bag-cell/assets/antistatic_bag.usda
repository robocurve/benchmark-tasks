                int[] faceVertexIndices = [0, 1, 50, 49, 1, 2, 51, 50, 2, 3, 52, 51, 3, 4, 53, 52, 4, 5, 54, 53, 5, 6, 55, 54, 6, 7, 56, 55, 7, 8, 57, 56, 8, 9, 58, 57, 9, 10, 59, 58, 10, 11, 60, 59, 11, 12, 61, 60, 12, 13, 62, 61, 13, 14, 63, 62, 14, 15, 64, 63, 15, 16, 65, 64, 16, 17, 66, 65, 17, 18, 67, 66, 18, 19, 68, 67, 19, 20, 69, 68, 20, 21, 70, 69, 21, 22, 71, 70, 22, 23, 72, 71, 23, 24, 73, 72, 24, 25, 74, 73, 25, 26, 75, 74, 26, 27, 76, 75, 27, 28, 77, 76, 28, 29, 78, 77, 29, 30, 79, 78, 30, 31, 80, 79, 31, 32, 81, 80, 32, 33, 82, 81, 33, 34, 83, 82, 34, 35, 84, 83, 35, 36, 85, 84, 36, 37, 86, 85, 37, 38, 87, 86, 38, 39, 88, 87, 39, 40, 89, 88, 40, 41, 90, 89, 41, 42, 91, 90, 42, 43, 92, 91, 43, 44, 93, 92, 44, 45, 94, 93, 45, 46, 95, 94, 46, 47, 96, 95, 47, 48, 97, 96, 49, 50, 99, 98, 50, 51, 100, 99, 51, 52, 101, 100, 52, 53, 102, 101, 53, 54, 103, 102, 54, 55, 104, 103, 55, 56, 105, 104, 56, 57, 106, 105, 57, 58, 107, 106, 58, 59, 108, 107, 59, 60, 109, 108, 60, 61, 110, 109, 61, 62, 111, 110, 62, 63, 112, 111, 63, 64, 113, 112, 64, 65, 114, 113, 65, 66, 115, 114, 66, 67, 116, 115, 67, 68, 117, 116, 68, 69, 118, 117, 69, 70, 119, 118, 70, 71, 120, 119, 71, 72, 121, 120, 72, 73, 122, 121, 73, 74, 123, 122, 74, 75, 124, 123, 75, 76, 125, 124, 76, 77, 126, 125, 77, 78, 127, 126, 78, 79, 128, 127, 79, 80, 129, 128, 80, 81, 130, 129, 81, 82, 131, 130, 82, 83, 132, 131, 83, 84, 133, 132, 84, 85, 134, 133, 85, 86, 135, 134, 86, 87, 136, 135, 87, 88, 137, 136, 88, 89, 138, 137, 89, 90, 139, 138, 90, 91, 140, 139, 91, 92, 141, 140, 92, 93, 142, 141, 93, 94, 143, 142, 94, 95, 144, 143, 95, 96, 145, 144, 96, 97, 146, 145, 98, 99, 148, 147, 99, 100, 149, 148, 100, 101, 150, 149, 101, 102, 151, 150, 102, 103, 152, 151, 103, 104, 153, 152, 104, 105, 154, 153, 105, 106, 155, 154, 106, 107, 156, 155, 107, 108, 157, 156, 108, 109, 158, 157, 109, 110, 159, 158, 110, 111, 160, 159, 111, 112, 161, 160, 112, 113, 162, 161, 113, 114, 163, 162, 114, 115, 164, 163, 115, 116, 