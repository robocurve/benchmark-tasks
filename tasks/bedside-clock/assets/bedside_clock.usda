    def "Looks"
    {
        def Material "case"
        {
            token outputs:surface.connect = </bedside_clock/Looks/case/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.11, 0.11, 0.12)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "bezel"
        {
            token outputs:surface.connect = </bedside_clock/Looks/bezel/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.07, 0.07, 0.08)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "ink"
        {
            token outputs:surface.connect = </bedside_clock/Looks/ink/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.95, 0.92)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "top"
        {
            token outputs:surface.connect = </bedside_clock/Looks/top/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </bedside_clock/Looks/top/texture.outputs:rgb>
                float inputs:roughness = 0.6
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/clock_top.png@
                float2 inputs:st.connect = </bedside_clock/Looks/top/st.outputs:result>
                float3 outputs:rgb
            }
        }

        def Material "drum_hours"
        {
            token outputs:surface.connect = </bedside_clock/Looks/drum_hours/surface.outputs:surface>

            def Shader "surface"
            {
