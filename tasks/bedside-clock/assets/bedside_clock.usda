                float3 outputs:rgb
            }
        }

        def Material "cap"
        {
            token outputs:surface.connect = </bedside_clock/Looks/cap/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.57, 0.6)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
