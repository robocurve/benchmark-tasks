    def "Looks"
    {
        def Material "rim"
        {
            token outputs:surface.connect = </analog_clock/Looks/rim/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.16, 0.17, 0.19)
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "face"
        {
            token outputs:surface.connect = </analog_clock/Looks/face/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </analog_clock/Looks/face/texture.outputs:rgb>
                float inputs:roughness = 0.55
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/analog_face.png@
                float2 inputs:st.connect = </analog_clock/Looks/face/st.outputs:result>
                float3 outputs:rgb
            }
        }

        def Material "wood"
        {
            token outputs:surface.connect = </analog_clock/Looks/wood/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5, 0.37, 0.24)
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
    }

