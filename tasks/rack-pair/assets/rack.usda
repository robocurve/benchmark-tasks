#usda 1.0
(
    defaultPrim = "rack"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "rack" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
)
{
    bool physics:kinematicEnabled = 1

    def "Looks"
    {
        def Material "post"
        {
            token outputs:surface.connect = </rack/Looks/post/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.055)
                float inputs:metallic = 0.2
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "zinc"
        {
            token outputs:surface.connect = </rack/Looks/zinc/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.71, 0.73)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "hole"
        {
            token outputs:surface.connect = </rack/Looks/hole/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.005, 0.005, 0.005)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "slide" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.05
            float physics:restitution = 0
            float physics:staticFriction = 0.05
            custom token physxMaterial:frictionCombineMode = "min"
        }
    }

    def Cube "front_flange_a" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </rack/Looks/post>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.03, 0.002, 0.43205)
        double3 xformOp:translate = (-0.24, 0.381, 0.9935250000000001)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

