        }

        def Material "button"
        {
            token outputs:surface.connect = </server/Looks/button/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.56, 0.58)
                float inputs:metallic = 0.6
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
