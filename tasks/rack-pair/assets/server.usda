#usda 1.0
(
    defaultPrim = "server"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "server" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    point3f physics:centerOfMass = (0, 0.13280626, 0.02175)
    float3 physics:diagonalInertia = (0.0789984, 0.0984792, 0.1754592)
    float physics:mass = 6.4

    def "Looks"
    {
        def Material "black"
        {
            token outputs:surface.connect = </server/Looks/black/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.035, 0.035, 0.04)
                float inputs:metallic = 0.3
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "panel"
        {
            token outputs:surface.connect = </server/Looks/panel/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.06, 0.065)
                float inputs:metallic = 0.6
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "rib"
        {
            token outputs:surface.connect = </server/Looks/rib/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.16, 0.16, 0.17)
                float inputs:metallic = 0.7
                float inputs:roughness = 0.3
                token outputs:surface
            }
