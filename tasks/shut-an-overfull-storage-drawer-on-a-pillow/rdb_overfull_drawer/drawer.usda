    def Scope "Materials"
    {
        def Material "frame" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Fixture/Materials/frame/Surface.outputs:surface>
            float physics:dynamicFriction = 0.2
            float physics:restitution = 0
            float physics:staticFriction = 0.2
            uniform token physxMaterial:frictionCombineMode = "average"
            uniform token physxMaterial:restitutionCombineMode = "min"

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.93, 0.93, 0.91)
                float inputs:opacity = 1.0
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

