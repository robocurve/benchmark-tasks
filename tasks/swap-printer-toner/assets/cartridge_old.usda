#usda 1.0
(
    defaultPrim = "cartridge"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "cartridge" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    point3f physics:centerOfMass = (0, 0, -0.005)
    float3 physics:diagonalInertia = (0.005669583, 0.0008295833, 0.005756667)
    float physics:mass = 0.55
    quatf physics:principalAxes = (1, 0, 0, 0)

    def Scope "Looks"
    {
        def Material "body"
        {
            token outputs:surface.connect = </cartridge/Looks/body/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.06, 0.07)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "handle"
        {
            token outputs:surface.connect = </cartridge/Looks/handle/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.45, 0.46, 0.48)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

    def Cube "body" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </cartridge/Looks/body>
        color3f[] primvars:displayColor = [(0.06, 0.06, 0.07)]
        double size = 1
        float3 xformOp:scale = (0.1, 0.34, 0.09)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "handle" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </cartridge/Looks/handle>
        color3f[] primvars:displayColor = [(0.45, 0.46, 0.48)]
        double size = 1
        float3 xformOp:scale = (0.04, 0.016, 0.045)
        double3 xformOp:translate = (0, 0, 0.0675)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "boss_left" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </cartridge/Looks/body>
        color3f[] primvars:displayColor = [(0.06, 0.06, 0.07)]
        double size = 1
        float3 xformOp:scale = (0.01, 0.0135, 0.018)
        double3 xformOp:translate = (0.035, 0.17675000000000002, 0.003999999999999999)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "boss_right" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </cartridge/Looks/body>
        color3f[] primvars:displayColor = [(0.06, 0.06, 0.07)]
        double size = 1
        float3 xformOp:scale = (0.01, 0.0135, 0.01)
        double3 xformOp:translate = (0.035, -0.17675000000000002, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

