            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.00034906584
            float drive:angular:physics:maxForce = 100
            float drive:angular:physics:stiffness = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Y"
            rel physics:body0 = </printer/Geometry/body>
            rel physics:body1 = </printer/Geometry/body/door>
            point3f physics:localPos0 = (0, 0, 0.055)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0, 0, 0, 1)
            quatf physics:localRot1 = (0, 0, 0, 1)
