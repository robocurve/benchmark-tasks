#usda 1.0
(
    defaultPrim = "printer"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "printer"
{
    def Scope "Looks"
    {
        def Material "case"
        {
            token outputs:surface.connect = </printer/Looks/case/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.86, 0.84)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "rail"
        {
            token outputs:surface.connect = </printer/Looks/rail/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.25, 0.26, 0.28)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "roller"
        {
            token outputs:surface.connect = </printer/Looks/roller/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.05)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "door"
        {
            token outputs:surface.connect = </printer/Looks/door/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.71, 0.7)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "abs_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.25
            float physics:restitution = 0
            float physics:staticFriction = 0.3
            custom token physxMaterial:frictionCombineMode = "min"
        }

        def Material "rubber_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0
            float physics:staticFriction = 0.9
            custom token physxMaterial:frictionCombineMode = "max"
        }
    }

    def Scope "Geometry"
    {
        def Xform "body" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "PhysicsMassAPI"]
        )
        {
