    def Scope "Joints"
    {
        def PhysicsRevoluteJoint "BailPivot" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            doc = "The bail lever's pivot on the yoke: 0 with the stopper seated and the link just taut, positive pushing the lever down. Centre (crank straight under the pivot, the link stretched 1.32 mm) at 30.8 degrees; the stop at 45.8, 15 degrees past centre. No spring, light friction as damping."
        )
        {
            float drive:angular:physics:damping = 0.000034906585
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Y"
            rel physics:body0 = </SwingTopBottle/Bottle>
            rel physics:body1 = </SwingTopBottle/Lever>
            point3f physics:localPos0 = (0, 0, 0.162)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0, 0, 0, 1)
            quatf physics:localRot1 = (0, 0, 0, 1)
            float physics:lowerLimit = -80
            float physics:upperLimit = 45.763027
        }

        def PhysicsRevoluteJoint "LinkPivot" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            doc = "The link's hook on the lever's crank. No spring, light damping."
        )
        {
            float drive:angular:physics:damping = 0.000008726646
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Y"
            rel physics:body0 = </SwingTopBottle/Lever>
            rel physics:body1 = </SwingTopBottle/Link>
            point3f physics:localPos0 = (-0.0061378614, 0, -0.010311482)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0, 0, 0, 1)
            quatf physics:localRot1 = (0, 0, 0, 1)
            float physics:lowerLimit = -170
            float physics:upperLimit = 170
        }

        def PhysicsPrismaticJoint "SealSlide" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear"]
            doc = "The link's give (the gasket compressing and the wire stretching), along the link: 0 unstretched, up to 8 mm; a 100 N/mm spring with a 0 target. The link does not shorten (lower limit 0)."
        )
        {
            float drive:linear:physics:damping = 20
            float drive:linear:physics:stiffness = 100000
            float drive:linear:physics:targetPosition = 0
            uniform token drive:linear:physics:type = "force"
            uniform token physics:axis = "Z"
            rel physics:body0 = </SwingTopBottle/Link>
            rel physics:body1 = </SwingTopBottle/Carrier>
            point3f physics:localPos0 = (0.0061378614, 0, 0.050311483)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.9981584, 0, 0.060661405, 0)
            quatf physics:localRot1 = (0.9981584, 0, 0.060661405, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.008
        }

        def PhysicsRevoluteJoint "StopperHinge" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            doc = "The stopper turning on the link's crossbar (through the hole across its head). 0: upright when seated."
        )
        {
            float drive:angular:physics:damping = 0.000005235988
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetPosition = 0
