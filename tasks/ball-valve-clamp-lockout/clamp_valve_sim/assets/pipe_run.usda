        def Material "tex_clampvalve_tag_V12"
        {
            token outputs:surface.connect = </pipe_run/Looks/tex_clampvalve_tag_V12/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </pipe_run/Looks/tex_clampvalve_tag_V12/tex.outputs:rgb>
                float inputs:roughness = 0.7
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./clampvalve_tag_V12.png@
                float2 inputs:st.connect = </pipe_run/Looks/tex_clampvalve_tag_V12/st.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }

