    def "joints"
    {
        def PhysicsFixedJoint "world_fixed"
        {
            rel physics:body1 = </pipe_run/base>
        }

        def PhysicsRevoluteJoint "lever_0_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </pipe_run/base>
            rel physics:body1 = </pipe_run/lever_0>
            point3f physics:localPos0 = (0.26, 0, 0.135)
            point3f physics:localPos1 = (0, 0, 0)
            float physics:lowerLimit = -90
            float physics:upperLimit = 0
        }

        def PhysicsRevoluteJoint "lever_1_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
