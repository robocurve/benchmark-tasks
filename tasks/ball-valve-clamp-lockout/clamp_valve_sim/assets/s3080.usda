    def "joints"
    {
        def PhysicsPrismaticJoint "slide_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear"]
        )
        {
            uniform token physics:axis = "X"
            rel physics:body0 = </s3080/half_a>
            rel physics:body1 = </s3080/half_b>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.039
        }
    }

    def "PhysicsMaterials"
    {
        def Material "plastic" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:staticFriction = 0.5
            custom token physxMaterial:frictionCombineMode = "average"
        }
