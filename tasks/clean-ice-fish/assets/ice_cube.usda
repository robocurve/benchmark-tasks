#usda 1.0
(
    defaultPrim = "IceCube"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "IceCube" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
    customData = {
        string assetDescription = "20 mm bevelled rigid ice cube; translucent portable USD Preview Surface, not a fluid or melting simulation."
    }
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float physics:mass = 0.0073
    bool physics:rigidBodyEnabled = 1
    custom int physxRigidBody:solverPositionIterationCount = 16
    custom int physxRigidBody:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "Ice"
        {
            token outputs:surface.connect = </IceCube/Looks/Ice/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0.18
                float inputs:clearcoatRoughness = 0.12
                color3f inputs:diffuseColor = (0.25295007, 0.4769998, 0.67385954)
                float inputs:ior = 1.31
                float inputs:metallic = 0
                float inputs:opacity = 0.2
                float inputs:roughness = 0.12
                token outputs:surface
            }
        }

        def Material "Frost"
        {
            token outputs:surface.connect = </IceCube/Looks/Frost/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0.18
                float inputs:clearcoatRoughness = 0.12
                color3f inputs:diffuseColor = (0.6382832, 0.8073459, 0.9551046)
                float inputs:ior = 1.31
                float inputs:metallic = 0
                float inputs:opacity = 0.08
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }

        def Material "Air"
        {
            token outputs:surface.connect = </IceCube/Looks/Air/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0.18
                float inputs:clearcoatRoughness = 0.12
                color3f inputs:diffuseColor = (0.84808826, 0.9551046, 1)
                float inputs:ior = 1
                float inputs:metallic = 0
                float inputs:opacity = 0.5
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }
    }

