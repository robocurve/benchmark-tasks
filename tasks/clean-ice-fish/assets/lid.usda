#usda 1.0
(
    defaultPrim = "Lid"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Lid" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
    customData = {
        string assetDescription = "Loose removable lid, no latch or hinge. 24 mm bridge grip with 57 mm free space below the bar."
        double3 graspCenterLocal = (0, 0, 0.075)
    }
)
{
    point3f physics:centerOfMass = (0, 0, 0.009)
    float physics:mass = 0.115
    bool physics:rigidBodyEnabled = 1
    custom int physxRigidBody:solverPositionIterationCount = 16
    custom int physxRigidBody:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "BlueRim"
        {
            token outputs:surface.connect = </Lid/Looks/BlueRim/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0.18
                float inputs:clearcoatRoughness = 0.12
                color3f inputs:diffuseColor = (0.233022, 0.4769998, 0.7293471)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }

        def Material "FrostedPanel"
        {
            token outputs:surface.connect = </Lid/Looks/FrostedPanel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0.18
                float inputs:clearcoatRoughness = 0.12
                color3f inputs:diffuseColor = (0.31854677, 0.55422175, 0.76776874)
                float inputs:ior = 1.46
                float inputs:metallic = 0
                float inputs:opacity = 0.25
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }
    }

