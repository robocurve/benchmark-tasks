#usda 1.0
(
    defaultPrim = "Scoop"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Scoop" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
    customData = {
        string assetDescription = "Open-front hollow scoop, thin leading edge and 24 mm elevated grip. A visible dense end cap counterbalances the light bucket around the grasp point."
        double3 graspCenterLocal = (-0.11, 0, 0.034)
    }
)
{
    point3f physics:centerOfMass = (-0.11, 0, 0.03)
    float physics:mass = 0.125
    bool physics:rigidBodyEnabled = 1
    custom int physxRigidBody:solverPositionIterationCount = 16
    custom int physxRigidBody:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "Steel"
        {
            token outputs:surface.connect = </Scoop/Looks/Steel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0.18
                float inputs:clearcoatRoughness = 0.12
                color3f inputs:diffuseColor = (0.49190503, 0.53823555, 0.58701634)
                float inputs:ior = 1.5
                float inputs:metallic = 0.92
                float inputs:roughness = 0.23
                token outputs:surface
            }
        }

        def Material "Handle"
        {
            token outputs:surface.connect = </Scoop/Looks/Handle/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0.18
                float inputs:clearcoatRoughness = 0.12
                color3f inputs:diffuseColor = (0.00440085, 0.0049991165, 0.0055319592)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }
    }

