                            rel material:binding = </World/Looks/ArmBlack> (
                                bindMaterialAs = "strongerThanDescendants"
                            )
                        }

                        over "link1"
                        {
                            matrix4d xformOp:transform = ( (0.000003708922732370216, 2.7065876326498477e-11, -0.9999999999931223, 0), (0.000007346410042222072, -0.9999999999730158, 1.8139087957431727e-13, 0), (-0.9999999999661374, -0.000007346410042172216, -0.000003708922731926127, 0), (0, 0, 0.06800000369548798, 1) )
                            uniform token[] xformOpOrder = ["xformOp:transform"]

                            over "link1" (
