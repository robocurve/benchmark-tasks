#usda 1.0
(
    defaultPrim = "Fish"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Fish" (
    customData = {
        string assetDescription = "Static fish cue lying partly buried in the contaminated ice. Scaled silver skin, visible eye, fins, gill and forked tail."
    }
)
{
    def "Looks"
    {
        def Material "Scales"
        {
            token outputs:surface.connect = </Fish/Looks/Scales/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0.18
                float inputs:clearcoatRoughness = 0.12
                color3f inputs:diffuseColor = (0.25295007, 0.36724648, 0.4064483)
                color3f inputs:diffuseColor.connect = </Fish/Looks/Scales/Texture.outputs:rgb>
                float inputs:ior = 1.5
                float inputs:metallic = 0.38
                float inputs:roughness = 0.34
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/fish_skin_generated.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Fish/Looks/Scales/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "Fins"
        {
            token outputs:surface.connect = </Fish/Looks/Fins/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0.18
                float inputs:clearcoatRoughness = 0.12
                color3f inputs:diffuseColor = (0.05087609, 0.088981524, 0.10653923)
                float inputs:ior = 1.5
                float inputs:metallic = 0.05
                float inputs:opacity = 0.85
                float inputs:roughness = 0.44
                token outputs:surface
            }
        }

        def Material "Gill"
        {
            token outputs:surface.connect = </Fish/Looks/Gill/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0.18
                float inputs:clearcoatRoughness = 0.12
                color3f inputs:diffuseColor = (0.043233637, 0.068384856, 0.073238954)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }

        def Material "Iris"
        {
            token outputs:surface.connect = </Fish/Looks/Iris/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0.18
                float inputs:clearcoatRoughness = 0.12
                color3f inputs:diffuseColor = (0.33034372, 0.22341399, 0.05087609)
                float inputs:ior = 1.5
                float inputs:metallic = 0.3
                float inputs:roughness = 0.24
                token outputs:surface
            }
        }

        def Material "Pupil"
        {
            token outputs:surface.connect = </Fish/Looks/Pupil/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0.18
                float inputs:clearcoatRoughness = 0.12
                color3f inputs:diffuseColor = (0.0013931888, 0.0017027864, 0.0018575852)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:roughness = 0.14
                token outputs:surface
            }
        }

        def Material "Glint"
        {
            token outputs:surface.connect = </Fish/Looks/Glint/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0.18
                float inputs:clearcoatRoughness = 0.12
                color3f inputs:diffuseColor = (0.8900054, 0.9551046, 1)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:roughness = 0.1
                token outputs:surface
            }
        }
    }

