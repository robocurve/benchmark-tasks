#usda 1.0
(
    defaultPrim = "Body"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Body" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI", "PhysxContactReportAPI"]) {
    float physics:mass = 0.028
    bool physics:rigidBodyEnabled = true
    float physxRigidBody:linearDamping = 0.1
    float physxRigidBody:angularDamping = 1
    float physxRigidBody:maxDepenetrationVelocity = 0.3
    int physxRigidBody:solverPositionIterationCount = 32
    int physxRigidBody:solverVelocityIterationCount = 8
    float physxContactReport:threshold = 0
    def Material "PhysicsMaterial" (prepend apiSchemas = ["PhysicsMaterialAPI"]) {
        float physics:staticFriction = 0.9
        float physics:dynamicFriction = 0.7
        float physics:restitution = 0
    }
    def Material "blue" {
        token outputs:surface.connect = </Body/blue/Shader.outputs:surface>
        def Shader "Shader" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.19, 0.35, 0.52)
            float inputs:roughness = 0.6
            token outputs:surface
        }
    }
    def Material "steel" {
        token outputs:surface.connect = </Body/steel/Shader.outputs:surface>
        def Shader "Shader" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.65, 0.68, 0.71)
            float inputs:roughness = 0.6
            token outputs:surface
        }
    }
    def Material "dark" {
        token outputs:surface.connect = </Body/dark/Shader.outputs:surface>
        def Shader "Shader" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.07, 0.08, 0.09)
            float inputs:roughness = 0.6
            token outputs:surface
        }
    }
    def Material "red" {
        token outputs:surface.connect = </Body/red/Shader.outputs:surface>
        def Shader "Shader" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.65, 0.07, 0.06)
            float inputs:roughness = 0.6
            token outputs:surface
        }
    }
    def Material "black" {
        token outputs:surface.connect = </Body/black/Shader.outputs:surface>
        def Shader "Shader" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.055, 0.055, 0.055)
            float inputs:roughness = 0.6
            token outputs:surface
        }
    }
    def Material "rubber" {
        token outputs:surface.connect = </Body/rubber/Shader.outputs:surface>
        def Shader "Shader" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.16, 0.17, 0.19)
            float inputs:roughness = 0.6
            token outputs:surface
        }
    }
    def Material "green" {
        token outputs:surface.connect = </Body/green/Shader.outputs:surface>
        def Shader "Shader" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.1, 0.48, 0.22)
            float inputs:roughness = 0.6
            token outputs:surface
        }
    }
    def Material "yellow" {
        token outputs:surface.connect = </Body/yellow/Shader.outputs:surface>
        def Shader "Shader" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.85, 0.57, 0.04)
            float inputs:roughness = 0.6
            token outputs:surface
        }
    }
    def Material "lcd" {
        token outputs:surface.connect = </Body/lcd/Shader.outputs:surface>
        def Shader "Shader" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.025, 0.06, 0.045)
            float inputs:roughness = 0.6
            token outputs:surface
        }
    }
    def Material "lit" {
        token outputs:surface.connect = </Body/lit/Shader.outputs:surface>
        def Shader "Shader" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.4, 0.95, 0.6)
            float inputs:roughness = 0.6
            token outputs:surface
        }
    }
    def Cylinder "insulated_handle" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]) {
        double radius = 0.008
        double height = 0.07
        uniform token axis = "Y"
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </Body/red>
        bool physics:collisionEnabled = true
        float physxCollision:contactOffset = 0.0003
        float physxCollision:restOffset = 0
        rel material:binding:physics = </Body/PhysicsMaterial>
    }
    def Cylinder "finger_guard" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]) {
        double radius = 0.012
        double height = 0.004
        uniform token axis = "Y"
        double3 xformOp:translate = (0, 0.032, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </Body/red>
        bool physics:collisionEnabled = true
        float physxCollision:contactOffset = 0.0003
        float physxCollision:restOffset = 0
        rel material:binding:physics = </Body/PhysicsMaterial>
    }
    def Cylinder "insulated_nose" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]) {
        double radius = 0.004
        double height = 0.05
        uniform token axis = "Y"
        double3 xformOp:translate = (0, 0.062, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </Body/red>
        bool physics:collisionEnabled = true
        float physxCollision:contactOffset = 0.0003
        float physxCollision:restOffset = 0
        rel material:binding:physics = </Body/PhysicsMaterial>
    }
    def Cylinder "metal_shaft" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]) {
        double radius = 0.0014
        double height = 0.028
        uniform token axis = "Y"
        double3 xformOp:translate = (0, 0.101, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </Body/steel>
        bool physics:collisionEnabled = true
        float physxCollision:contactOffset = 0.0003
        float physxCollision:restOffset = 0
        rel material:binding:physics = </Body/PhysicsMaterial>
    }
    def Sphere "metal_tip" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]) {
        double radius = 0.0015
        double3 xformOp:translate = (0, 0.1155, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </Body/steel>
        bool physics:collisionEnabled = true
        float physxCollision:contactOffset = 0.0003
        float physxCollision:restOffset = 0
        rel material:binding:physics = </Body/PhysicsMaterial>
    }

}
