#usda 1.0
(
    defaultPrim = "lever_tool"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "lever_tool" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.091

    def "Looks"
    {
        def Material "steel"
        {
            token outputs:surface.connect = </lever_tool/Looks/steel/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.73, 0.76)
                float inputs:opacity = 1
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "abs"
        {
            token outputs:surface.connect = </lever_tool/Looks/abs/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.5, 0.08)
                float inputs:opacity = 1
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    def Cube "blade" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </lever_tool/Looks/steel>
        color3f[] primvars:displayColor = [(0.72, 0.73, 0.76)]
        double size = 1
        float3 xformOp:scale = (0.125, 0.024, 0.002)
        double3 xformOp:translate = (0.0125, 0, 0.001)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "fin" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </lever_tool/Looks/abs>
        color3f[] primvars:displayColor = [(0.95, 0.5, 0.08)]
        double size = 1
        float3 xformOp:scale = (0.1, 0.01, 0.04)
        double3 xformOp:translate = (0, 0, 0.022)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

