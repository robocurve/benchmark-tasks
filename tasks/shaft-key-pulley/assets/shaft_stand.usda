#usda 1.0
(
    defaultPrim = "ShaftStand"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "ShaftStand" (
    doc = "A 25 mm keyed shaft in a pillow-block bearing on a pedestal, with a hand crank on its far end. Origin at the underside centre of the base plate; +x along the shaft toward the pulley seat. Bodies: Stand (the articulation's root, to be fixed), Shaft (turns in the bearing, joint ShaftBearing about x; drawn at rest: crank hanging down, keyway facing -y; at -90 degrees the keyway faces up), Grip (the crank handle's sleeve, spinning on its pin, joint GripSpin)."
)
{
    def Scope "Looks"
    {
        def Material "Paint_Blue"
        {
            token outputs:surface.connect = </ShaftStand/Looks/Paint_Blue/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.27, 0.55)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "Steel_Dark"
        {
            token outputs:surface.connect = </ShaftStand/Looks/Steel_Dark/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.21, 0.23)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "Steel_Bright"
        {
            token outputs:surface.connect = </ShaftStand/Looks/Steel_Bright/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.74, 0.75, 0.78)
                float inputs:metallic = 1
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "Grip_Red"
        {
            token outputs:surface.connect = </ShaftStand/Looks/Grip_Red/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.1, 0.08)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Phys_Steel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.45
        }

        def Material "Phys_Grip" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0
            float physics:staticFriction = 0.9
        }
    }

