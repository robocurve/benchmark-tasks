#usda 1.0
(
    defaultPrim = "Pulley"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Pulley" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "An aluminium V-belt pulley (web type, four spokes), 80 mm, bore 25.5 mm with a 8.2 mm keyway, hub 50 mm with two flats 42 mm apart. Origin at the centre of the face that goes against the shaft's shoulder; +z along the bore toward the hub's end; +x toward the keyway. A red line on the hub's end marks the keyway."
)
{
    float physics:mass = 0.2171163
    custom float physxRigidBody:maxDepenetrationVelocity = 0.5
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def Scope "Looks"
    {
        def Material "Aluminium_Natural"
        {
            token outputs:surface.connect = </Pulley/Looks/Aluminium_Natural/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.81, 0.83)
                float inputs:metallic = 1
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "Mark_Red"
        {
            token outputs:surface.connect = </Pulley/Looks/Mark_Red/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.08, 0.06)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Phys_Aluminium" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }
    }

    def Mesh "Body" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
