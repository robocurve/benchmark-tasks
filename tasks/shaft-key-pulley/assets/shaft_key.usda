        rel material:binding = </ShaftKey/Looks/Zinc_Yellow>
        point3f[] points = [(-0.02, -0.0035, -0.003), (-0.02, -0.0035, 0.003), (-0.02, 0.0035, -0.003), (-0.02, 0.0035, 0.003), (-0.0195, -0.004, -0.003), (-0.0195, -0.004, 0.003), (-0.0195, -0.0035, -0.0035), (-0.0195, -0.0035, 0.0035), (-0.0195, 0.0035, -0.0035), (-0.0195, 0.0035, 0.0035), (-0.0195, 0.004, -0.003), (-0.0195, 0.004, 0.003), (0.0195, -0.004, -0.003), (0.0195, -0.004, 0.003), (0.0195, -0.0035, -0.0035), (0.0195, -0.0035, 0.0035), (0.0195, 0.0035, -0.0035), (0.0195, 0.0035, 0.0035), (0.0195, 0.004, -0.003), (0.0195, 0.004, 0.003), (0.02, -0.0035, -0.003), (0.02, -0.0035, 0.003), (0.02, 0.0035, -0.003), (0.02, 0.0035, 0.003)]
        uniform token subdivisionScheme = "none"
    }

    def Scope "Colliders"
    {
        def Mesh "Key" (
            prepend apiSchemas = ["PhysicsMeshCollisionAPI", "PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
            int[] faceVertexIndices = [4, 0, 6, 19, 17, 23, 9, 11, 3, 22, 16, 18, 8, 2, 10, 5, 7, 1, 12, 14, 20, 13, 21, 15, 2, 0, 1, 2, 1, 3, 11, 2, 3, 11, 10, 2, 19, 10, 11, 19, 18, 10, 9, 3, 1, 9, 1, 7, 9, 7, 15, 9, 15, 17, 9, 19, 11, 9, 17, 19, 21, 17, 15, 21, 23, 17, 22, 23, 21, 22, 21, 20, 22, 20, 14, 22, 14, 16, 22, 18, 19, 22, 19, 23, 8, 10, 18, 8, 18, 16, 8, 16, 14, 8, 14, 6, 8, 0, 2, 8, 6, 0, 5, 1, 0, 5, 0, 4, 12, 6, 14, 12, 4, 6, 13, 20, 21, 13, 12, 20, 13, 15, 7, 13, 7, 5, 13, 5, 4, 13, 4, 12]
            rel material:binding:physics = </ShaftKey/Looks/Phys_Steel> (
                bindMaterialAs = "weakerThanDescendants"
            )
            uniform token physics:approximation = "convexHull"
            custom float physxCollision:contactOffset = 0.001
            custom float physxCollision:restOffset = 0
            point3f[] points = [(-0.02, -0.0035, -0.003), (-0.02, -0.0035, 0.003), (-0.02, 0.0035, -0.003), (-0.02, 0.0035, 0.003), (-0.0195, -0.004, -0.003), (-0.0195, -0.004, 0.003), (-0.0195, -0.0035, -0.0035), (-0.0195, -0.0035, 0.0035), (-0.0195, 0.0035, -0.0035), (-0.0195, 0.0035, 0.0035), (-0.0195, 0.004, -0.003), (-0.0195, 0.004, 0.003), (0.0195, -0.004, -0.003), (0.0195, -0.004, 0.003), (0.0195, -0.0035, -0.0035), (0.0195, -0.0035, 0.0035), (0.0195, 0.0035, -0.0035), (0.0195, 0.0035, 0.0035), (0.0195, 0.004, -0.003), (0.0195, 0.004, 0.003), (0.02, -0.0035, -0.003), (0.02, -0.0035, 0.003), (0.02, 0.0035, -0.003), (0.02, 0.0035, 0.003)]
