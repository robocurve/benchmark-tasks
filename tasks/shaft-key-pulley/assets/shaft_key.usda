#usda 1.0
(
    defaultPrim = "ShaftKey"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "ShaftKey" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "A parallel key, 8 x 7 x 40 mm, zinc-plated steel, every edge chamfered 0.5 mm. Origin at its centre; +x along its length."
)
{
    float physics:mass = 0.017373359
    custom float physxRigidBody:maxDepenetrationVelocity = 0.5
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def Scope "Looks"
    {
        def Material "Zinc_Yellow"
        {
            token outputs:surface.connect = </ShaftKey/Looks/Zinc_Yellow/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.66, 0.16)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "Phys_Steel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }
    }

    def Mesh "Key" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.02, -0.004, -0.0035), (0.02, 0.004, 0.0035)]
        int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
