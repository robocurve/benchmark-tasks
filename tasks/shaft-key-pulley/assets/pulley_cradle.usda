#usda 1.0
(
    defaultPrim = "PulleyCradle"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "PulleyCradle" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "A printed cradle for the pulley: two sloping rests under the rim and a low fence either side of it. Origin at the underside centre; the pulley's bore lies along y."
)
{
    float physics:mass = 0.06
    custom float physxRigidBody:maxDepenetrationVelocity = 0.5
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def Scope "Looks"
    {
        def Material "PLA_Grey"
        {
            token outputs:surface.connect = </PulleyCradle/Looks/PLA_Grey/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.42, 0.44, 0.47)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Phys_PLA" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.45
        }
    }

