        def Cylinder "conductor_rail" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token axis = "Y"
            double height = 0.31
            rel material:binding = </Rheostat/Looks/brass>
            double radius = 0.004
            double3 xformOp:translate = (-0.015, 0, 0.077)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cylinder "return_terminal" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.028
            rel material:binding = </Rheostat/Looks/black>
            double radius = 0.008
            double3 xformOp:translate = (-0.015, 0.16, 0.053)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cylinder "resistor_terminal" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.028
            rel material:binding = </Rheostat/Looks/red>
            double radius = 0.008
            double3 xformOp:translate = (0.025, -0.16, 0.053)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Material "RheostatLabelMaterial"
        {
            token outputs:surface.connect = </Rheostat/base/RheostatLabelMaterial/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 1)
                color3f inputs:diffuseColor.connect = </Rheostat/base/RheostatLabelMaterial/Texture.outputs:rgb>
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @RheostatLabel.png@
                float2 inputs:st.connect = </Rheostat/base/RheostatLabelMaterial/UV.outputs:result>
                color3f outputs:rgb
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
        }

        def Mesh "RheostatLabel" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            rel material:binding = </Rheostat/base/RheostatLabelMaterial>
            point3f[] points = [(-0.0545, 0.08, 0.029), (-0.0545, -0.08, 0.029), (-0.0335, -0.08, 0.029), (-0.0335, 0.08, 0.029)]
            texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
                interpolation = "vertex"
            )
            uniform token subdivisionScheme = "none"
        }
    }

    def Xform "slider" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxContactReportAPI"]
    )
    {
        float physics:mass = 0.06
        float physxContactReport:threshold = 0

        def Cube "grip" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </Rheostat/Looks/blue>
            float physxCollision:contactOffset = 0.0005
            float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.024, 0.032, 0.044)
            double3 xformOp:translate = (-0.015, 0, 0.108)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "contact" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Rheostat/Looks/brass>
            double size = 1
            float3 xformOp:scale = (0.05, 0.012, 0.008)
            double3 xformOp:translate = (0.005, 0, 0.079)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def PhysicsPrismaticJoint "slide" (
        prepend apiSchemas = ["PhysxJointAxisAPI:linear"]
    )
    {
        uniform token physics:axis = "Y"
        rel physics:body0 = </Rheostat/base>
        rel physics:body1 = </Rheostat/slider>
        bool physics:collisionEnabled = 0
        float physics:lowerLimit = -0.13
        float physics:upperLimit = 0.13
        float physxJointAxis:linear:dynamicFrictionEffort = 0.3
        float physxJointAxis:linear:staticFrictionEffort = 0.45
    }
}
