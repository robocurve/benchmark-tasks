    def Cube "battery" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </Circuit/Looks/dark>
        float physxCollision:contactOffset = 0.0005
        float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.16, 0.105, 0.07)
        double3 xformOp:translate = (0.31, 0.27, 0.035)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Material "BatteryLabelMaterial"
    {
        token outputs:surface.connect = </Circuit/BatteryLabelMaterial/Shader.outputs:surface>

        def Shader "Shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (1, 1, 1)
            color3f inputs:diffuseColor.connect = </Circuit/BatteryLabelMaterial/Texture.outputs:rgb>
            color3f inputs:emissiveColor = (0, 0, 0)
            float inputs:metallic = 0
            float inputs:roughness = 0.5
            token outputs:surface
        }

        def Shader "Texture"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @BatteryLabel.png@
            float2 inputs:st.connect = </Circuit/BatteryLabelMaterial/UV.outputs:result>
            color3f outputs:rgb
        }

        def Shader "UV"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            token inputs:varname = "st"
            float2 outputs:result
        }
    }

