#usda 1.0
(
    defaultPrim = "Circuit"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Circuit"
{
    def "Looks"
    {
        def Material "dark"
        {
            token outputs:surface.connect = </Circuit/Looks/dark/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.025, 0.035, 0.045)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
