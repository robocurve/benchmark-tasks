#usda 1.0
(
    defaultPrim = "filter"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "filter" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    point3f physics:centerOfMass = (-0.005, 0, 0)
    float3 physics:diagonalInertia = (0.0005890625, 0.00051125, 0.0010778125)
    float physics:mass = 0.15
    quatf physics:principalAxes = (1, 0, 0, 0)

    def Scope "Looks"
    {
        def Material "frame"
        {
            token outputs:surface.connect = </filter/Looks/frame/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.36, 0.33, 0.28)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "media"
        {
            token outputs:surface.connect = </filter/Looks/media/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.306, 0.2805, 0.238)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "pp_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:restitution = 0
            float physics:staticFriction = 0.35
        }
    }

    def Cube "frame" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </filter/Looks/frame>
        rel material:binding:physics = </filter/Looks/pp_physics> (
            bindMaterialAs = "weakerThanDescendants"
        )
        color3f[] primvars:displayColor = [(0.36, 0.33, 0.28)]
        double size = 1
        float3 xformOp:scale = (0.2, 0.215, 0.03)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "tab" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </filter/Looks/frame>
        rel material:binding:physics = </filter/Looks/pp_physics> (
            bindMaterialAs = "weakerThanDescendants"
        )
        color3f[] primvars:displayColor = [(0.36, 0.33, 0.28)]
        double size = 1
        float3 xformOp:scale = (0.035, 0.016, 0.06)
        double3 xformOp:translate = (-0.11750000000000001, 0, 0.015)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "rib" (
