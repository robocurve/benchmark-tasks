#usda 1.0
(
    defaultPrim = "dash"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "dash"
{
    def Scope "Looks"
    {
        def Material "dash"
        {
            token outputs:surface.connect = </dash/Looks/dash/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.16, 0.16, 0.17)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "bin"
        {
            token outputs:surface.connect = </dash/Looks/bin/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.22, 0.22, 0.23)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "pad"
        {
            token outputs:surface.connect = </dash/Looks/pad/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.3, 0.32)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "stop"
        {
            token outputs:surface.connect = </dash/Looks/stop/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.55, 0.52)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "housing"
        {
            token outputs:surface.connect = </dash/Looks/housing/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.42, 0.4, 0.36)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "abs_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.4
        }

        def Material "pom_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.12
            float physics:restitution = 0
            float physics:staticFriction = 0.15
            custom token physxMaterial:frictionCombineMode = "min"
        }

        def Material "pp_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:restitution = 0
            float physics:staticFriction = 0.35
        }
    }

    def Scope "Geometry"
    {
        def Xform "body" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (0.1, 0, 0.1)
            float3 physics:diagonalInertia = (0.205, 0.16, 0.205)
