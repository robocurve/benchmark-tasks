#usda 1.0
(
    defaultPrim = "Paddle"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Paddle" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    point3f physics:centerOfMass = (0, 0, 0.10839186)
    float3 physics:diagonalInertia = (0.00085238693, 0.0006428663, 0.00021780089)
    float physics:mass = 0.17

    def Cylinder "Blade" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "X"
        double height = 0.007
        color3f[] primvars:displayColor = [(0.65, 0.44, 0.23)]
        double radius = 0.078
        double3 xformOp:translate = (0, 0, 0.13)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "RubberFront" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "X"
        double height = 0.003
        color3f[] primvars:displayColor = [(0.8, 0.02, 0.025)]
        double radius = 0.077
        double3 xformOp:translate = (0.005, 0, 0.13)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "RubberBack" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "X"
        double height = 0.003
        color3f[] primvars:displayColor = [(0.04, 0.04, 0.04)]
        double radius = 0.077
        double3 xformOp:translate = (-0.005, 0, 0.13)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "Handle" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.52, 0.32, 0.15)]
        double size = 1
        float3 xformOp:scale = (0.026, 0.026, 0.11)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }
}

