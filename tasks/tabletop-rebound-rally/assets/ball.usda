#usda 1.0
(
    defaultPrim = "Ball"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Ball" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float3 physics:diagonalInertia = (7.2e-7, 7.2e-7, 7.2e-7)
    bool physics:kinematicEnabled = 1
    float physics:mass = 0.0027
    custom bool physxRigidBody:enableCCD = 0

    def Sphere "Shell" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(1, 0.65, 0.02)]
        double radius = 0.02
    }
}

