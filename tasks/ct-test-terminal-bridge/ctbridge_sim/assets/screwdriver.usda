#usda 1.0
(
    defaultPrim = "screwdriver"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "screwdriver" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    float physics:mass = 0.045
    custom float physxRigidBody:angularDamping = 0.5
    custom float physxRigidBody:linearDamping = 0.2
    custom int physxRigidBody:solverPositionIterationCount = 16

    def "Looks"
    {
        def Material "nickel"
        {
            token outputs:surface.connect = </screwdriver/Looks/nickel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.78, 0.76)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "vde_red"
        {
            token outputs:surface.connect = </screwdriver/Looks/vde_red/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.1, 0.08)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "vde_yellow"
        {
            token outputs:surface.connect = </screwdriver/Looks/vde_yellow/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.75, 0.1)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

    def Cube "blade" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </screwdriver/Looks/nickel>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.0012, 0.0035, 0.008)
        double3 xformOp:translate = (0, 0, 0.004)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "shaft" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </screwdriver/Looks/vde_red>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.003, 0.003, 0.05)
        double3 xformOp:translate = (0, 0, 0.033)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "handle" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </screwdriver/Looks/vde_red>
        rel material:binding:physics = </screwdriver/PhysicsMaterials/rubber> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.022, 0.022, 0.07)
        double3 xformOp:translate = (0, 0, 0.093)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "band" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </screwdriver/Looks/vde_yellow>
        double size = 1
        float3 xformOp:scale = (0.0226, 0.0226, 0.006)
        double3 xformOp:translate = (0, 0, 0.07100000000000001)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def "PhysicsMaterials"
    {
        def Material "rubber" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 1
            float physics:staticFriction = 1.2
            custom token physxMaterial:frictionCombineMode = "max"
        }
    }
}

