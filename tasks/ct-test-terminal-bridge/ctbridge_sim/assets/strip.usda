    def "Looks"
    {
        def Material "urtk"
        {
            token outputs:surface.connect = </strip/Looks/urtk/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.56, 0.56)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

