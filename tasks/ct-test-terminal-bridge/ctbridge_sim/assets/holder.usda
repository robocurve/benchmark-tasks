#usda 1.0
(
    defaultPrim = "holder"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "holder"
{
    def "Looks"
    {
        def Material "stand"
        {
            token outputs:surface.connect = </holder/Looks/stand/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4, 0.4, 0.42)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "urtk"
        {
            token outputs:surface.connect = </holder/Looks/urtk/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.56, 0.56)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

    def Cube "column" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </holder/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.016, 0.022, 0.0496)
        double3 xformOp:translate = (0.2, 0.13, 0.024799999999999996)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "top0" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
