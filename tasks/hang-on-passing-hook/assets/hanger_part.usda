#usda 1.0
(
    defaultPrim = "Part"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Part" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    point3f physics:centerOfMass = (0, 0, -0.022201799)
    float physics:mass = 0.15

    def Cube "top_bar" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.95, 0.45, 0.1)]
        double size = 1
        float3 xformOp:scale = (0.015, 0.084, 0.012)
        double3 xformOp:translate = (0, 0, 0.0385)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "post_left" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.95, 0.45, 0.1)]
        double size = 1
        float3 xformOp:scale = (0.015, 0.012, 0.065)
        double3 xformOp:translate = (0, 0.036, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "post_right" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.95, 0.45, 0.1)]
        double size = 1
        float3 xformOp:scale = (0.015, 0.012, 0.065)
        double3 xformOp:translate = (0, -0.036, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "block" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.95, 0.45, 0.1)]
        double size = 1
        float3 xformOp:scale = (0.03, 0.084, 0.03)
        double3 xformOp:translate = (0, 0, -0.0475)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "tab" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.95, 0.45, 0.1)]
        double size = 1
        float3 xformOp:scale = (0.02, 0.012, 0.025)
        double3 xformOp:translate = (0, 0, 0.056999999999999995)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

