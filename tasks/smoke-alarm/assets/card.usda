#usda 1.0
(
    defaultPrim = "card"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "card" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
)
{
    bool physics:kinematicEnabled = 1

    def "Looks"
    {
        def Material "plain"
        {
            token outputs:surface.connect = </card/Looks/plain/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.6, 0.45)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "print"
        {
            token outputs:surface.connect = </card/Looks/print/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </card/Looks/print/texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/card.png@
                float2 inputs:st.connect = </card/Looks/print/st.outputs:result>
                float3 outputs:rgb
            }
        }
    }

    def Cube "board" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </card/Looks/plain>
        custom float physxCollision:contactOffset = 0.0005
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.1, 0.15, 0.001)
        double3 xformOp:translate = (0, 0, 0.0005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Mesh "print" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform bool doubleSided = 1
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        rel material:binding = </card/Looks/print>
        point3f[] points = [(-0.05, -0.075, 0.0012), (0.05, -0.075, 0.0012), (0.05, 0.075, 0.0012), (-0.05, 0.075, 0.0012)]
        texCoord2f[] primvars:st = [(1, 0), (1, 1), (0, 1), (0, 0)] (
            interpolation = "vertex"
        )
        uniform token subdivisionScheme = "none"
    }
}

