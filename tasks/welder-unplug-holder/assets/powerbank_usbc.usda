#usda 1.0
(
    defaultPrim = "PowerBankUSBC"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "PowerBankUSBC" (
    "5000 mAh power bank with a captive 300 mm USB-C cable. Origin: bank bottom centre at its cable end; the cable leaves along +X at z 7 mm; plug mating face at x 338 mm. One articulation: Bank -> Link_00..Link_23 -> Plug."
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 1
    custom int physxArticulation:solverPositionIterationCount = 32
    custom int physxArticulation:solverVelocityIterationCount = 4

    def Scope "Looks"
    {
        def Material "Phys_ABS" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.4
        }

        def Material "Phys_TPE" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.6
        }

        def Material "Phys_Steel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.2
            float physics:restitution = 0
            float physics:staticFriction = 0.25
        }

        def Material "PB_Plastic_Grey"
        {
            token outputs:surface.connect = </PowerBankUSBC/Looks/PB_Plastic_Grey/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.63, 0.65)
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </PowerBankUSBC/Looks/PB_Plastic_Grey/NormalTexture.outputs:rgb>
                float inputs:roughness.connect = </PowerBankUSBC/Looks/PB_Plastic_Grey/RoughnessTexture.outputs:r>
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "RoughnessTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/plastic_grain_roughness.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </PowerBankUSBC/Looks/PB_Plastic_Grey/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }

            def Shader "NormalTexture"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-0.45, -0.45, -1, 0)
                asset inputs:file = @./textures/plastic_grain_normal.png@
                float4 inputs:scale = (0.9, 0.9, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </PowerBankUSBC/Looks/PB_Plastic_Grey/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "USB_Shell_Steel"
        {
            token outputs:surface.connect = </PowerBankUSBC/Looks/USB_Shell_Steel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.82, 0.82, 0.84)
                float inputs:metallic = 1
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }

        def Material "USB_Tongue_Black"
        {
            token outputs:surface.connect = </PowerBankUSBC/Looks/USB_Tongue_Black/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.015, 0.015, 0.015)
                float inputs:metallic = 0
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "Rubber_Dark"
        {
            token outputs:surface.connect = </PowerBankUSBC/Looks/Rubber_Dark/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.035, 0.035, 0.035)
                float inputs:metallic = 0
                float inputs:roughness = 0.75
                token outputs:surface
            }
        }

        def Material "Print_Dark"
        {
            token outputs:surface.connect = </PowerBankUSBC/Looks/Print_Dark/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.06)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "PB_LED_Blue"
        {
            token outputs:surface.connect = </PowerBankUSBC/Looks/PB_LED_Blue/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.35, 1)
                color3f inputs:emissiveColor = (0.1, 0.4, 1)
                float inputs:metallic = 0
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }

        def Material "Cable_TPE_Black"
        {
            token outputs:surface.connect = </PowerBankUSBC/Looks/Cable_TPE_Black/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.018, 0.018, 0.02)
                float inputs:metallic = 0
                float inputs:roughness = 0.62
                token outputs:surface
            }
        }

        def Material "Contact_Gold"
        {
            token outputs:surface.connect = </PowerBankUSBC/Looks/Contact_Gold/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0.78, 0.35)
                float inputs:metallic = 1
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }

        def Material "Plug_Overmold_Black"
        {
            token outputs:surface.connect = </PowerBankUSBC/Looks/Plug_Overmold_Black/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.02, 0.02, 0.022)
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </PowerBankUSBC/Looks/Plug_Overmold_Black/NormalTexture.outputs:rgb>
                float inputs:roughness.connect = </PowerBankUSBC/Looks/Plug_Overmold_Black/RoughnessTexture.outputs:r>
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "RoughnessTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/plastic_grain_roughness.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </PowerBankUSBC/Looks/Plug_Overmold_Black/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }

            def Shader "NormalTexture"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-0.45, -0.45, -1, 0)
                asset inputs:file = @./textures/plastic_grain_normal.png@
                float4 inputs:scale = (0.9, 0.9, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </PowerBankUSBC/Looks/Plug_Overmold_Black/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }
    }

    def Xform "Bank" (
        "Power bank 92 x 46 x 14 mm, 125 g."
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (-0.046000004, 0, 0.007)
        float physics:mass = 0.125
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Mesh "Bank_Shell" (
