#usda 1.0
(
    defaultPrim = "Label"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Label" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
)
{
    def Cube "card" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.97, 0.97, 0.97)]
        double size = 1
        double3 xformOp:translate = (0, 0, 0)
        float3 xformOp:scale = (0.03, 0.1, 0.002)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Mesh "face" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-0.015, 0.05, 0.0012), (-0.015, -0.05, 0.0012), (0.015, -0.05, 0.0012), (0.015, 0.05, 0.0012)]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "vertex"
        )
        uniform bool doubleSided = 1
        rel material:binding = </Label/print>
    }

    def Material "print"
    {
        token outputs:surface.connect = </Label/print/surface.outputs:surface>

        def Shader "surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </Label/print/image.outputs:rgb>
            float inputs:roughness = 0.8
            token outputs:surface
        }

        def Shader "image"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./labels/PIRANHA.png@
            float2 inputs:st.connect = </Label/print/st.outputs:result>
            token inputs:wrapS = "clamp"
            token inputs:wrapT = "clamp"
            float3 outputs:rgb
        }

        def Shader "st"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            token inputs:varname = "st"
            float2 outputs:result
        }
    }
}
