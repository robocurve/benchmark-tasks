    def Material "Trousers"
    {
        token outputs:surface.connect = </Rig/Trousers/Fabric.outputs:surface>

        def Shader "Fabric"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </Rig/Trousers/Twill.outputs:rgb>
            float inputs:roughness = 0.92
            token outputs:surface
        }

        def Shader "Twill"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./workwear_weave.png@
            float4 inputs:scale = (0.105, 0.145, 0.19, 1)
            token inputs:sourceColorSpace = "raw"
            float2 inputs:st.connect = </Rig/Trousers/UV.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }

        def Shader "UV"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            token inputs:varname = "st"
            float2 outputs:result
        }
    }

    def Material "Jacket"
    {
        token outputs:surface.connect = </Rig/Jacket/Fabric.outputs:surface>

