            }
        }

        def Material "tex_plate"
        {
            token outputs:surface.connect = </breaker/Looks/tex_plate/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </breaker/Looks/tex_plate/tex.outputs:rgb>
                float inputs:roughness = 0.7
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./tex/plate_B1_L-O.png@
                float2 inputs:st.connect = </breaker/Looks/tex_plate/st.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }

        def Material "tex_label"
        {
