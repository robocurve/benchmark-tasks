#usda 1.0
(
    defaultPrim = "door_station"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "door_station" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 1
    custom int physxArticulation:solverPositionIterationCount = 32
    custom int physxArticulation:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "steel"
        {
            token outputs:surface.connect = </door_station/Looks/steel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.74, 0.77)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "black"
        {
            token outputs:surface.connect = </door_station/Looks/black/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.05)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "grey"
        {
            token outputs:surface.connect = </door_station/Looks/grey/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.57, 0.6)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "dark"
        {
            token outputs:surface.connect = </door_station/Looks/dark/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.12, 0.13)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "enclosure"
        {
            token outputs:surface.connect = </door_station/Looks/enclosure/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.8, 0.76)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "brass"
        {
            token outputs:surface.connect = </door_station/Looks/brass/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.62, 0.25)
                float inputs:metallic = 0.6
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "nickel"
        {
            token outputs:surface.connect = </door_station/Looks/nickel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.8, 0.78)
                float inputs:metallic = 0.6
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "kirk_red"
        {
            token outputs:surface.connect = </door_station/Looks/kirk_red/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.08, 0.08)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "breaker"
        {
            token outputs:surface.connect = </door_station/Looks/breaker/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.16, 0.16, 0.17)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "door"
        {
            token outputs:surface.connect = </door_station/Looks/door/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.8, 0.76)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "tex_plate"
        {
            token outputs:surface.connect = </door_station/Looks/tex_plate/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </door_station/Looks/tex_plate/tex.outputs:rgb>
                float inputs:roughness = 0.7
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./tex/plate_B1_L-C.png@
                float2 inputs:st.connect = </door_station/Looks/tex_plate/st.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }

        def Material "tex_top_label"
        {
            token outputs:surface.connect = </door_station/Looks/tex_top_label/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </door_station/Looks/tex_top_label/tex.outputs:rgb>
                float inputs:roughness = 0.7
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./tex/label_B1.png@
                float2 inputs:st.connect = </door_station/Looks/tex_top_label/st.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }

        def Material "tex_door_label"
        {
            token outputs:surface.connect = </door_station/Looks/tex_door_label/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </door_station/Looks/tex_door_label/tex.outputs:rgb>
                float inputs:roughness = 0.7
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./tex/door_B1.png@
                float2 inputs:st.connect = </door_station/Looks/tex_door_label/st.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }
    }

