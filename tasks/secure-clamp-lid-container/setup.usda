#usda 1.0
(
    defaultPrim = "Scene"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Z"
)
def Xform "Scene"
{
    def Xform "container" (
        prepend references = @./assets/container.usda@
    )
    {
        double3 xformOp:translate = (0.237, -0.012, 0.7475)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "lid" (
        prepend references = @./assets/lid.usda@
    )
    {
        double3 xformOp:translate = (0.206, 0.18, 0.7745)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "lid_rest" (
        prepend references = @./assets/lid_rest.usda@
    )
    {
        double3 xformOp:translate = (0.206, 0.18, 0.7475)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
