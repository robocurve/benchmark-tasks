#usda 1.0
(
    defaultPrim = "tourniquet"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "tourniquet" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 0

    def "Looks"
    {
        def Material "foam"
        {
            token outputs:surface.connect = </tourniquet/Looks/foam/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.62, 0.5)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "wood"
        {
            token outputs:surface.connect = </tourniquet/Looks/wood/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.4, 0.24)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "band"
        {
            token outputs:surface.connect = </tourniquet/Looks/band/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.3, 0.62)
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "rod"
        {
            token outputs:surface.connect = </tourniquet/Looks/rod/surface.outputs:surface>

