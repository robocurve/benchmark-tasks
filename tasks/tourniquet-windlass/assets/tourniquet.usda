                float inputs:metallic = 0.3
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "chrome"
        {
            token outputs:surface.connect = </tourniquet/Looks/chrome/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.82, 0.85)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }

        def Material "tube"
        {
            token outputs:surface.connect = </tourniquet/Looks/tube/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.12, 0.13)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "bladder"
        {
            token outputs:surface.connect = </tourniquet/Looks/bladder/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.14, 0.14, 0.16)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "needle"
        {
            token outputs:surface.connect = </tourniquet/Looks/needle/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.08, 0.06)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "dial"
        {
            token outputs:surface.connect = </tourniquet/Looks/dial/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </tourniquet/Looks/dial/texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/dial.png@
                float2 inputs:st.connect = </tourniquet/Looks/dial/st.outputs:result>
                float3 outputs:rgb
            }
        }
    }

