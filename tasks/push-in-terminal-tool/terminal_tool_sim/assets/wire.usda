    def Xform "anchor" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0.2924, -0.14, 0.0275)
        float3 physics:diagonalInertia = (0.000001, 0.000001, 0.000001)
        float physics:mass = 0.01
        quatf physics:principalAxes = (1, 0, 0, 0)
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Cylinder "inside" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.03
            rel material:binding = </wire/Looks/wire_blue>
            double radius = 0.0018000000000000002
            double3 xformOp:translate = (0.2924, -0.14, 0.042499999999999996)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

