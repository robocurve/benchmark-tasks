#usda 1.0
(
    defaultPrim = "op_tool"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "op_tool" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    point3f physics:centerOfMass = (-0.13, 0, 0)
    float3 physics:diagonalInertia = (0.000002, 0.00006, 0.00006)
    float physics:mass = 0.05
    quatf physics:principalAxes = (1, 0, 0, 0)
    custom float physxRigidBody:angularDamping = 0.5
    custom int physxRigidBody:solverPositionIterationCount = 32

    def "Looks"
    {
        def Material "grey"
        {
            token outputs:surface.connect = </op_tool/Looks/grey/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.63, 0.64)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "blue"
        {
            token outputs:surface.connect = </op_tool/Looks/blue/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.32, 0.72)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "green_yellow"
        {
            token outputs:surface.connect = </op_tool/Looks/green_yellow/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.55, 0.15)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "yellow_stripe"
        {
            token outputs:surface.connect = </op_tool/Looks/yellow_stripe/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.92, 0.8, 0.1)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "dark"
        {
            token outputs:surface.connect = </op_tool/Looks/dark/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.06, 0.07)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "plate"
        {
            token outputs:surface.connect = </op_tool/Looks/plate/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.74, 0.7)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "rail"
        {
            token outputs:surface.connect = </op_tool/Looks/rail/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.81, 0.83)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "tin"
        {
            token outputs:surface.connect = </op_tool/Looks/tin/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.81, 0.83)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "copper"
        {
            token outputs:surface.connect = </op_tool/Looks/copper/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.45, 0.2)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "collar_blue"
        {
            token outputs:surface.connect = </op_tool/Looks/collar_blue/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.22, 0.8)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "wire_blue"
        {
            token outputs:surface.connect = </op_tool/Looks/wire_blue/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.55, 0.85)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "duct"
        {
            token outputs:surface.connect = </op_tool/Looks/duct/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.57, 0.58)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "holder"
        {
            token outputs:surface.connect = </op_tool/Looks/holder/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.25, 0.25, 0.27)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "white"
        {
            token outputs:surface.connect = </op_tool/Looks/white/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.95, 0.93)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "steel"
        {
            token outputs:surface.connect = </op_tool/Looks/steel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.65, 0.67, 0.7)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "brown"
        {
            token outputs:surface.connect = </op_tool/Looks/brown/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.36, 0.2, 0.1)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "black"
        {
            token outputs:surface.connect = </op_tool/Looks/black/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.04, 0.04, 0.04)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "wire_grey"
        {
            token outputs:surface.connect = </op_tool/Looks/wire_grey/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.45, 0.46, 0.47)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "tool_green"
        {
            token outputs:surface.connect = </op_tool/Looks/tool_green/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.42, 0.74, 0.22)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "tool_grey"
        {
            token outputs:surface.connect = </op_tool/Looks/tool_grey/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.31, 0.33)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

    def Cube "blade" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </op_tool/Looks/steel>
        rel material:binding:physics = </op_tool/PhysicsMaterials/steel> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.0004
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.01, 0.0035, 0.0005)
        double3 xformOp:translate = (-0.005, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "shaft" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </op_tool/Looks/steel>
        rel material:binding:physics = </op_tool/PhysicsMaterials/steel> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.0004
        custom float physxCollision:restOffset = 0
        double size = 1
        token visibility = "invisible"
        float3 xformOp:scale = (0.08, 0.003, 0.003)
        double3 xformOp:translate = (-0.049999999999999996, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "handle" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </op_tool/Looks/tool_green>
        rel material:binding:physics = </op_tool/PhysicsMaterials/grip> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.0004
        custom float physxCollision:restOffset = 0
        double size = 1
        token visibility = "invisible"
        float3 xformOp:scale = (0.1, 0.013, 0.013)
        double3 xformOp:translate = (-0.14, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cylinder "look_bare" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "X"
        double height = 0.008
        rel material:binding = </op_tool/Looks/steel>
        double radius = 0.0015
        double3 xformOp:translate = (-0.014, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "look_sleeve" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "X"
        double height = 0.07200000000000001
        rel material:binding = </op_tool/Looks/tool_green>
        double radius = 0.0018
        double3 xformOp:translate = (-0.05399999999999999, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "look_handle" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "X"
        double height = 0.09000000000000001
        rel material:binding = </op_tool/Looks/tool_green>
        double radius = 0.006500000000000001
        double3 xformOp:translate = (-0.14, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "look_nose" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "X"
        double height = 0.01
        rel material:binding = </op_tool/Looks/tool_grey>
        double radius = 0.005200000000000001
        double3 xformOp:translate = (-0.095, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "look_cap" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "X"
        double height = 0.012
        rel material:binding = </op_tool/Looks/tool_grey>
        double radius = 0.0067
        double3 xformOp:translate = (-0.184, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def "PhysicsMaterials"
    {
        def Material "steel" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.2
            float physics:staticFriction = 0.2
            custom token physxMaterial:frictionCombineMode = "min"
        }

        def Material "grip" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 2
            float physics:staticFriction = 2
            custom token physxMaterial:frictionCombineMode = "max"
        }
    }
}

