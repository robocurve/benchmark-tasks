    def Xform "handle" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        rel material:binding:physics = </unit/PhysicsMaterials/latch_steel> (
            bindMaterialAs = "weakerThanDescendants"
        )
        float physics:mass = 0.1
        double3 xformOp:translate = (-0.012, 0, 0.11399999999999998)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "arm_0" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </unit/Looks/abb_grey>
            rel material:binding:physics = </unit/PhysicsMaterials/grip> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.002
            custom float physxCollision:restOffset = 0
            double size = 1
            float xformOp:rotateY = -166.18497
            float3 xformOp:scale = (0.01, 0.006, 0.12563439)
