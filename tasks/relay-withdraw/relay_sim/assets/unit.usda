#usda 1.0
(
    defaultPrim = "unit"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "unit" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 0
    custom int physxArticulation:solverPositionIterationCount = 32
    custom int physxArticulation:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "abb_grey"
        {
            token outputs:surface.connect = </unit/Looks/abb_grey/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.87, 0.86)
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "abb_bezel"
        {
            token outputs:surface.connect = </unit/Looks/abb_bezel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
