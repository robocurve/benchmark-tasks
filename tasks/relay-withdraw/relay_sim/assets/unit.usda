    def "joints"
    {
        def PhysicsRevoluteJoint "handle_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Y"
            rel physics:body0 = </unit/body>
            rel physics:body1 = </unit/handle>
            point3f physics:localPos0 = (-0.012, 0, 0.114)
            point3f physics:localPos1 = (0, 0, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 92
        }
    }

    def "PhysicsMaterials"
    {
        def Material "steel" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.25
            float physics:staticFriction = 0.3
            custom token physxMaterial:frictionCombineMode = "min"
        }

        def Material "latch_steel" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.15
            float physics:staticFriction = 0.2
            custom token physxMaterial:frictionCombineMode = "min"
        }

        def Material "grip" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.9
            float physics:staticFriction = 1
            custom token physxMaterial:frictionCombineMode = "max"
        }
    }
