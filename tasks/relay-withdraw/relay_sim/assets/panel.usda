#usda 1.0
(
    defaultPrim = "panel"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "panel"
{
    def "Looks"
    {
        def Material "panel"
        {
            token outputs:surface.connect = </panel/Looks/panel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.74, 0.75, 0.73)
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "case_steel"
        {
            token outputs:surface.connect = </panel/Looks/case_steel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.64, 0.66)
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "dark"
        {
            token outputs:surface.connect = </panel/Looks/dark/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.12, 0.13)
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "mat"
        {
            token outputs:surface.connect = </panel/Looks/mat/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.08, 0.09)
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "stand"
        {
            token outputs:surface.connect = </panel/Looks/stand/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4, 0.4, 0.42)
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "label_0"
        {
            token outputs:surface.connect = </panel/Looks/label_0/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </panel/Looks/label_0/tex.outputs:rgb>
                float inputs:roughness = 0.6
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./label_0.png@
                float2 inputs:st.connect = </panel/Looks/label_0/stReader.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }

        def Material "label_1"
        {
            token outputs:surface.connect = </panel/Looks/label_1/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </panel/Looks/label_1/tex.outputs:rgb>
                float inputs:roughness = 0.6
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./label_1.png@
                float2 inputs:st.connect = </panel/Looks/label_1/stReader.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }
    }

