    def Xform "anchor" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0.1, -0.45, 0.00485)
        float3 physics:diagonalInertia = (0.00001, 0.00001, 0.00001)
        float physics:mass = 0.05
        quatf physics:principalAxes = (1, 0, 0, 0)
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Cube "strap" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </cord_cap/Looks/clamp>
            double size = 1
            float3 xformOp:scale = (0.032, 0.012, 0.002)
            double3 xformOp:translate = (0.1, -0.45, 0.0132)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "leg_0" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </cord_cap/Looks/clamp>
            double size = 1
            float3 xformOp:scale = (0.00815, 0.012, 0.0147)
            double3 xformOp:translate = (0.08807500000000001, -0.45, 0.004849999999999999)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "leg_1" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </cord_cap/Looks/clamp>
            double size = 1
            float3 xformOp:scale = (0.00815, 0.012, 0.0147)
            double3 xformOp:translate = (0.111925, -0.45, 0.004849999999999999)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cylinder "tail" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token axis = "Y"
            double height = 0.04
            rel material:binding = </cord_cap/Looks/cord>
            double radius = 0.00735
            double3 xformOp:translate = (0.1, -0.47000000000000003, 0.00485)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

