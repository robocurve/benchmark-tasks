#usda 1.0
(
    defaultPrim = "cord_cap"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "cord_cap" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 0
    custom int physxArticulation:solverPositionIterationCount = 32
    custom int physxArticulation:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "cap_black"
        {
            token outputs:surface.connect = </cord_cap/Looks/cap_black/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.06, 0.06)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "cap_white"
        {
            token outputs:surface.connect = </cord_cap/Looks/cap_white/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.88, 0.87, 0.82)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

