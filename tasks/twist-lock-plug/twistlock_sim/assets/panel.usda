#usda 1.0
(
    defaultPrim = "panel"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "panel" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 0
    custom int physxArticulation:solverPositionIterationCount = 32

    def "Looks"
    {
        def Material "cap_black"
        {
            token outputs:surface.connect = </panel/Looks/cap_black/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.06, 0.06)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "cap_white"
        {
            token outputs:surface.connect = </panel/Looks/cap_white/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.88, 0.87, 0.82)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "brass"
        {
            token outputs:surface.connect = </panel/Looks/brass/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.66, 0.36)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "face_black"
        {
            token outputs:surface.connect = </panel/Looks/face_black/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.07, 0.07, 0.07)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "plate"
        {
            token outputs:surface.connect = </panel/Looks/plate/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.36, 0.39, 0.41)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "enclosure"
        {
            token outputs:surface.connect = </panel/Looks/enclosure/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.42, 0.45, 0.47)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "screw"
        {
            token outputs:surface.connect = </panel/Looks/screw/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.75, 0.78)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "cradle"
        {
            token outputs:surface.connect = </panel/Looks/cradle/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4, 0.4, 0.42)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "cord"
        {
            token outputs:surface.connect = </panel/Looks/cord/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.025, 0.025, 0.025)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "clamp"
        {
            token outputs:surface.connect = </panel/Looks/clamp/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.71, 0.72)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "mark"
        {
            token outputs:surface.connect = </panel/Looks/mark/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.95, 0.95)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "nameplate_0"
        {
            token outputs:surface.connect = </panel/Looks/nameplate_0/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </panel/Looks/nameplate_0/tex.outputs:rgb>
                float inputs:roughness = 0.6
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./nameplate_0.png@
                float2 inputs:st.connect = </panel/Looks/nameplate_0/stReader.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }

        def Material "nameplate_1"
        {
            token outputs:surface.connect = </panel/Looks/nameplate_1/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </panel/Looks/nameplate_1/tex.outputs:rgb>
                float inputs:roughness = 0.6
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./nameplate_1.png@
                float2 inputs:st.connect = </panel/Looks/nameplate_1/stReader.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }
    }

    def Xform "base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 5
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "plate_lo" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </panel/Looks/plate>
            custom float physxCollision:contactOffset = 0.0003
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.003, 0.225, 0.126)
            double3 xformOp:translate = (0.2928, -0.1975, 0.063)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
