    def Cube "post" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </cradle/Looks/cradle>
        double size = 1
        float3 xformOp:scale = (0.036, 0.03, 0.11035702)
        double3 xformOp:translate = (0.19, -0.03, 0.05267850925204092)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

