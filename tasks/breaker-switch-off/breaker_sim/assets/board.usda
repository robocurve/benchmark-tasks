{
    custom bool physxArticulation:enabledSelfCollisions = 1
    custom int physxArticulation:solverPositionIterationCount = 32
    custom int physxArticulation:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "ic60_white"
        {
            token outputs:surface.connect = </board/Looks/ic60_white/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.91, 0.89)
                float inputs:roughness = 0.55
                token outputs:surface
