#usda 1.0
(
    defaultPrim = "knife"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "knife" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.04

    def Cube "handle" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.08, 0.08, 0.09)]
        double size = 1
        float3 xformOp:scale = (0.022, 0.085, 0.016)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "bolster"
    {
        color3f[] primvars:displayColor = [(0.62, 0.66, 0.7)]
        double size = 1
        float3 xformOp:scale = (0.024, 0.006, 0.014)
        double3 xformOp:translate = (0, -0.045500000000000006, -0.001)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "blade" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.42, 0.45, 0.5)]
        double size = 1
        float3 xformOp:scale = (0.026, 0.12, 0.0025)
        double3 xformOp:translate = (0, -0.10250000000000001, -0.00675)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

