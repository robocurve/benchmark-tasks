#usda 1.0
(
    defaultPrim = "truck"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "truck" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
)
{
    bool physics:kinematicEnabled = 1

    def "Looks"
    {
        def Material "red"
        {
            token outputs:surface.connect = </truck/Looks/red/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.82, 0.12, 0.1)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "yellow"
        {
            token outputs:surface.connect = </truck/Looks/yellow/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.96, 0.76, 0.1)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "green"
        {
            token outputs:surface.connect = </truck/Looks/green/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.62, 0.25)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "tyre"
        {
            token outputs:surface.connect = </truck/Looks/tyre/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.06, 0.06)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "glass"
        {
            token outputs:surface.connect = </truck/Looks/glass/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.75, 0.85)
                float inputs:metallic = 0
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }
    }

    def Cylinder "wheel_nr" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        uniform token axis = "X"
        double height = 0.03
        rel material:binding = </truck/Looks/tyre>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double radius = 0.042
        double3 xformOp:translate = (-0.0805, -0.07200000000000001, 0.042)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "wheel_nl" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        uniform token axis = "X"
        double height = 0.03
        rel material:binding = </truck/Looks/tyre>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double radius = 0.042
        double3 xformOp:translate = (-0.0805, 0.07200000000000001, 0.042)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "wheel_fr" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        uniform token axis = "X"
        double height = 0.03
        rel material:binding = </truck/Looks/tyre>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double radius = 0.042
        double3 xformOp:translate = (0.0805, -0.07200000000000001, 0.042)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "wheel_fl" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        uniform token axis = "X"
        double height = 0.03
        rel material:binding = </truck/Looks/tyre>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double radius = 0.042
        double3 xformOp:translate = (0.0805, 0.07200000000000001, 0.042)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "chassis" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </truck/Looks/green>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.123, 0.234, 0.042)
        double3 xformOp:translate = (0, 0, 0.051)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "cab" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </truck/Looks/red>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.15, 0.085, 0.09)
        double3 xformOp:translate = (0, -0.08449999999999999, 0.105)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "roof" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </truck/Looks/red>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.14, 0.072, 0.021)
        double3 xformOp:translate = (0, -0.08299999999999999, 0.1605)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "windscreen" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </truck/Looks/glass>
        double size = 1
        float3 xformOp:scale = (0.12, 0.0025, 0.035)
        double3 xformOp:translate = (0, -0.12625, 0.1275)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "side_window_b" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </truck/Looks/glass>
        double size = 1
        float3 xformOp:scale = (0.002, 0.05, 0.035)
        double3 xformOp:translate = (-0.0755, -0.08199999999999999, 0.1275)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "side_window_a" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </truck/Looks/glass>
        double size = 1
        float3 xformOp:scale = (0.002, 0.05, 0.035)
        double3 xformOp:translate = (0.0755, -0.08199999999999999, 0.1275)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "bed_floor" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </truck/Looks/yellow>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.191, 0.159, 0.01)
        double3 xformOp:translate = (0, 0.0475, 0.077)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "bed_front" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </truck/Looks/yellow>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.191, 0.01, 0.078)
        double3 xformOp:translate = (0, -0.027, 0.121)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "bed_back" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </truck/Looks/yellow>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.191, 0.008, 0.058)
        double3 xformOp:translate = (0, 0.123, 0.11100000000000002)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "bed_left" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </truck/Looks/yellow>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.008, 0.159, 0.058)
        double3 xformOp:translate = (-0.0915, 0.0475, 0.11100000000000002)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "bed_right" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </truck/Looks/yellow>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.008, 0.159, 0.058)
        double3 xformOp:translate = (0.0915, 0.0475, 0.11100000000000002)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

