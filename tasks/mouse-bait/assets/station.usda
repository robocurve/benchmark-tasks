#usda 1.0
(
    defaultPrim = "station"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "station"
{
    def "Looks"
    {
        def Material "black"
        {
            token outputs:surface.connect = </station/Looks/black/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.07, 0.07, 0.075)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "inner"
        {
            token outputs:surface.connect = </station/Looks/inner/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.16, 0.16, 0.17)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "steel"
        {
            token outputs:surface.connect = </station/Looks/steel/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.72, 0.74)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "lid_top"
        {
            token outputs:surface.connect = </station/Looks/lid_top/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </station/Looks/lid_top/texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/mb_atlas_1.png@
                float2 inputs:st.connect = </station/Looks/lid_top/st.outputs:result>
                float3 outputs:rgb
            }
        }

        def Material "keyhole"
        {
            token outputs:surface.connect = </station/Looks/keyhole/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.55, 0.58)
                float inputs:metallic = 0.6
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
    }

    def Xform "base" (
