        point3f physics:centerOfMass = (0, -0.1205, 0.0084)
        float3 physics:diagonalInertia = (0.00058277, 0.0004948, 0.00107365)
        float physics:mass = 0.12
        quatf xformOp:orient = (0.64278764, -0.76604444, 0, 0)
