        double size = 1
        float3 xformOp:scale = (0.0016, 0.025, 0.0003)
        double3 xformOp:translate = (-0.017, 0, 0.00955)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "groove_t_11" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </block/Looks/edge>
        double size = 1
        float3 xformOp:scale = (0.0016, 0.025, 0.0003)
        double3 xformOp:translate = (-0.009, 0, 0.00955)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "groove_t_29" (
