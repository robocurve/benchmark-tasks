#usda 1.0
(
    defaultPrim = "block"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "block" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (0.0000016433333, 0.0000049366668, 0.0000053766666)
    float physics:mass = 0.02

    def "Looks"
    {
        def Material "wax"
        {
            token outputs:surface.connect = </block/Looks/wax/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.68, 0.46)
                float inputs:metallic = 0
                float inputs:roughness = 0.75
                token outputs:surface
            }
        }

        def Material "edge"
        {
            token outputs:surface.connect = </block/Looks/edge/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.66, 0.54, 0.34)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
    }

    def Cube "end_a" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </block/Looks/wax>
        custom float physxCollision:contactOffset = 0.0005
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.022, 0.025, 0.019)
        double3 xformOp:translate = (-0.014499999999999999, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "end_b" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </block/Looks/wax>
        custom float physxCollision:contactOffset = 0.0005
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.022, 0.025, 0.019)
        double3 xformOp:translate = (0.014499999999999999, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "side_a" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </block/Looks/wax>
        custom float physxCollision:contactOffset = 0.0005
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.007, 0.009, 0.019)
        double3 xformOp:translate = (0, -0.008, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "side_b" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </block/Looks/wax>
        custom float physxCollision:contactOffset = 0.0005
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.007, 0.009, 0.019)
        double3 xformOp:translate = (0, 0.008, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "groove_b_3" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </block/Looks/edge>
        double size = 1
        float3 xformOp:scale = (0.0016, 0.025, 0.0001)
        double3 xformOp:translate = (-0.017, 0, -0.009649999999999999)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "groove_b_11" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </block/Looks/edge>
        double size = 1
        float3 xformOp:scale = (0.0016, 0.025, 0.0001)
        double3 xformOp:translate = (-0.009, 0, -0.009649999999999999)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "groove_b_29" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </block/Looks/edge>
        double size = 1
        float3 xformOp:scale = (0.0016, 0.025, 0.0001)
        double3 xformOp:translate = (0.009, 0, -0.009649999999999999)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "groove_b_37" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </block/Looks/edge>
        double size = 1
        float3 xformOp:scale = (0.0016, 0.025, 0.0001)
        double3 xformOp:translate = (0.017, 0, -0.009649999999999999)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "groove_t_3" (
