#usda 1.0
(
    defaultPrim = "wall"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "wall" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
)
{
    bool physics:kinematicEnabled = 1

    def "Looks"
    {
        def Material "board"
        {
            token outputs:surface.connect = </wall/Looks/board/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.59, 0.42, 0.26)
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "face"
        {
            token outputs:surface.connect = </wall/Looks/face/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </wall/Looks/face/texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/mb_atlas_1.png@
                float2 inputs:st.connect = </wall/Looks/face/st.outputs:result>
                float3 outputs:rgb
            }
        }

        def Material "paper"
        {
            token outputs:surface.connect = </wall/Looks/paper/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.84, 0.79)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "dung"
        {
            token outputs:surface.connect = </wall/Looks/dung/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.04, 0.035)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
    }

    def Cube "board" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </wall/Looks/board>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.006, 0.9, 0.45)
        double3 xformOp:translate = (0.003, 0, 0.225)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Mesh "face" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform bool doubleSided = 1
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        rel material:binding = </wall/Looks/face>
        point3f[] points = [(-0.0003, 0.45, 0), (-0.0003, -0.45, 0), (-0.0003, -0.45, 0.45), (-0.0003, 0.45, 0.45)]
        texCoord2f[] primvars:st = [(0, 0.5), (1, 0.5), (1, 1), (0, 1)] (
            interpolation = "vertex"
        )
        uniform token subdivisionScheme = "none"
    }

    def Cube "strip" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </wall/Looks/paper>
        double size = 1
        float3 xformOp:scale = (0.02, 0.4, 0.001)
        double3 xformOp:translate = (-0.010000000000000009, 0, 0.0005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

