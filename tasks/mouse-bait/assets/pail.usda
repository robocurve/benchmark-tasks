#usda 1.0
(
    defaultPrim = "pail"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "pail" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
)
{
    bool physics:kinematicEnabled = 1

    def "Looks"
    {
        def Material "white"
        {
            token outputs:surface.connect = </pail/Looks/white/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.92, 0.92, 0.9)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "label"
        {
            token outputs:surface.connect = </pail/Looks/label/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </pail/Looks/label/texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/mb_atlas_1.png@
                float2 inputs:st.connect = </pail/Looks/label/st.outputs:result>
                float3 outputs:rgb
            }
        }

        def Material "lid"
        {
            token outputs:surface.connect = </pail/Looks/lid/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </pail/Looks/lid/texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/mb_atlas_1.png@
                float2 inputs:st.connect = </pail/Looks/lid/st.outputs:result>
                float3 outputs:rgb
            }
        }
    }

    def Cylinder "body" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.16799999999999998
        rel material:binding = </pail/Looks/white>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double radius = 0.085
        double3 xformOp:translate = (0, 0, 0.08399999999999999)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "lid" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
