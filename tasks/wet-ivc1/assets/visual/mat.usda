            int[] primvars:st:indices = [0, 2, 78, 76, 2, 4, 80, 78, 4, 6, 82, 80, 6, 8, 84, 82, 9, 11, 87, 85, 11, 13, 89, 87, 13, 15, 91, 89, 15, 17, 93, 91, 17, 19, 95, 93, 19, 21, 97, 95, 21, 23, 99, 97, 23, 25, 101, 99, 25, 27, 103, 101, 28, 30, 106, 104, 30, 32, 108, 106, 32, 34, 110, 108, 34, 36, 112, 110, 36, 38, 114, 112, 38, 40, 116, 114, 40, 42, 118, 116, 42, 44, 120, 118, 44, 46, 122, 120, 47, 49, 125, 123, 49, 51, 127, 125, 51, 53, 129, 127, 53, 55, 131, 129, 55, 57, 133, 131, 57, 59, 135, 133, 59, 61, 137, 135, 61, 63, 139, 137, 63, 65, 141, 139, 66, 68, 144, 142, 68, 70, 146, 144, 70, 72, 148, 146, 72, 74, 150, 148, 74, 0, 76, 150, 75, 73, 71, 69, 67, 64, 62, 60, 58, 56, 54, 52, 50, 48, 45, 43, 41, 39, 37, 35, 33, 31, 29, 26, 24, 22, 20, 18, 16, 14, 12, 10, 7, 5, 3, 1, 77, 79, 81, 83, 86, 88, 90, 92, 94, 96, 98, 100, 102, 105, 107, 109, 111, 113, 115, 117, 119, 121, 124, 126, 128, 130, 132, 134, 136, 138, 140, 143, 145, 147, 149, 151]
