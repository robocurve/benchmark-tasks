#usda 1.0
(
    doc = "Only the TailCap rigid body of flashlight_18650.usda (the other parts deactivated), in the shared flashlight frame. Its outer shell grips like rubber; the thread keeps aluminium friction."
    defaultPrim = "Flashlight"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Flashlight" (
    prepend references = @flashlight_18650.usda@
)
{
    over "Looks"
    {
        def Material "Rubber_Grip" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 1.3
            float physics:restitution = 0
            float physics:staticFriction = 1.5
            uniform token physxMaterial:frictionCombineMode = "max"
        }
    }

    over "TailCap"
    {
        over "TailCap"
        {
            rel material:binding:physics = </Flashlight/Looks/Rubber_Grip> (
                bindMaterialAs = "weakerThanDescendants"
            )
        }
    }

    over "Body" (
        active = false
    )
    {
    }
    over "Battery_18650" (
        active = false
    )
    {
    }
}
