#usda 1.0
(
    defaultPrim = "plate"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "plate" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.01

    def "Looks"
    {
        def Material "paper"
        {
            token outputs:surface.connect = </plate/Looks/paper/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 0.985)
                color3f inputs:emissiveColor = (0.07, 0.07, 0.07)
                float inputs:metallic = 0
                float inputs:roughness = 1
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }

        def Material "flute"
        {
            token outputs:surface.connect = </plate/Looks/flute/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.74, 0.74, 0.71)
                float inputs:metallic = 0
                float inputs:roughness = 1
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }
    }

    def Cylinder "flat" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.002
        custom float physxCollision:contactOffset = 0.002
        custom float physxCollision:restOffset = 0
        uniform token purpose = "guide"
        double radius = 0.088
        double3 xformOp:translate = (0, 0, 0.001)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

