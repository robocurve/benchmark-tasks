    def "Looks"
    {
        def Material "crust"
        {
            token outputs:surface.connect = </half/Looks/crust/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.58, 0.34, 0.12)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "cut"
        {
            token outputs:surface.connect = </half/Looks/cut/surface.outputs:surface>

