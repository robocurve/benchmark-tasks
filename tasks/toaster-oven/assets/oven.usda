#usda 1.0
(
    defaultPrim = "oven"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "oven" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 0
    custom float physxArticulation:sleepThreshold = 0
    custom float physxArticulation:stabilizationThreshold = 0

    def "Looks"
    {
        def Material "steel"
        {
            token outputs:surface.connect = </oven/Looks/steel/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.63, 0.64)
                float inputs:metallic = 0.85
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "black"
        {
            token outputs:surface.connect = </oven/Looks/black/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.03, 0.03, 0.035)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "enamel"
        {
            token outputs:surface.connect = </oven/Looks/enamel/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.16, 0.15, 0.15)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "glass"
        {
            token outputs:surface.connect = </oven/Looks/glass/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.06)
                float inputs:metallic = 0
                float inputs:opacity = 0.15
                float inputs:roughness = 0.05
                token outputs:surface
            }
        }

        def Material "element"
        {
            token outputs:surface.connect = </oven/Looks/element/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.35, 0.33, 0.31)
                float inputs:metallic = 0.6
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "rack"
        {
            token outputs:surface.connect = </oven/Looks/rack/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.72, 0.7)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "panel"
        {
            token outputs:surface.connect = </oven/Looks/panel/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </oven/Looks/panel/texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/panel_3.png@
                float2 inputs:st.connect = </oven/Looks/panel/st.outputs:result>
                float3 outputs:rgb
            }
        }

        def Material "knob"
        {
            token outputs:surface.connect = </oven/Looks/knob/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.09, 0.09, 0.095)
                float inputs:metallic = 0
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "knobside"
        {
            token outputs:surface.connect = </oven/Looks/knobside/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.055)
                float inputs:metallic = 0
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }
    }

