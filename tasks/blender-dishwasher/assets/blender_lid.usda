#usda 1.0
(
    defaultPrim = "BlenderLid"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "BlenderLid" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
    customData = {
        string description = "Detached washable lid with an 18 mm wide raised grip. Cap stays part of the lid for this scene."
    }
)
{
    rel material:binding:physics = </BlenderLid/PhysicsMaterial>
    point3f physics:centerOfMass = (0, 0, 0.012)
    float3 physics:diagonalInertia = (0.00005914875, 0.00005914875, 0.00010443)
    float physics:mass = 0.045
    bool physics:rigidBodyEnabled = 1
    custom int physxRigidBody:solverPositionIterationCount = 16
    custom int physxRigidBody:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "Teal"
        {
            token outputs:surface.connect = </BlenderLid/Looks/Teal/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.013411749, 0.11928019, 0.13286832)
                float inputs:metallic = 0
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "Seal"
        {
            token outputs:surface.connect = </BlenderLid/Looks/Seal/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.008540382, 0.013411749, 0.015325204)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "Cap"
        {
            token outputs:surface.connect = </BlenderLid/Looks/Cap/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4769998, 0.71056646, 0.71056646)
                float inputs:metallic = 0
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }

        def Material "Residue"
        {
            token outputs:surface.connect = </BlenderLid/Looks/Residue/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.71056646, 0.26327342, 0.063723795)
                float inputs:metallic = 0
                float inputs:roughness = 0.75
                token outputs:surface
            }
        }
    }

