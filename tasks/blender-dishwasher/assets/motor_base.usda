#usda 1.0
(
    defaultPrim = "MotorBase"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "MotorBase" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
    customData = {
        string description = "Movable electrical blender motor base with controls, coupling and visible unplugged cord. Not dishwasher-safe. Cord is visual rigid geometry only."
    }
)
{
    rel material:binding:physics = </MotorBase/PhysicsMaterial>
    point3f physics:centerOfMass = (0, 0, 0.06)
    float3 physics:diagonalInertia = (0.001349635, 0.001407875, 0.00075824)
    float physics:mass = 0.42
    bool physics:rigidBodyEnabled = 1
    custom int physxRigidBody:solverPositionIterationCount = 16
    custom int physxRigidBody:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "Body"
        {
            token outputs:surface.connect = </MotorBase/Looks/Body/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.024515014, 0.10653923, 0.11928019)
                float inputs:metallic = 0
                float inputs:roughness = 0.32
                token outputs:surface
            }
        }

        def Material "Dark"
        {
            token outputs:surface.connect = </MotorBase/Looks/Dark/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.008540382, 0.013411749, 0.017389102)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "Metal"
        {
            token outputs:surface.connect = </MotorBase/Looks/Metal/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.34239164, 0.43387952, 0.46236137)
                float inputs:metallic = 0.65
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "Controls"
        {
            token outputs:surface.connect = </MotorBase/Looks/Controls/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 1)
                color3f inputs:diffuseColor.connect = </MotorBase/Looks/Controls/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.4
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/motor_controls.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </MotorBase/Looks/Controls/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "Residue"
        {
            token outputs:surface.connect = </MotorBase/Looks/Residue/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7293471, 0.2846467, 0.068384856)
                float inputs:metallic = 0
                float inputs:roughness = 0.75
                token outputs:surface
            }
        }
    }

