#usda 1.0
(
    defaultPrim = "DishwasherRack"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "DishwasherRack" (
    customData = {
        string description = "Extended top-style dishwasher rack; open wire floor, separate wall colliders, fixed for loading. Not a generic serving basket."
    }
)
{
    def "Looks"
    {
        def Material "CoatedWire"
        {
            token outputs:surface.connect = </DishwasherRack/Looks/CoatedWire/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2956998, 0.39312312, 0.42003328)
                float inputs:metallic = 0.12
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "Clips"
        {
            token outputs:surface.connect = </DishwasherRack/Looks/Clips/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.015325204, 0.07828832, 0.10048151)
                float inputs:metallic = 0
                float inputs:roughness = 0.52
                token outputs:surface
            }
        }

        def Material "Wheels"
        {
            token outputs:surface.connect = </DishwasherRack/Looks/Wheels/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.013411749, 0.024515014, 0.030074105)
                float inputs:metallic = 0
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }
    }

