#usda 1.0
(
    defaultPrim = "phone"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "phone" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxContactReportAPI"]
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (0.00036406543, 0.0002949053, 0.00007065287)
    float physics:mass = 0.164
    custom float physxContactReport:threshold = 0

    def "Looks"
    {
        def Material "band"
        {
            token outputs:surface.connect = </phone/Looks/band/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.67244315, 0.67244315, 0.6444797)
                float inputs:metallic = 0.6
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "back"
        {
            token outputs:surface.connect = </phone/Looks/back/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.838799, 0.838799, 0.80695224)
                float inputs:metallic = 0
                float inputs:roughness = 0.15
                token outputs:surface
            }
        }

        def Material "ring"
        {
            token outputs:surface.connect = </phone/Looks/ring/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.045186203, 0.048171826, 0.054480277)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "glass"
        {
            token outputs:surface.connect = </phone/Looks/glass/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.0036765074, 0.0036765074, 0.0051815165)
                float inputs:metallic = 0
                float inputs:roughness = 0.05
                token outputs:surface
            }
        }

        def Material "flash"
        {
            token outputs:surface.connect = </phone/Looks/flash/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8713671, 0.7605245, 0.40197778)
                float inputs:metallic = 0
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "screen"
        {
            token outputs:surface.connect = </phone/Looks/screen/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </phone/Looks/screen/texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.08
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/pano_screen_1.png@
                float2 inputs:st.connect = </phone/Looks/screen/st.outputs:result>
                float3 outputs:rgb
            }
        }
    }

