#usda 1.0
(
    defaultPrim = "bench"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "bench"
{
    def "Looks"
    {
        def Material "copper"
        {
            token outputs:surface.connect = </bench/Looks/copper/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.45, 0.2)
                float inputs:metallic = 0.6
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

