#usda 1.0
(
    defaultPrim = "SO101_ShoulderBracket"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "SO101_ShoulderBracket" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
    doc = "SO-101 shoulder bracket (rotation-pitch part) with its motor holder screwed on, yellow PLA, one rigid body. Printed parts from the SO-ARM100 project (Apache-2.0). Origin on its underside under the shoulder-lift servo's pocket; +z up through the pocket, +x toward its back (the holder's flat side), the fork arms toward -x; the servo's horn goes on the -y side. The pocket (Colliders/Pocket, its frame = the seated servo's) is exact boxes, 0.25 mm a side with a 1.5 mm lead-in, its walls out to the ring's real outer faces; the rest is three flat-bottomed convex pieces."
)
{
    point3f physics:centerOfMass = (0.0007824119, -0.0007112712, 0.043820128)
    float3 physics:diagonalInertia = (0.0000147954315, 0.000033374497, 0.000034621142)
    float physics:mass = 0.045
    quatf physics:principalAxes = (0.55825204, -0.5080236, -0.4767721, -0.45050535)
    custom float physxRigidBody:maxDepenetrationVelocity = 0.2
    custom float physxRigidBody:sleepThreshold = 0.00005
    custom int physxRigidBody:solverPositionIterationCount = 32
    custom int physxRigidBody:solverVelocityIterationCount = 4

    def Scope "Looks"
    {
