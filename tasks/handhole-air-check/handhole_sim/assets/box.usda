#usda 1.0
(
    defaultPrim = "box"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "box"
{
    def "Looks"
    {
        def Material "concrete"
        {
            token outputs:surface.connect = </box/Looks/concrete/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6, 0.52, 0.39)
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "concrete_dark"
        {
            token outputs:surface.connect = </box/Looks/concrete_dark/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.45, 0.39, 0.29)
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }
    }

    def Cube "floor" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </box/Looks/concrete_dark>
        double size = 1
        float3 xformOp:scale = (0.339725, 0.51435, 0.008)
        double3 xformOp:translate = (0.3, -0.02, 0.004)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

