                color3f inputs:diffuseColor = (0.03, 0.03, 0.03)
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "alarm_off"
        {
            token outputs:surface.connect = </monitor/Looks/alarm_off/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.22, 0.22, 0.24)
                float inputs:roughness = 0.7
                token outputs:surface
