                color3f inputs:diffuseColor = (0.08, 0.25, 0.8)
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "alarm_on"
        {
            token outputs:surface.connect = </monitor/Looks/alarm_on/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0.08, 0.05)
                color3f inputs:emissiveColor = (1, 0.08, 0.05)
                token outputs:surface
            }
        }
    }

