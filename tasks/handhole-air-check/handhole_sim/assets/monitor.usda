#usda 1.0
(
    defaultPrim = "monitor"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "monitor" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 0
    custom int physxArticulation:solverPositionIterationCount = 32

    def "Looks"
    {
        def Material "meter_black"
        {
            token outputs:surface.connect = </monitor/Looks/meter_black/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.08, 0.09)
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "meter_yellow"
        {
            token outputs:surface.connect = </monitor/Looks/meter_yellow/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.75, 0.08)
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "hose"
        {
            token outputs:surface.connect = </monitor/Looks/hose/Shader.outputs:surface>

