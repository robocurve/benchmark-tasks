        rel material:binding = </cover/Looks/concrete_dark>
        double size = 1
        float3 xformOp:scale = (0.07, 0.17, 0.0008)
        double3 xformOp:translate = (0, -0.01, 0.022625)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
