#usda 1.0
(
    defaultPrim = "bolt"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "bolt" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.04

    def "Looks"
    {
        def Material "steel"
        {
            token outputs:surface.connect = </bolt/Looks/steel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.74, 0.75, 0.78)
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "concrete_dark"
        {
            token outputs:surface.connect = </bolt/Looks/concrete_dark/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.45, 0.39, 0.29)
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }
    }

    def Cube "washer" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </bolt/Looks/steel>
        rel material:binding:physics = </bolt/PhysicsMaterials/steel_seat> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.002
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.0254, 0.0254, 0.002)
        double3 xformOp:translate = (0, 0, 0.001)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "head" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </bolt/Looks/steel>
        rel material:binding:physics = </bolt/PhysicsMaterials/steel_grip> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.002
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.0143, 0.0143, 0.012)
        double3 xformOp:translate = (0, 0, 0.008)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "shank" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </bolt/Looks/steel>
        rel material:binding:physics = </bolt/PhysicsMaterials/steel_seat> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.002
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.0095, 0.0095, 0.051892858)
        double3 xformOp:translate = (0, 0, -0.02594642857142857)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "mark" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </bolt/Looks/concrete_dark>
        double size = 1
        float3 xformOp:scale = (0.004, 0.003, 0.0006)
        double3 xformOp:translate = (0.00515, 0, 0.0143)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def "PhysicsMaterials"
    {
        def Material "steel_grip" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.9
            float physics:staticFriction = 1
            custom token physxMaterial:frictionCombineMode = "max"
        }

        def Material "steel_seat" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.15
            float physics:staticFriction = 0.15
            custom token physxMaterial:frictionCombineMode = "min"
        }
    }
}

