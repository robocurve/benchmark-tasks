+def test_full_orientation_waypoints_reach_the_commanded_tcp_pose():
+    pos = (0.25, -0.25, TABLE_HEIGHT + 0.12)
+    rotation = axis_angle_matrix(np.array([1.0, 0.0, 0.0]), np.radians(10.0)) @ grip_rotation()
+    quaternion = tuple(ik.matrix_to_quat_xyzw(rotation))
+    plan = ArmPlan(
+        [
+            Waypoint(3.0, pos, FINGER_OPEN, "approach"),
+            Waypoint(2.0, pos, FINGER_CLOSED, "tilt", quat_xyzw=quaternion),
+            Waypoint(1.0, pos, FINGER_CLOSED, "hold", quat_xyzw=quaternion),
+        ],
+        RIGHT_BASE_POS,
+    )
+    actions = np.array([plan.action7((k + 1) / CONTROL_HZ)[0] for k in range(round(plan.duration * CONTROL_HZ))])
+    actual_pos, actual_rot = ik.tcp_pose(actions[-1, :6], RIGHT_BASE_POS)
+    np.testing.assert_allclose(actual_pos, pos, atol=5e-4)
+    np.testing.assert_allclose(actual_rot, rotation, atol=1e-3)
+    assert plan.worst_ik_mm < 0.5 and plan.worst_ik_deg < 0.1
+    assert np.all(actions[:, :6] >= ik.LOWER) and np.all(actions[:, :6] <= ik.UPPER)
+    assert actions[-1, 6] == 0.0
+
