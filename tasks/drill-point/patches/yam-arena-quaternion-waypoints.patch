+@pytest.mark.parametrize("quaternion_scale", [1.0, -2.0])
+def test_full_orientation_waypoints_interpolate_and_mix_with_yaw_waypoints(quaternion_scale):
+    pos = (*CUBE_POS[:2], HOVER)
+    down = grip_rotation()
+    tilted = axis_angle_matrix(np.array([1.0, 0.0, 0.0]), np.pi / 2) @ down
+    quaternion = tuple(quaternion_scale * ik.matrix_to_quat_xyzw(tilted))
+    plan = ArmPlan(
+        [
+            Waypoint(1.0, pos, FINGER_OPEN, "down"),
+            Waypoint(2.0, pos, FINGER_OPEN, "tilt", yaw=np.pi, quat_xyzw=quaternion),
+            Waypoint(1.0, pos, FINGER_OPEN, "down again", yaw=0.4),
+        ],
+        LEFT_BASE_POS,
+    )
+    halfway = axis_angle_matrix(np.array([1.0, 0.0, 0.0]), np.pi / 4) @ down
+    for t, expected in (
+        (1.0, down),
+        (2.0, halfway),
+        (3.0, tilted),
+        (4.0, grip_rotation(0.4)),
+        (5.0, grip_rotation(0.4)),
+    ):
+        actual_pos, actual_rot, finger, _ = plan.target(t)
+        np.testing.assert_allclose(actual_pos, pos)
+        np.testing.assert_allclose(actual_rot, expected, atol=1e-12)
+        assert finger == FINGER_OPEN
+
