        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0.04
            float physics:staticFriction = 0.65
        }

        def Material "window"
        {
            token outputs:surface.connect = </guard_station/Looks/window/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.16, 0.56, 0.7)
                float inputs:opacity = 0.22
                token outputs:surface
            }
        }
    }

