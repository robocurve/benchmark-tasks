#usda 1.0
(
    defaultPrim = "SingleBurnerStove"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "SingleBurnerStove" (
    customData = {
        string operatingState = "OFF; the bath is already warm. No active burner, heating or fire simulation."
    }
)
{
    def "Looks"
    {
        def Material "Steel"
        {
            token outputs:surface.connect = </SingleBurnerStove/Looks/Steel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.42003328, 0.46236137, 0.4769998)
                float inputs:metallic = 0.83
                float inputs:roughness = 0.31
                token outputs:surface
            }
        }

        def Material "Black"
        {
            token outputs:surface.connect = </SingleBurnerStove/Looks/Black/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.0027089783, 0.003501016, 0.0039359396)
                float inputs:metallic = 0.18
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }

        def Material "Trim"
        {
            token outputs:surface.connect = </SingleBurnerStove/Looks/Trim/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.71056646, 0.7293471, 0.71056646)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.21
                token outputs:surface
            }
        }

        def Material "Rubber"
        {
            token outputs:surface.connect = </SingleBurnerStove/Looks/Rubber/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.010022826, 0.011645431, 0.013411749)
                float inputs:metallic = 0
                float inputs:roughness = 0.75
                token outputs:surface
            }
        }

        def Material "OffLabel"
        {
            token outputs:surface.connect = </SingleBurnerStove/Looks/OffLabel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 1)
                color3f inputs:diffuseColor.connect = </SingleBurnerStove/Looks/OffLabel/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/stove_off.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </SingleBurnerStove/Looks/OffLabel/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }
    }

