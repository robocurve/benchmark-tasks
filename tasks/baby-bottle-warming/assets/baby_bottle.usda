#usda 1.0
(
    defaultPrim = "BabyBottle"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "BabyBottle" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
    customData = {
        string assetDescription = "201 mm baby bottle, 62 mm body and 70 mm collar; about 150 mL milk represented as rigid visual geometry."
        double3 graspCenterLocal = (0, 0, 0.108)
        string previewState = "Dynamic 230 g bottle; transport by robot contact and friction only."
    }
)
{
    rel material:binding:physics = </BabyBottle/PhysicsMaterial>
    point3f physics:centerOfMass = (0, 0, 0.064)
    bool physics:kinematicEnabled = 0
    float physics:mass = 0.23
    bool physics:rigidBodyEnabled = 1
    custom int physxRigidBody:solverPositionIterationCount = 16
    custom int physxRigidBody:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "Bottle"
        {
            token outputs:surface.connect = </BabyBottle/Looks/Bottle/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7484141, 0.9114075, 1)
                float inputs:ior = 1.47
                float inputs:metallic = 0
                float inputs:opacity = 0.25
                float inputs:roughness = 0.17
                token outputs:surface
            }
        }

        def Material "Milk"
        {
            token outputs:surface.connect = </BabyBottle/Looks/Milk/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9551046, 0.8688994, 0.6382832)
                float inputs:metallic = 0
                float inputs:roughness = 0.33
                token outputs:surface
            }
        }

        def Material "Collar"
        {
            token outputs:surface.connect = </BabyBottle/Looks/Collar/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.013411749, 0.233022, 0.53823555)
                float inputs:metallic = 0
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "Silicone"
        {
            token outputs:surface.connect = </BabyBottle/Looks/Silicone/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8900054, 0.76776874, 0.53823555)
                float inputs:metallic = 0
                float inputs:opacity = 0.72
                float inputs:roughness = 0.23
                token outputs:surface
            }
        }

        def Material "Label"
        {
            token outputs:surface.connect = </BabyBottle/Looks/Label/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 1)
                color3f inputs:diffuseColor.connect = </BabyBottle/Looks/Label/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.48
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/bottle_label.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </BabyBottle/Looks/Label/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }
    }

    def "Geometry"
    {
        def Mesh "Body" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
