#usda 1.0
(
    defaultPrim = "Door"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Door" (
    customData = {
        string hingeAxis = "Z"
        double initialOpeningDegrees = 35
        string interactionState = "Copied microwave door, starting 35 degrees open; no actuation performed during scene review."
    }
)
{
    def "Looks"
    {
        def Material "Steel"
        {
            token outputs:surface.connect = </Door/Looks/Steel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.43387952, 0.4769998, 0.49190503)
                float inputs:metallic = 0.93
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }

        def Material "Handle"
        {
            token outputs:surface.connect = </Door/Looks/Handle/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6382832, 0.67385954, 0.6920711)
                float inputs:metallic = 0.97
                float inputs:roughness = 0.18
                token outputs:surface
            }
        }

        def Material "Gasket"
        {
            token outputs:surface.connect = </Door/Looks/Gasket/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.0021671827, 0.0023993808, 0.0024767802)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "Window"
        {
            token outputs:surface.connect = </Door/Looks/Window/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.003501016, 0.0040265042, 0.0041182735)
                float inputs:metallic = 0.08
                float inputs:opacity = 0.38
                float inputs:roughness = 0.22
                token outputs:surface
            }
        }
    }

