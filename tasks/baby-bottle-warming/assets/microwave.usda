#usda 1.0
(
    defaultPrim = "Microwave"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Microwave" (
    customData = {
        string assetDescription = "420 x 300 mm stainless microwave with hollow cavity and raised controls. Visual prototype, no heating or powered operation."
    }
)
{
    def "Looks"
    {
        def Material "Steel"
        {
            token outputs:surface.connect = </Microwave/Looks/Steel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.36724648, 0.4064483, 0.43387952)
                float inputs:metallic = 0.91
                float inputs:roughness = 0.29
                token outputs:surface
            }
        }

        def Material "Trim"
        {
            token outputs:surface.connect = </Microwave/Looks/Trim/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.58701634, 0.6209159, 0.6382832)
                float inputs:metallic = 0.96
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }

        def Material "Liner"
        {
            token outputs:surface.connect = </Microwave/Looks/Liner/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.233022, 0.25295007, 0.233022)
                float inputs:metallic = 0.82
                float inputs:roughness = 0.36
                token outputs:surface
            }
        }

        def Material "Black"
        {
            token outputs:surface.connect = </Microwave/Looks/Black/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.0019349845, 0.002244582, 0.0023993808)
                float inputs:metallic = 0
                float inputs:roughness = 0.49
                token outputs:surface
            }
        }

        def Material "Timer"
        {
            token outputs:surface.connect = </Microwave/Looks/Timer/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 1)
                color3f inputs:diffuseColor.connect = </Microwave/Looks/Timer/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/timer.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Microwave/Looks/Timer/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "Keypad"
        {
            token outputs:surface.connect = </Microwave/Looks/Keypad/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 1)
                color3f inputs:diffuseColor.connect = </Microwave/Looks/Keypad/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.52
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
