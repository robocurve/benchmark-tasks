#usda 1.0
(
    defaultPrim = "hardware"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "hardware" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 1

    def "looks"
    {
        def Material "steel"
        {
            token outputs:surface.connect = </hardware/looks/steel/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.48, 0.52, 0.56)
                float inputs:metallic = 0.7
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "brass"
        {
            token outputs:surface.connect = </hardware/looks/brass/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.46, 0.12)
                float inputs:metallic = 0.65
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "blue"
        {
            token outputs:surface.connect = </hardware/looks/blue/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.045, 0.2, 0.3)
                float inputs:metallic = 0.15
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "dark"
        {
            token outputs:surface.connect = </hardware/looks/dark/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.055, 0.065, 0.075)
                float inputs:metallic = 0.1
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "orange"
        {
            token outputs:surface.connect = </hardware/looks/orange/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.83, 0.27, 0.035)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }
    }

    def Xform "base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (0.02, 0.02, 0.02)
        float physics:mass = 2
        quatf physics:principalAxes = (1, 0, 0, 0)
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Cube "foot" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </hardware/looks/blue>
            custom float physxCollision:contactOffset = 0.00008
            custom float physxCollision:restOffset = 0.00003
            double size = 1
            quatf xformOp:orient = (0.5, 0.5, 0.5, -0.5)
            float3 xformOp:scale = (0.3, 0.2, 0.016)
            double3 xformOp:translate = (0, 0.23199999999999998, -0.13)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }

        def Cube "splitter_foot" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </hardware/looks/blue>
            custom float physxCollision:contactOffset = 0.00008
            custom float physxCollision:restOffset = 0.00003
            double size = 1
            quatf xformOp:orient = (0.5, 0.5, 0.5, -0.5)
            float3 xformOp:scale = (0.07, 0.21, 0.016)
            double3 xformOp:translate = (0.168, 0.23199999999999998, -0.235)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }

        def Cube "upright" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </hardware/looks/blue>
            custom float physxCollision:contactOffset = 0.00008
            custom float physxCollision:restOffset = 0.00003
            double size = 1
            quatf xformOp:orient = (0.5, 0.5, 0.5, -0.5)
            float3 xformOp:scale = (0.025, 0.03, 0.224)
            double3 xformOp:translate = (0, 0.12, -0.25)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }

        def Capsule "bearing" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            uniform token axis = "X"
            double height = 0.034
            rel material:binding = </hardware/looks/dark>
            custom float physxCollision:contactOffset = 0.00008
            custom float physxCollision:restOffset = 0.00003
            double radius = 0.015
            quatf xformOp:orient = (-0.5, 0.5, 0.5, 0.5)
            double3 xformOp:translate = (0, 0, -0.25)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Cube "splitter_post" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </hardware/looks/dark>
            custom float physxCollision:contactOffset = 0.00008
            custom float physxCollision:restOffset = 0.00003
            double size = 1
            quatf xformOp:orient = (0.5, 0.5, 0.5, -0.5)
            float3 xformOp:scale = (0.01, 0.014, 0.41121256)
            double3 xformOp:translate = (0.24451688522026407, 0.034393716874606364, -0.25)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }

        def Cube "splitter_bridge" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </hardware/looks/blue>
            custom float physxCollision:contactOffset = 0.00008
            custom float physxCollision:restOffset = 0.00003
            double size = 1
            quatf xformOp:orient = (0.5, 0.5, 0.5, -0.5)
            float3 xformOp:scale = (0.23944445, 0.014, 0.01)
            double3 xformOp:translate = (0.24451688522026407, -0.17121256625078726, -0.13027777777777777)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }

        def Capsule "withdrawal_rail" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            uniform token axis = "X"
            double height = 0.13
            rel material:binding = </hardware/looks/blue>
            custom float physxCollision:contactOffset = 0.00008
            custom float physxCollision:restOffset = 0.00003
            double radius = 0.004
            quatf xformOp:orient = (0.95371693, -0, 0, -0.3007058)
            double3 xformOp:translate = (0.20765504322725942, -0.14540162661499018, -0.012555555555555556)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Cube "splitter_guide" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </hardware/looks/blue>
            custom float physxCollision:contactOffset = 0.00008
            custom float physxCollision:restOffset = 0.00003
            double size = 1
            float3 xformOp:scale = (0.025, 0.025, 0.012)
            double3 xformOp:translate = (0.24451688522026407, -0.17121256625078726, -0.018555555555555554)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def "joints"
    {
        def PhysicsFixedJoint "world_fixed"
        {
            rel physics:body1 = </hardware/base>
        }

        def PhysicsRevoluteJoint "turn" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.0013962634
            float drive:angular:physics:maxForce = 30
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetPosition = 0
            uniform token physics:axis = "X"
            rel physics:body0 = </hardware/base>
            rel physics:body1 = </hardware/rotor>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (-0.5, 0.5, 0.5, 0.5)
            quatf physics:localRot1 = (-0.5, 0.5, 0.5, 0.5)
            float physics:lowerLimit = -900
            float physics:upperLimit = 900
            custom float physxJoint:maxJointVelocity = 180
        }

        def PhysicsRevoluteJoint "knob_spin0" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 3.4906584e-8
            float drive:angular:physics:maxForce = 30
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetPosition = 0
