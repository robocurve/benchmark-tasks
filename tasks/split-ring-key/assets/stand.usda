#usda 1.0
(
    defaultPrim = "hardware"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "hardware"
{
    def "looks"
    {
        def Material "steel"
        {
            token outputs:surface.connect = </hardware/looks/steel/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.48, 0.52, 0.56)
                float inputs:metallic = 0.7
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "brass"
        {
            token outputs:surface.connect = </hardware/looks/brass/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.46, 0.12)
                float inputs:metallic = 0.65
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "blue"
        {
            token outputs:surface.connect = </hardware/looks/blue/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.045, 0.2, 0.3)
                float inputs:metallic = 0.15
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "dark"
        {
            token outputs:surface.connect = </hardware/looks/dark/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.055, 0.065, 0.075)
                float inputs:metallic = 0.1
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "orange"
        {
            token outputs:surface.connect = </hardware/looks/orange/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.83, 0.27, 0.035)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "red"
        {
            token outputs:surface.connect = </hardware/looks/red/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.025, 0.015)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "green"
        {
            token outputs:surface.connect = </hardware/looks/green/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.04, 0.75, 0.12)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "white"
        {
            token outputs:surface.connect = </hardware/looks/white/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.9, 0.9)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }
    }

    def Xform "stand" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (0.01, 0.01, 0.01)
        float physics:mass = 1
        quatf physics:principalAxes = (1, 0, 0, 0)
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Cube "base" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </hardware/looks/blue>
            custom float physxCollision:contactOffset = 0.00008
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.075, 0.06, 0.012)
            double3 xformOp:translate = (-0.015, 0, -0.21399999999999997)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "column" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </hardware/looks/dark>
            custom float physxCollision:contactOffset = 0.00008
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.014, 0.012, 0.208)
            double3 xformOp:translate = (-0.014, 0, -0.10999999999999999)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "rest" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </hardware/looks/blue>
            custom float physxCollision:contactOffset = 0.00008
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.014, 0.02, 0.006)
            double3 xformOp:translate = (-0.015, 0, -0.004)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }
}

