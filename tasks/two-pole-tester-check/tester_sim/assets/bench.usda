{
    def "Looks"
    {
        def Material "plate_galv"
        {
            token outputs:surface.connect = </bench/Looks/plate_galv/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.71, 0.7)
                float inputs:roughness = 0.5
                token outputs:surface
