            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -100
            float physics:upperLimit = 0
        }

        def PhysicsPrismaticJoint "LatchSlide" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear"]
            doc = "Return spring 200 N/m with 0.2 N preload at home (0); the slider slides out to -3 mm. The hook pushes it about 1.7 mm out on its way down."
        )
        {
            float drive:linear:physics:damping = 1
            float drive:linear:physics:stiffness = 200
            float drive:linear:physics:targetPosition = 0.001
            uniform token drive:linear:physics:type = "force"
            uniform token physics:axis = "Y"
            rel physics:body0 = </ScrewdriverCase/Base>
            rel physics:body1 = </ScrewdriverCase/Slider>
            point3f physics:localPos0 = (0, -0.04725, 0.0229)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -0.003
            float physics:upperLimit = 0
        }
    }
}

