    def Scope "Joints"
    {
        def PhysicsRevoluteJoint "LidHinge" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            doc = "Damped (friction) hinge, no spring: the lid rests open on its 100-degree stop (its centre of mass behind the hinge); pushed past about 75 degrees it settles shut under its weight. Shut is held only by the clasp."
        )
        {
            float drive:angular:physics:damping = 0.00052359875
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
