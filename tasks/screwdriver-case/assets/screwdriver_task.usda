#usda 1.0
(
    defaultPrim = "Screwdriver"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Screwdriver" (
    doc = "NVIDIA SimReady handTool_screwdriver_phillips_ph2_a01 (CC-BY 4.0), referenced unchanged, with its own colliders: the SimReady model collides as one signed-distance-field mesh of its whole visual mesh, whose round 34 mm handle rolls on a table and gives flat gripper pads no face to hold. Here that collider is switched off and five convex 12-sided sections (a flat face every 30 degrees, one face down) follow the model within 0.00 mm: the domed butt, a straight grip zone (x -24 to -2 mm, where a gripper holds it), the neck, the collar and the shaft with its tip. Mass and inertia are SimReady's. This file sits next to the package's simready_usd/ folder (the task copies it there after downloading the package)."
    prepend references = @./simready_usd/sm_handTool_screwdriver_phillips_ph2_a01_01.usd@</RootNode>
)
