#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    float physics:mass = 0.002
    custom bool physxRigidBody:enableCCD = 1

    def Cylinder "Gate" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Y"
        double height = 0.039
        color3f[] primvars:displayColor = [(0.63, 0.65, 0.67)]
        double radius = 0.00225
    }
}
