#usda 1.0
(
    defaultPrim = "Secateurs"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Secateurs"
{
    def Material "PhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:staticFriction = 1.000
        float physics:dynamicFriction = 0.900
        float physics:restitution = 0
    }

    def Scope "Looks"
    {
        def Material "anvil"
        {
            token outputs:surface.connect = </Secateurs/Looks/anvil/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.6
                color3f inputs:diffuseColor = (0.035, 0.035, 0.04)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }
        def Material "brass"
        {
            token outputs:surface.connect = </Secateurs/Looks/brass/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 1.0
                color3f inputs:diffuseColor = (0.7, 0.52, 0.18)
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
        def Material "grip"
        {
            token outputs:surface.connect = </Secateurs/Looks/grip/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.6, 0.01, 0.008)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }
        def Material "steel"
        {
            token outputs:surface.connect = </Secateurs/Looks/steel/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 1.0
                color3f inputs:diffuseColor = (0.78, 0.78, 0.8)
                float inputs:roughness = 0.22
                token outputs:surface
            }
        }
        def Material "steel_dark"
        {
            token outputs:surface.connect = </Secateurs/Looks/steel_dark/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 1.0
                color3f inputs:diffuseColor = (0.3, 0.3, 0.32)
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }
    }

