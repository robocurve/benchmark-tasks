#usda 1.0
(
    defaultPrim = "Scene"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Z"
)
def Xform "Scene"
{
    def Xform "rig" (
        prepend references = @./assets/rig.usda@
    )
    {
        double3 xformOp:translate = (0.278, -0.119, 0.7475)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "flag" (
        prepend references = @./assets/flag.usda@
    )
    {
        double3 xformOp:translate = (0.229, -0.224, 0.7705)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "flag_rest" (
        prepend references = @./assets/flag_rest.usda@
    )
    {
        double3 xformOp:translate = (0.229, -0.224, 0.7475)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
