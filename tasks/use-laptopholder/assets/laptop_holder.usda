#usda 1.0
(
    defaultPrim = "Holder"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Holder" (
    customData = {
        string description = "Reference-inspired passive ABS laptop stand; not a calibrated Tonmom replica"
    }
)
{
    def "materials"
    {
        def Material "abs" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Holder/materials/abs/surface.outputs:surface>
            float physics:dynamicFriction = 0.25
            float physics:restitution = 0
            float physics:staticFriction = 0.35

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.045, 0.05, 0.06)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "silicone" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Holder/materials/silicone/surface.outputs:surface>
            float physics:dynamicFriction = 0.7
            float physics:restitution = 0
            float physics:staticFriction = 0.9

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.16, 0.18, 0.2)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "steel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Holder/materials/steel/surface.outputs:surface>
            float physics:dynamicFriction = 0.2
            float physics:restitution = 0
            float physics:staticFriction = 0.3

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.38, 0.4, 0.43)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

