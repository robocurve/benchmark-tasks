        uniform token purpose = "guide"
        double size = 1
        quatf xformOp:orient = (0.9848077, 0, 0.17364818, -0)
        float3 xformOp:scale = (0.006, 0.0385, 0.021)
        double3 xformOp:translate = (0.005793962890603299, 0, 0.004808325490470864)
