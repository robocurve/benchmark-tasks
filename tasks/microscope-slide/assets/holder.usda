#usda 1.0
(
    defaultPrim = "holder"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "holder" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
)
{
    bool physics:kinematicEnabled = 1

    def "Looks"
    {
        def Material "white"
        {
            token outputs:surface.connect = </holder/Looks/white/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.93, 0.93, 0.92)
                float inputs:metallic = 0
                float inputs:roughness = 0.75
                token outputs:surface
            }
        }

        def Material "slot"
        {
            token outputs:surface.connect = </holder/Looks/slot/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.3, 0.32)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
    }

    def Cube "block" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </holder/Looks/white>
        double size = 1
        float3 xformOp:scale = (0.152, 0.102, 0.02)
        double3 xformOp:translate = (0, 0, 0.004095389311788626)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "c_base" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        uniform token purpose = "guide"
        double size = 1
        float3 xformOp:scale = (0.152, 0.102, 0.0019046107)
        double3 xformOp:translate = (0, 0, -0.004952305344105687)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "c_back" (
