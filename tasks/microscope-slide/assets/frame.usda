#usda 1.0
(
    defaultPrim = "frame"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "frame" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
)
{
    bool physics:kinematicEnabled = 1

    def "Looks"
    {
        def Material "cream"
        {
            token outputs:surface.connect = </frame/Looks/cream/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.85, 0.8)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "black"
        {
            token outputs:surface.connect = </frame/Looks/black/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.07, 0.07, 0.08)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "chrome"
        {
            token outputs:surface.connect = </frame/Looks/chrome/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.79, 0.8)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }
    }

    def Cube "base" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </frame/Looks/cream>
        double size = 1
        float3 xformOp:scale = (0.2, 0.17, 0.04)
        double3 xformOp:translate = (0.025, 0, -0.16999999999999998)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "pillar" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </frame/Looks/cream>
        double size = 1
        float3 xformOp:scale = (0.047, 0.064, 0.3)
        double3 xformOp:translate = (0.1015, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "bracket" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </frame/Looks/cream>
        double size = 1
        float3 xformOp:scale = (0.058, 0.06, 0.033)
        double3 xformOp:translate = (0.049, 0, -0.028499999999999998)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "limb" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </frame/Looks/cream>
        double size = 1
        float3 xformOp:scale = (0.155, 0.06, 0.052)
        double3 xformOp:translate = (0.0475, 0, 0.124)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cylinder "condenser" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.048
        rel material:binding = </frame/Looks/black>
        double radius = 0.018
        double3 xformOp:translate = (0, 0, -0.036)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "xy_knobs" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.061
        rel material:binding = </frame/Looks/black>
        double radius = 0.011
        double3 xformOp:translate = (-0.03, -0.052, -0.0445)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "xy_rack" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </frame/Looks/black>
        double size = 1
        float3 xformOp:scale = (0.074, 0.008, 0.008)
        double3 xformOp:translate = (0.002999999999999999, -0.052, -0.016)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cylinder "focus_l" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Y"
        double height = 0.03
        rel material:binding = </frame/Looks/black>
        double radius = 0.022
        double3 xformOp:translate = (0.1, -0.047, -0.11)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "focus_r" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Y"
        double height = 0.03
        rel material:binding = </frame/Looks/black>
        double radius = 0.022
        double3 xformOp:translate = (0.1, 0.047, -0.11)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "lamp" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.002
        rel material:binding = </frame/Looks/chrome>
        double radius = 0.016
        double3 xformOp:translate = (0, 0, -0.149)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

