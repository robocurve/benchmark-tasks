#usda 1.0
(
    defaultPrim = "slide"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "slide" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float physics:mass = 0.0047
    custom bool physxRigidBody:enableCCD = 1

    def "Looks"
    {
        def Material "glass"
        {
            token outputs:surface.connect = </slide/Looks/glass/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.82, 0.9, 0.92)
                float inputs:metallic = 0
                float inputs:opacity = 0.55
                float inputs:roughness = 0.1
                token outputs:surface
            }
        }

        def Material "frost"
        {
            token outputs:surface.connect = </slide/Looks/frost/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.95, 0.93)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "cover"
        {
            token outputs:surface.connect = </slide/Looks/cover/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.85, 0.9)
                float inputs:metallic = 0
                float inputs:opacity = 0.5
                float inputs:roughness = 0.05
                token outputs:surface
            }
        }

        def Material "stain"
        {
            token outputs:surface.connect = </slide/Looks/stain/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.18, 0.3, 0.7)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "pencil"
        {
            token outputs:surface.connect = </slide/Looks/pencil/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.25, 0.25, 0.27)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
    }

    def Cube "label_end" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </slide/Looks/frost>
        custom float physxCollision:contactOffset = 0.0002
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.02, 0.025, 0.001)
        double3 xformOp:translate = (0.027499999999999997, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "specimen" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </slide/Looks/glass>
        custom float physxCollision:contactOffset = 0.0002
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.055, 0.025, 0.001)
        double3 xformOp:translate = (-0.01, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "coverslip" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </slide/Looks/cover>
        custom float physxCollision:contactOffset = 0.0002
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.022, 0.022, 0.0002)
        double3 xformOp:translate = (0, 0, 0.0006000000000000001)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cylinder "spot" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.00005
        rel material:binding = </slide/Looks/stain>
        double radius = 0.0035
        double3 xformOp:translate = (0, 0, 0.00053)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "mark_0" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </slide/Looks/pencil>
        double size = 1
        float3 xformOp:scale = (0.0012, 0.012, 0.00005)
        double3 xformOp:translate = (0.0315, 0, 0.00053)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "mark_1" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </slide/Looks/pencil>
        double size = 1
        float3 xformOp:scale = (0.0012, 0.009, 0.00005)
        double3 xformOp:translate = (0.0285, 0, 0.00053)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "mark_2" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </slide/Looks/pencil>
        double size = 1
        float3 xformOp:scale = (0.0012, 0.006, 0.00005)
        double3 xformOp:translate = (0.025500000000000002, 0, 0.00053)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

