#usda 1.0
(
    defaultPrim = "Holder"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Holder" (
    customData = {
        string assetDescription = "Five-slot bamboo rack; center bay has a 90 mm open front for gripper access. Fixed fixture, no rigid-body API."
    }
)
{
    custom float task:centerBayWidth = 0.09
    custom vector3f task:insertionAxis = (0, 0, -1)
    custom float2 task:slotOpening = (0.046, 0.008)

    def "Looks"
    {
        def Material "Bamboo"
        {
            token outputs:surface.connect = </Holder/Looks/Bamboo/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.60382736, 0.31854677, 0.10653923)
                color3f inputs:diffuseColor.connect = </Holder/Looks/Bamboo/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/bamboo_grain.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Holder/Looks/Bamboo/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "EndGrain"
        {
            token outputs:surface.connect = </Holder/Looks/EndGrain/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.34239164, 0.13998489, 0.036306486)
                color3f inputs:diffuseColor.connect = </Holder/Looks/EndGrain/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.62
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/bamboo_grain.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Holder/Looks/EndGrain/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }
    }

    def Material "PhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.52
        float physics:restitution = 0
        float physics:staticFriction = 0.65
    }

    def "Geometry"
