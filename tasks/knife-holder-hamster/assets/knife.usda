#usda 1.0
(
    defaultPrim = "Knife"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Knife" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
    customData = {
        string assetDescription = "Reusable 265 mm kitchen knife; local +Z runs from blade tip to handle end."
    }
)
{
    point3f physics:centerOfMass = (0, 0, 0.153)
    float physics:mass = 0.105
    bool physics:rigidBodyEnabled = 1
    custom int physxRigidBody:solverPositionIterationCount = 16
    custom int physxRigidBody:solverVelocityIterationCount = 4
    custom point3f task:handleGraspCenter = (0, 0, 0.215)

    def "Looks"
    {
        def Material "Steel"
        {
            token outputs:surface.connect = </Knife/Looks/Steel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.39312312, 0.44798842, 0.49190503)
                float inputs:metallic = 0.92
                float inputs:roughness = 0.22
                token outputs:surface
            }
        }

        def Material "Edge"
        {
            token outputs:surface.connect = </Knife/Looks/Edge/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.71056646, 0.7484141, 0.7874123)
                float inputs:metallic = 0.97
                float inputs:roughness = 0.16
                token outputs:surface
            }
        }

        def Material "Handle"
        {
            token outputs:surface.connect = </Knife/Looks/Handle/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.0054228688, 0.0058668656, 0.00621331)
                float inputs:metallic = 0
                float inputs:roughness = 0.33
                token outputs:surface
            }
        }

        def Material "Rivets"
        {
            token outputs:surface.connect = </Knife/Looks/Rivets/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.52252156, 0.55422175, 0.58701634)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.26
                token outputs:surface
            }
        }
    }

