#usda 1.0
(
    defaultPrim = "Environment"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Environment" (
    customData = {
        string instruction = "Put the knife into the holder."
        string targetSlot = "center slot; occupied by the hamster below the slot"
    }
)
{
    def Xform "Holder" (
        prepend references = @assets/holder.usda@
    )
    {
        quatf xformOp:orient = (0.70710677, 0, 0, -0.70710677)
        double3 xformOp:translate = (0.355, 0, 0.7474999999999999)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Xform "StoredKnife_1" (
        prepend references = @assets/knife.usda@
    )
    {
        bool physics:kinematicEnabled = 1
        quatf xformOp:orient = (0.70710677, 0, 0, -0.70710677)
        double3 xformOp:translate = (0.355, 0.171, 0.7615)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Xform "StoredKnife_2" (
        prepend references = @assets/knife.usda@
    )
    {
        bool physics:kinematicEnabled = 1
        quatf xformOp:orient = (0.70710677, 0, 0, -0.70710677)
        double3 xformOp:translate = (0.355, 0.09, 0.7615)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Xform "StoredKnife_4" (
        prepend references = @assets/knife.usda@
    )
    {
        bool physics:kinematicEnabled = 1
        quatf xformOp:orient = (0.70710677, 0, 0, -0.70710677)
        double3 xformOp:translate = (0.355, -0.09, 0.7615)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Xform "StoredKnife_5" (
        prepend references = @assets/knife.usda@
    )
    {
        bool physics:kinematicEnabled = 1
        quatf xformOp:orient = (0.70710677, 0, 0, -0.70710677)
        double3 xformOp:translate = (0.355, -0.171, 0.7615)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Xform "Hamster" (
        prepend references = @assets/hamster.usda@
    )
    {
        quatf xformOp:orient = (0.70710677, 0, 0, -0.70710677)
        double3 xformOp:translate = (0.349, 0, 0.7619999999999999)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Xform "LooseKnife" (
        prepend references = @assets/knife.usda@
    )
    {
        quatf xformOp:orient = (0.70744705, 0.6797153, -0.13417669, -0.13965099)
        double3 xformOp:translate = (0.217, 0.196, 0.7493)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }
}
