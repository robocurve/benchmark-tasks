            rel material:binding:physics = </cutter_set/PhysicsMaterials/grip> (
                bindMaterialAs = "weakerThanDescendants"
            )
            uniform token physics:approximation = "convexHull"
            point3f[] points = [(-0.018, 0.014782073, 0.006122935), (-0.018, 0.006122935, 0.014782073), (-0.018, -0.006122935, 0.014782073), (-0.018, -0.014782073, 0.006122935), (-0.018, -0.014782073, -0.006122935), (-0.018, -0.006122935, -0.014782073), (-0.018, 0.006122935, -0.014782073), (-0.018, 0.014782073, -0.006122935), (0.018, 0.014782073, 0.006122935), (0.018, 0.006122935, 0.014782073), (0.018, -0.006122935, 0.014782073), (0.018, -0.014782073, 0.006122935), (0.018, -0.014782073, -0.006122935), (0.018, -0.006122935, -0.014782073), (0.018, 0.006122935, -0.014782073), (0.018, 0.014782073, -0.006122935)]
            uniform token subdivisionScheme = "none"
            double3 xformOp:translate = (0.018, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Mesh "stripe" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform bool doubleSided = 1
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4, 6, 6]
            int[] faceVertexIndices = [0, 1, 7, 6, 1, 2, 8, 7, 2, 3, 9, 8, 3, 4, 10, 9, 4, 5, 11, 10, 5, 0, 6, 11, 5, 4, 3, 2, 1, 0, 6, 7, 8, 9, 10, 11]
            rel material:binding = </cutter_set/Looks/orange>
            point3f[] points = [(-0.00225, 0.0076210233, 0.0044), (-0.00225, 5.388446e-19, 0.0088), (-0.00225, -0.0076210233, 0.0044), (-0.00225, -0.0076210233, -0.0044), (-0.00225, -1.6165337e-18, -0.0088), (-0.00225, 0.0076210233, -0.0044), (0.00225, 0.0076210233, 0.0044), (0.00225, 5.388446e-19, 0.0088), (0.00225, -0.0076210233, 0.0044), (0.00225, -0.0076210233, -0.0044), (0.00225, -1.6165337e-18, -0.0088), (0.00225, 0.0076210233, -0.0044)]
