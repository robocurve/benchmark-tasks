    def Xform "tube" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        float physics:mass = 1
        custom bool physxArticulation:enabledSelfCollisions = 0
        custom int physxArticulation:solverPositionIterationCount = 32
        custom int physxArticulation:solverVelocityIterationCount = 4
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Cube "block" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
            rel material:binding = </cutter_set/Looks/wood>
            double size = 1
            float3 xformOp:scale = (0.1, 0.1, 0.018)
            double3 xformOp:translate = (0, 0, 0.009)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
