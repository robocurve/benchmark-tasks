#usda 1.0
(
    defaultPrim = "cutter_set"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "cutter_set"
{
    def "Looks"
    {
        def Material "copper"
        {
            token outputs:surface.connect = </cutter_set/Looks/copper/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.42, 0.2)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "mark"
        {
            token outputs:surface.connect = </cutter_set/Looks/mark/Shader.outputs:surface>

