    def "PhysicsMaterials"
    {
        def Material "grip" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 1
            float physics:staticFriction = 1.2
            custom token physxMaterial:frictionCombineMode = "max"
        }
    }

    def "joints"
    {
        def PhysicsRevoluteJoint "orbit" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </cutter_set/tube>
            rel physics:body1 = </cutter_set/carrier>
            point3f physics:localPos0 = (0, 0, 0.075)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0, 0, 0.70710677)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -1440
            float physics:upperLimit = 1440
        }

        def PhysicsPrismaticJoint "slide" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear"]
        )
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </cutter_set/carrier>
            rel physics:body1 = </cutter_set/cutter>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -0.02
            float physics:upperLimit = 0.02
        }

        def PhysicsRevoluteJoint "feed" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "X"
            rel physics:body0 = </cutter_set/cutter>
            rel physics:body1 = </cutter_set/knob>
            point3f physics:localPos0 = (0.098, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -1440
            float physics:upperLimit = 1440
        }
    }
