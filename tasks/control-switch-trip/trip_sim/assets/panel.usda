#usda 1.0
(
    defaultPrim = "panel"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "panel" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 1
    custom int physxArticulation:solverPositionIterationCount = 32
    custom int physxArticulation:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "panel"
        {
            token outputs:surface.connect = </panel/Looks/panel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.64, 0.64)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

