            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.015996294, 0.02121901, 0.027320892)
                float inputs:metallic = 0
                float inputs:roughness = 0.08
                token outputs:surface
            }
        }

        def Material "pad"
        {
            token outputs:surface.connect = </printer/Looks/pad/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9046612, 0.9046612, 0.8879231)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }

        def Material "paper"
        {
            token outputs:surface.connect = </printer/Looks/paper/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9734453, 0.9734453, 1)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }

        def Material "mark"
        {
            token outputs:surface.connect = </printer/Looks/mark/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.00699541, 0.00699541, 0.008023193)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "panel"
        {
            token outputs:surface.connect = </printer/Looks/panel/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </printer/Looks/panel/texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/pl_panel_1.png@
                float2 inputs:st.connect = </printer/Looks/panel/st.outputs:result>
                float3 outputs:rgb
            }
        }

        def Material "key_black"
        {
            token outputs:surface.connect = </printer/Looks/key_black/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
