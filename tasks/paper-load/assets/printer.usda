#usda 1.0
(
    defaultPrim = "printer"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "printer" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 0
    custom float physxArticulation:sleepThreshold = 0
    custom float physxArticulation:stabilizationThreshold = 0

    def "Looks"
    {
        def Material "white"
        {
            token outputs:surface.connect = </printer/Looks/white/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7605245, 0.7605245, 0.73046076)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "shade"
        {
            token outputs:surface.connect = </printer/Looks/shade/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.67244315, 0.67244315, 0.6444797)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "grey"
        {
