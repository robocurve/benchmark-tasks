    def "joints"
    {
        def PhysicsFixedJoint "root_joint"
        {
            rel physics:body1 = </printer/body>
        }

        def PhysicsRevoluteJoint "cover" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Y"
            rel physics:body0 = </printer/body>
            rel physics:body1 = </printer/cover>
            point3f physics:localPos0 = (0.385, 0, 0.135)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 100
        }

        def PhysicsRevoluteJoint "support" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0
            float drive:angular:physics:stiffness = 0
