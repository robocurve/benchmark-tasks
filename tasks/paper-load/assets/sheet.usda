#usda 1.0
(
    defaultPrim = "sheet"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "sheet"
{
    def "Looks"
    {
        def Material "face"
        {
            token outputs:surface.connect = </sheet/Looks/face/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9734453, 0.9734453, 1)
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }
    }

    def Xform "strip_0" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
    )
    {
        float physics:mass = 0.02
