            rel material:binding = </sheet/Looks/face>
            point3f[] points = [(-0.015522222, 0.10795, 0.00025), (-0.015522222, -0.10795, 0.00025), (0.015522222, -0.10795, 0.00025), (0.015522222, 0.10795, 0.00025)]
