#usda 1.0
(
    defaultPrim = "padlock"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "padlock" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 0

    def "Looks"
    {
        def Material "lock_purple"
        {
            token outputs:surface.connect = </padlock/Looks/lock_purple/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.45, 0.2, 0.6)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "steel"
        {
            token outputs:surface.connect = </padlock/Looks/steel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.74, 0.77)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "dark"
        {
            token outputs:surface.connect = </padlock/Looks/dark/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.12, 0.13)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "label_white"
        {
            token outputs:surface.connect = </padlock/Looks/label_white/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.95, 0.95)
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "label_red"
