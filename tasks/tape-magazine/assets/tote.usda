#usda 1.0
(
    defaultPrim = "tote"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "tote" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
)
{
    def "Looks"
    {
        def Material "tote"
        {
            token outputs:surface.connect = </tote/Looks/tote/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.42, 0.55)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }
    }

    def Cube "floor" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </tote/Looks/tote>
        double size = 1
        float3 xformOp:scale = (0.114, 0.28, 0.004)
        double3 xformOp:translate = (0.17099999999999999, 0, 0.002)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "front" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
