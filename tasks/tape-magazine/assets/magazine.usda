#usda 1.0
(
    defaultPrim = "magazine"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "magazine" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
)
{
    def "Looks"
    {
        def Material "body"
        {
            token outputs:surface.connect = </magazine/Looks/body/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.17, 0.18, 0.2)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "lip"
        {
            token outputs:surface.connect = </magazine/Looks/lip/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </magazine/Looks/lip/texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/slots.png@
                float2 inputs:st.connect = </magazine/Looks/lip/st.outputs:result>
                float3 outputs:rgb
            }
        }
    }

    def Cube "floor" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </magazine/Looks/body>
        double size = 1
        float3 xformOp:scale = (0.11, 0.157, 0.006)
        double3 xformOp:translate = (0.415, 0, 0.003)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "top" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </magazine/Looks/body>
        double size = 1
        float3 xformOp:scale = (0.095, 0.157, 0.004)
        double3 xformOp:translate = (0.4225, 0, 0.124)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "back" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </magazine/Looks/body>
        double size = 1
        float3 xformOp:scale = (0.012, 0.157, 0.116)
