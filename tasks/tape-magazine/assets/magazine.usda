        uniform bool doubleSided = 1
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
        rel material:binding = </magazine/Looks/body>
        uniform token physics:approximation = "convexHull"
        point3f[] points = [(0.36, 0.078, 0.006), (0.36, 0.0785, 0.006), (0.36, 0.0785, 0.122), (0.36, 0.078, 0.122), (0.376, 0.073, 0.006), (0.376, 0.0785, 0.006), (0.376, 0.0785, 0.122), (0.376, 0.073, 0.122)]
