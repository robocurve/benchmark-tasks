    def Scope "Physics"
    {
        def PhysicsPrismaticJoint "arm_left" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear"]
        )
        {
            float drive:linear:physics:damping = 1.5
            float drive:linear:physics:maxForce = 100
            float drive:linear:physics:stiffness = 80
            uniform token drive:linear:physics:type = "force"
            uniform token physics:axis = "Y"
            rel physics:body0 = </holder/Geometry/body>
            rel physics:body1 = </holder/Geometry/body/arm_left>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.018
        }

        def PhysicsPrismaticJoint "arm_right" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear", "NewtonMimicAPI"]
        )
        {
            float drive:linear:physics:damping = 1.5
            float drive:linear:physics:maxForce = 100
            float drive:linear:physics:stiffness = 80
            uniform token drive:linear:physics:type = "force"
            custom float newton:mimicCoef0 = 0
            custom float newton:mimicCoef1 = 1
            custom bool newton:mimicEnabled = 1
            custom rel newton:mimicJoint = </holder/Physics/arm_left>
            uniform token physics:axis = "Y"
            rel physics:body0 = </holder/Geometry/body>
            rel physics:body1 = </holder/Geometry/body/arm_right>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0, 0, 0, 1)
            quatf physics:localRot1 = (0, 0, 0, 1)
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.018
        }

        def PhysicsPrismaticJoint "trigger" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear"]
        )
        {
            float drive:linear:physics:damping = 0.5
            float drive:linear:physics:maxForce = 100
            float drive:linear:physics:stiffness = 300
            uniform token drive:linear:physics:type = "force"
            uniform token physics:axis = "X"
            rel physics:body0 = </holder/Geometry/body>
            rel physics:body1 = </holder/Geometry/body/trigger>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.006
        }

        def PhysicsFixedJoint "root_joint"
        {
            rel physics:body0 = </holder>
            rel physics:body1 = </holder/Geometry/body>
        }
    }
}

