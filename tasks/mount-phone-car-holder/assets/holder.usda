#usda 1.0
(
    defaultPrim = "holder"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "holder"
{
    def Scope "Looks"
    {
        def Material "black"
        {
            token outputs:surface.connect = </holder/Looks/black/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.08, 0.09)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "grey"
        {
            token outputs:surface.connect = </holder/Looks/grey/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.35, 0.36, 0.38)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "inner"
        {
            token outputs:surface.connect = </holder/Looks/inner/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.85, 0.8)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "abs_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.4
        }

        def Material "silicone_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.9
            float physics:restitution = 0
            float physics:staticFriction = 1
        }

        def Material "pom_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.18
            float physics:restitution = 0
            float physics:staticFriction = 0.2
        }
    }

    def Scope "Geometry"
    {
        def Xform "body" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (0.02, 0, 0.045)
            float3 physics:diagonalInertia = (0.00029573333, 0.00020041666, 0.00016281666)
            float physics:mass = 0.2
            quatf physics:principalAxes = (1, 0, 0, 0)
            custom bool physxArticulation:enabledSelfCollisions = 1

            def Cube "plate" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                rel material:binding = </holder/Looks/black>
                rel material:binding:physics = </holder/Looks/abs_physics> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                color3f[] primvars:displayColor = [(0.08, 0.08, 0.09)]
                double size = 1
                float3 xformOp:scale = (0.006, 0.064, 0.102)
                double3 xformOp:translate = (0.003, 0, 0.041)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

