#usda 1.0
(
    defaultPrim = "Scene"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Z"
)
def Xform "Scene"
{
    def Xform "rig" (
        prepend references = @./assets/rig.usda@
    )
    {
        double3 xformOp:translate = (0.306, -0.007, 0.7475)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "drive_unit" (
        prepend references = @./assets/drive_unit.usda@
    )
    {
        double3 xformOp:translate = (0.306, -0.007, 0.7475)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
