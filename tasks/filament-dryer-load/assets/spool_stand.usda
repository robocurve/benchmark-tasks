#usda 1.0
(
    defaultPrim = "SpoolStand"
    doc = "Printed spool stand (PLA): a 150 x 90 x 5 mm plate with two round-topped rails along y, 110 mm apart; a 200 mm spool stands in it on its rims, axis level along y, its centre 113 mm up. Origin on the table under its middle. 80 g."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "SpoolStand" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
)
{
    point3f physics:centerOfMass = (0, 0, 0.006402439)
    float3 physics:diagonalInertia = (0.00005659062, 0.00018915908, 0.00024056845)
    float physics:mass = 0.08
    quatf physics:principalAxes = (1, 0, 0, 0)
    custom float physxRigidBody:maxDepenetrationVelocity = 0.2
    custom int physxRigidBody:solverPositionIterationCount = 32
    custom int physxRigidBody:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "Shell"
        {
            token outputs:surface.connect = </SpoolStand/Looks/Shell/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.105, 0.115)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "Interior"
        {
            token outputs:surface.connect = </SpoolStand/Looks/Interior/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.56, 0.57)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Gasket"
        {
            token outputs:surface.connect = </SpoolStand/Looks/Gasket/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.045, 0.045, 0.05)
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "ClearPC"
        {
            token outputs:surface.connect = </SpoolStand/Looks/ClearPC/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.33, 0.36)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 0.3
                float inputs:roughness = 0.06
                token outputs:surface
            }
        }

        def Material "Glass"
        {
            token outputs:surface.connect = </SpoolStand/Looks/Glass/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.008, 0.01, 0.012)
                float inputs:metallic = 0
                float inputs:roughness = 0.08
                token outputs:surface
            }
        }

        def Material "Display"
        {
            token outputs:surface.connect = </SpoolStand/Looks/Display/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </SpoolStand/Looks/Display/Texture.outputs:rgb>
                color3f inputs:emissiveColor.connect = </SpoolStand/Looks/Display/EmissiveTexture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.1
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/display.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </SpoolStand/Looks/Display/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "EmissiveTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/display.png@
                float4 inputs:scale = (0.6, 0.6, 0.6, 1)
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </SpoolStand/Looks/Display/stReader.outputs:result>
                float3 outputs:rgb
            }
        }

        def Material "Buttons"
        {
            token outputs:surface.connect = </SpoolStand/Looks/Buttons/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </SpoolStand/Looks/Buttons/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/buttons.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </SpoolStand/Looks/Buttons/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "RatingPlate"
        {
            token outputs:surface.connect = </SpoolStand/Looks/RatingPlate/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </SpoolStand/Looks/RatingPlate/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/dryer_label.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </SpoolStand/Looks/RatingPlate/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "Roller"
        {
            token outputs:surface.connect = </SpoolStand/Looks/Roller/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.88, 0.88, 0.85)
                float inputs:metallic = 0
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "Steel"
        {
            token outputs:surface.connect = </SpoolStand/Looks/Steel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.63, 0.65)
                float inputs:metallic = 1
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "Rubber"
        {
            token outputs:surface.connect = </SpoolStand/Looks/Rubber/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.03, 0.03, 0.03)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "Grille"
        {
            token outputs:surface.connect = </SpoolStand/Looks/Grille/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.015, 0.015, 0.017)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "BlackPlastic"
        {
            token outputs:surface.connect = </SpoolStand/Looks/BlackPlastic/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.035, 0.035, 0.04)
