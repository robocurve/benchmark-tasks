            }
        }

        def Material "PTFE"
        {
            token outputs:surface.connect = </SpoolStand/Looks/PTFE/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.93, 0.93, 0.9)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 0.85
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "Kraft"
        {
            token outputs:surface.connect = </SpoolStand/Looks/Kraft/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </SpoolStand/Looks/Kraft/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/kraft.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </SpoolStand/Looks/Kraft/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "Filament"
        {
            token outputs:surface.connect = </SpoolStand/Looks/Filament/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.33, 0.04)
                float inputs:metallic = 0
                float inputs:roughness = 0.32
                token outputs:surface
            }
        }

        def Material "SpoolLabel"
        {
            token outputs:surface.connect = </SpoolStand/Looks/SpoolLabel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </SpoolStand/Looks/SpoolLabel/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }

            def Shader "stReader"
