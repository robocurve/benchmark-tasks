            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.045, 0.045, 0.05)
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "ClearPC"
        {
            token outputs:surface.connect = </FilamentDryer/Looks/ClearPC/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.33, 0.36)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 0.3
                float inputs:roughness = 0.06
                token outputs:surface
            }
        }

        def Material "Glass"
        {
            token outputs:surface.connect = </FilamentDryer/Looks/Glass/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.008, 0.01, 0.012)
                float inputs:metallic = 0
                float inputs:roughness = 0.08
                token outputs:surface
            }
        }

        def Material "Display"
        {
            token outputs:surface.connect = </FilamentDryer/Looks/Display/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </FilamentDryer/Looks/Display/Texture.outputs:rgb>
                color3f inputs:emissiveColor.connect = </FilamentDryer/Looks/Display/EmissiveTexture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.1
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/display.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </FilamentDryer/Looks/Display/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "EmissiveTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/display.png@
                float4 inputs:scale = (0.6, 0.6, 0.6, 1)
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </FilamentDryer/Looks/Display/stReader.outputs:result>
                float3 outputs:rgb
            }
        }

        def Material "Buttons"
