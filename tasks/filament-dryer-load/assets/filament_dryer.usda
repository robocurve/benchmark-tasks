                rel material:binding:physics = </FilamentDryer/Looks/Phys_POM> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                uniform token physics:approximation = "convexHull"
                custom float physxCollision:contactOffset = 0.0003
                custom float physxCollision:restOffset = 0
                custom int physxConvexHullCollision:hullVertexLimit = 64
                point3f[] points = [(-0.008, -0.0031, 0), (-0.008, 0, 0), (-0.008, 0, 0.0041), (-0.008, -0.0031, 0.001), (0.008, -0.0031, 0), (0.008, 0, 0), (0.008, 0, 0.0041), (0.008, -0.0031, 0.001)]
                uniform token purpose = "guide"
            }

            def Cube "Block" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
            )
            {
                float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
                rel material:binding:physics = </FilamentDryer/Looks/Phys_POM> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.0003
                custom float physxCollision:restOffset = 0
                uniform token purpose = "guide"
                double size = 1
                float3 xformOp:scale = (0.016, 0.004, 0.012)
                double3 xformOp:translate = (0, 0.002, 0.00019999999999998863)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }
    }

    def Scope "Joints"
    {
        def PhysicsRevoluteJoint "LidHinge" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            doc = "Friction hinge: damping only. 0 = shut, -100 deg = fully open on its stop (negative opens). The hood rests open on the stop by its weight; closed past about 50 deg open it falls shut."
        )
        {
            float drive:angular:physics:damping = 0.0034906585
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "X"
            rel physics:body0 = </FilamentDryer/Body>
            rel physics:body1 = </FilamentDryer/Lid>
            point3f physics:localPos0 = (0, 0.065, 0.16)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -100
            float physics:upperLimit = 0
        }

        def PhysicsRevoluteJoint "RollerAAxle" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            doc = "Free-spinning roller axle (a little bearing drag), +-170 deg of travel."
        )
        {
            float drive:angular:physics:damping = 0.0000034906584
            float drive:angular:physics:stiffness = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Y"
            rel physics:body0 = </FilamentDryer/Body>
            rel physics:body1 = </FilamentDryer/RollerA>
            point3f physics:localPos0 = (-0.065, 0, 0.03)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -170
            float physics:upperLimit = 170
        }

        def PhysicsRevoluteJoint "RollerBAxle" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            doc = "Free-spinning roller axle (a little bearing drag), +-170 deg of travel."
        )
        {
            float drive:angular:physics:damping = 0.0000034906584
            float drive:angular:physics:stiffness = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Y"
            rel physics:body0 = </FilamentDryer/Body>
            rel physics:body1 = </FilamentDryer/RollerB>
            point3f physics:localPos0 = (0.065, 0, 0.03)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -170
            float physics:upperLimit = 170
        }

        def PhysicsPrismaticJoint "LatchSlide" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear"]
            doc = "Catch return spring: 200 N/m, 0.2 N preload at rest; the hook's 45 deg chamfer pushes the slider 1.1 mm back as the hood is pressed shut and it snaps over the hook."
        )
        {
            float drive:linear:physics:damping = 1
            float drive:linear:physics:stiffness = 200
            float drive:linear:physics:targetPosition = -0.001
            uniform token drive:linear:physics:type = "force"
            uniform token physics:axis = "Y"
            rel physics:body0 = </FilamentDryer/Body>
            rel physics:body1 = </FilamentDryer/Latch>
            point3f physics:localPos0 = (-0.1, -0.056, 0.1508)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.003
        }
    }
}

