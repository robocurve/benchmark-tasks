#usda 1.0
(
    defaultPrim = "FilamentDryer"
    doc = "Single-spool filament dryer, generic (no brand): 262 x 130 x 240 mm, 1.2 kg. One articulation, root Body (the base, origin on the table under its middle; x along it, y across it, z up). Lid: the smoked clear hood, hinged along the base's back (+y) top edge (Joints/LidHinge, about +x, 0 shut .. -100 deg open, negative opens), a friction hinge (damping only). RollerA/RollerB: two free-spinning rollers along y the spool rests on. Latch: the catch slider in the front wall (Joints/LatchSlide, along +y, 0..3 mm, 200 N/m return spring with 0.2 N preload) whose tongue snaps over the hook on the hood's front tab when the hood is pressed shut. Self collisions on: the catch holds the hood by contact between the hook and the tongue."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "FilamentDryer" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 1
    custom int physxArticulation:solverPositionIterationCount = 32
    custom int physxArticulation:solverVelocityIterationCount = 1

    def "Looks"
    {
        def Material "Shell"
        {
            token outputs:surface.connect = </FilamentDryer/Looks/Shell/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.105, 0.115)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "Interior"
        {
            token outputs:surface.connect = </FilamentDryer/Looks/Interior/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.56, 0.57)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Gasket"
        {
