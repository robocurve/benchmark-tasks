#usda 1.0
(
    defaultPrim = "FilamentSpool"
    doc = "1 kg spool of 1.75 mm PLA (orange) on a kraft-cardboard spool: 200 mm across, 67 mm wide, 53 mm hub hole, 1.18 kg. Origin at its centre, axis along y. Collides as two 32-sided flange prisms (200 mm, 3 mm thick) and a 32-sided prism for the winding (174 mm)."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "FilamentSpool" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (0.0033747545, 0.0058318987, 0.0033747545)
    float physics:mass = 1.18
    quatf physics:principalAxes = (1, 0, 0, 0)
    custom float physxRigidBody:maxDepenetrationVelocity = 0.2
    custom int physxRigidBody:solverPositionIterationCount = 32
    custom int physxRigidBody:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "Shell"
        {
            token outputs:surface.connect = </FilamentSpool/Looks/Shell/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.105, 0.115)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "Interior"
        {
            token outputs:surface.connect = </FilamentSpool/Looks/Interior/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.56, 0.57)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Gasket"
        {
            token outputs:surface.connect = </FilamentSpool/Looks/Gasket/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.045, 0.045, 0.05)
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "ClearPC"
        {
            token outputs:surface.connect = </FilamentSpool/Looks/ClearPC/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.33, 0.36)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 0.3
                float inputs:roughness = 0.06
                token outputs:surface
            }
        }

        def Material "Glass"
        {
            token outputs:surface.connect = </FilamentSpool/Looks/Glass/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.008, 0.01, 0.012)
                float inputs:metallic = 0
                float inputs:roughness = 0.08
                token outputs:surface
            }
        }

        def Material "Display"
        {
            token outputs:surface.connect = </FilamentSpool/Looks/Display/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </FilamentSpool/Looks/Display/Texture.outputs:rgb>
                color3f inputs:emissiveColor.connect = </FilamentSpool/Looks/Display/EmissiveTexture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.1
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/display.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </FilamentSpool/Looks/Display/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "EmissiveTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/display.png@
                float4 inputs:scale = (0.6, 0.6, 0.6, 1)
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </FilamentSpool/Looks/Display/stReader.outputs:result>
                float3 outputs:rgb
            }
        }

        def Material "Buttons"
        {
            token outputs:surface.connect = </FilamentSpool/Looks/Buttons/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </FilamentSpool/Looks/Buttons/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/buttons.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </FilamentSpool/Looks/Buttons/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "RatingPlate"
        {
            token outputs:surface.connect = </FilamentSpool/Looks/RatingPlate/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </FilamentSpool/Looks/RatingPlate/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/dryer_label.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </FilamentSpool/Looks/RatingPlate/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "Roller"
        {
            token outputs:surface.connect = </FilamentSpool/Looks/Roller/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.88, 0.88, 0.85)
                float inputs:metallic = 0
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "Steel"
        {
            token outputs:surface.connect = </FilamentSpool/Looks/Steel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.63, 0.65)
                float inputs:metallic = 1
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "Rubber"
        {
            token outputs:surface.connect = </FilamentSpool/Looks/Rubber/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.03, 0.03, 0.03)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "Grille"
        {
            token outputs:surface.connect = </FilamentSpool/Looks/Grille/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.015, 0.015, 0.017)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "BlackPlastic"
        {
            token outputs:surface.connect = </FilamentSpool/Looks/BlackPlastic/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.035, 0.035, 0.04)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "PTFE"
        {
            token outputs:surface.connect = </FilamentSpool/Looks/PTFE/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.93, 0.93, 0.9)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 0.85
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "Kraft"
        {
            token outputs:surface.connect = </FilamentSpool/Looks/Kraft/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </FilamentSpool/Looks/Kraft/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/kraft.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </FilamentSpool/Looks/Kraft/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "Filament"
        {
            token outputs:surface.connect = </FilamentSpool/Looks/Filament/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.33, 0.04)
                float inputs:metallic = 0
                float inputs:roughness = 0.32
                token outputs:surface
            }
        }

        def Material "SpoolLabel"
        {
            token outputs:surface.connect = </FilamentSpool/Looks/SpoolLabel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </FilamentSpool/Looks/SpoolLabel/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/spool_label.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </FilamentSpool/Looks/SpoolLabel/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "StandPLA"
        {
            token outputs:surface.connect = </FilamentSpool/Looks/StandPLA/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.38, 0.42)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "Phys_Cardboard" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.45
            float physics:restitution = 0
            float physics:staticFriction = 0.55
        }

        def Material "Phys_PLA" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.4
        }
    }

    def Mesh "Spool_Flanges" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
