            int[] faceVertexIndices = [0, 1, 2, 3]
            rel material:binding = </device/base/len_scale_mat>
            point3f[] points = [(0.15, -0.022, 0.00015), (0.322, -0.022, 0.00015), (0.322, 0.022, 0.00015), (0.15, 0.022, 0.00015)]
