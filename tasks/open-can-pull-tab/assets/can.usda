#usda 1.0
(
    defaultPrim = "Can"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Can" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "PhysxArticulationAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
)
{
    rel material:binding:physics = </Can/Material> (
        bindMaterialAs = "weakerThanDescendants"
    )
    point3f physics:centerOfMass = (0, 0, 0.055)
    float3 physics:diagonalInertia = (0.0005152875, 0.0005152875, 0.000190575)
    float physics:mass = 0.35
    custom bool physxArticulation:enabledSelfCollisions = 0
    custom float physxArticulation:sleepThreshold = 0
    custom int physxArticulation:solverPositionIterationCount = 32
    custom int physxArticulation:solverVelocityIterationCount = 4
    custom float physxArticulation:stabilizationThreshold = 0

    def Material "Material" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.7
        float physics:restitution = 0
        float physics:staticFriction = 0.8
    }

    def Scope "Looks"
    {
        def Material "smooth_aluminium"
        {
            token outputs:surface.connect = </Can/Looks/smooth_aluminium/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.60382736, 0.6209159, 0.6382832)
                float inputs:metallic = 0.9
                float inputs:opacity = 1
                float inputs:roughness = 0.24
                token outputs:surface
            }
        }

        def Material "matte_aluminium"
        {
            token outputs:surface.connect = </Can/Looks/matte_aluminium/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.52252156, 0.53823555, 0.55422175)
                float inputs:metallic = 0.8
                float inputs:opacity = 1
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "tab_aluminium"
        {
            token outputs:surface.connect = </Can/Looks/tab_aluminium/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.1, 0.12)
                float inputs:metallic = 0.92
                float inputs:opacity = 1
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }
    }

    def Xform "tab" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Can/tab/Material> (
            bindMaterialAs = "weakerThanDescendants"
        )
        point3f physics:centerOfMass = (0, 0.011, 0)
        float3 physics:diagonalInertia = (2.3333333e-8, 2.3333333e-8, 4.6666667e-8)
        float physics:mass = 0.0007
        custom float physxRigidBody:maxAngularVelocity = 300
        double3 xformOp:translate = (0, -0.001, 0.115)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Xform "visual"
        {
            def Xform "tab"
            {
