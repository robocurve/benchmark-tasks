#usda 1.0
(
    defaultPrim = "MiniTripod"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "MiniTripod" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    customData = {
        string head = "Fixed; only leg mechanics are simulated"
        string legs = "Fixed short legs; no telescoping joints"
        string reference = "Amazon Basics WT0352G / B00M78G2VO"
    }
)
{
    bool physxArticulation:enabledSelfCollisions = 1
    int physxArticulation:solverPositionIterationCount = 64
    int physxArticulation:solverVelocityIterationCount = 1

    def "Looks"
    {
        def Material "Aluminum" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </MiniTripod/Looks/Aluminum/Surface.outputs:surface>
            float physics:dynamicFriction = 1.6
            float physics:restitution = 0
            float physics:staticFriction = 2

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.65, 0.69)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }

        def Material "Chrome" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </MiniTripod/Looks/Chrome/Surface.outputs:surface>
            float physics:dynamicFriction = 0.48
            float physics:restitution = 0
            float physics:staticFriction = 0.6

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.74, 0.78)
                float inputs:metallic = 0.95
                float inputs:roughness = 0.19
                token outputs:surface
            }
        }

        def Material "BlackTube" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </MiniTripod/Looks/BlackTube/Surface.outputs:surface>
            float physics:dynamicFriction = 1.6
            float physics:restitution = 0
            float physics:staticFriction = 2

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.025, 0.028, 0.032)
                float inputs:metallic = 0.7
                float inputs:roughness = 0.22
                token outputs:surface
            }
        }

        def Material "Rubber" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </MiniTripod/Looks/Rubber/Surface.outputs:surface>
            float physics:dynamicFriction = 0.72
            float physics:restitution = 0
            float physics:staticFriction = 0.9

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.018, 0.02, 0.023)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "GripRubber" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </MiniTripod/Looks/GripRubber/Surface.outputs:surface>
            float physics:dynamicFriction = 1.6
            float physics:restitution = 0
            float physics:staticFriction = 2

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.018, 0.02, 0.023)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
    }

