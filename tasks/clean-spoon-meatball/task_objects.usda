        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Xform "RawChicken_5" (
        prepend references = @assets/raw_chicken.usda@
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0.34500000000000003, -0.22, 0.7519999999999999)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }
