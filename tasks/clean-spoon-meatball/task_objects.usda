        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Xform "UsedSpoon" (
        prepend references = @assets/spoon_used.usda@
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0.335, -0.32, 0.7519999999999999)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Xform "Meatball_1" (
        prepend references = @assets/meatball.usda@
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0.41475, -0.02475, 0.7539999999999999)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Xform "RawChicken_1" (
        prepend references = @assets/raw_chicken.usda@
    )
    {
        quatf xformOp:orient = (0.76604444, 0, 0, 0.64278764)
        double3 xformOp:translate = (0.43000000000000005, -0.4, 0.7519999999999999)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Xform "RawChicken_2" (
        prepend references = @assets/raw_chicken.usda@
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0.35500000000000004, -0.41200000000000003, 0.7519999999999999)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Xform "RawChicken_3" (
        prepend references = @assets/raw_chicken.usda@
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0.24000000000000002, -0.42000000000000004, 0.7519999999999999)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
