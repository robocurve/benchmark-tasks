#usda 1.0
(
    defaultPrim = "Environment"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Environment" (
    customData = {
        string instruction = "Scoop one meatball onto the empty plate."
    }
)
{
    def Xform "CleanPlate" (
        prepend references = @assets/platter.usda@
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0.335, 0.32, 0.7474999999999999)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Xform "RawPlate" (
        prepend references = @assets/platter.usda@
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0.335, -0.32, 0.7474999999999999)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Xform "MeatballBowl" (
        prepend references = @assets/bowl.usda@
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0.39, 0, 0.7474999999999999)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Xform "Plate" (
        prepend references = @assets/plate.usda@
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0.13, 0, 0.7474999999999999)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Xform "CleanSpoon" (
        prepend references = @assets/spoon_clean.usda@
