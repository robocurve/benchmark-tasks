#usda 1.0
(
    defaultPrim = "Spoon"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Spoon" (
    customData = {
        string cleanliness = "used_with_raw_chicken"
    }
    prepend references = @spoon.usda@
)
{
    over "Looks"
    {
        def Material "ChickenResidue"
        {
            token outputs:surface.connect = </Spoon/Looks/ChickenResidue/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5704816, 0.19599418, 0.10048151)
                float inputs:metallic = 0
                float inputs:roughness = 0.53
                token outputs:surface
            }
        }

        def Material "PaleResidue"
        {
            token outputs:surface.connect = </Spoon/Looks/PaleResidue/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.76776874, 0.44798842, 0.2846467)
                float inputs:metallic = 0
                float inputs:roughness = 0.48
                token outputs:surface
            }
        }
    }

