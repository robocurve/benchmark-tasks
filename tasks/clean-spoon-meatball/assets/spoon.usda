#usda 1.0
(
    defaultPrim = "Spoon"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Spoon" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
    customData = {
        double3 graspCenterLocal = (-0.069, 0, 0.027)
    }
)
{
    point3f physics:centerOfMass = (-0.008, 0, 0.019)
