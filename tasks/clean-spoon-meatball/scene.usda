#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    subLayers = [
        @assets/base_station.usda@
    ]
    upAxis = "Z"
)

def Xform "World"
{
    over "envs"
    {
        over "env_0"
        {
            def Xform "Task" (
                prepend references = @task_objects.usda@
            )
            {
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
        }
    }
}

