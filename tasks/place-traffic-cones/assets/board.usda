#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    def "materials"
    {
        def Material "board" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Asset/materials/board/surface.outputs:surface>
            float physics:dynamicFriction = 0.7
            float physics:restitution = 0
            float physics:staticFriction = 0.7

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.88, 0.89)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "ink" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Asset/materials/ink/surface.outputs:surface>
            float physics:dynamicFriction = 0.7
            float physics:restitution = 0
            float physics:staticFriction = 0.7

