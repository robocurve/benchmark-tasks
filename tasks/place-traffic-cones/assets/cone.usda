{
    def "materials"
    {
        def Material "orange" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Asset/materials/orange/surface.outputs:surface>
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0
            float physics:staticFriction = 0.8

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0.18, 0.012)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "white" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Asset/materials/white/surface.outputs:surface>
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0
            float physics:staticFriction = 0.8

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.9, 0.86)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "rubber" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Asset/materials/rubber/surface.outputs:surface>
            float physics:dynamicFriction = 1
            float physics:restitution = 0
            float physics:staticFriction = 1

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.025, 0.028, 0.032)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "tip" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Asset/materials/tip/surface.outputs:surface>
            float physics:dynamicFriction = 1.2
            float physics:restitution = 0
            float physics:staticFriction = 1.2

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0.18, 0.012)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

