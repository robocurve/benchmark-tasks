#usda 1.0
(
    defaultPrim = "wire_stand"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "wire_stand"
{
    def "Looks"
    {
        def Material "grey"
        {
            token outputs:surface.connect = </wire_stand/Looks/grey/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.63, 0.64)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

