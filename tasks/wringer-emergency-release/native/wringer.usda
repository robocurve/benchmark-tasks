    def PhysicsPrismaticJoint "compression" (
        prepend apiSchemas = ["PhysicsDriveAPI:linear"]
    )
    {
        float drive:linear:physics:damping = 4
        float drive:linear:physics:maxForce = 100
        float drive:linear:physics:stiffness = 1250
        float drive:linear:physics:targetPosition = -0.012
        uniform token drive:linear:physics:type = "force"
        uniform token physics:axis = "Z"
        rel physics:body0 = </Wringer/frame>
        rel physics:body1 = </Wringer/yoke>
        point3f physics:localPos0 = (0, 0, 0.111)
        point3f physics:localPos1 = (0, 0, 0)
        float physics:lowerLimit = 0
        float physics:upperLimit = 0.036
    }

