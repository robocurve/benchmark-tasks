            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Xform "lower"
        {
            double3 xformOp:translate = (0, 0, 0.043)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cylinder "roller" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
            )
            {
                uniform token axis = "Y"
                double height = 0.12
                rel material:binding:physics = </Wringer/rubber>
                color3f[] primvars:displayColor = [(0.23, 0.29, 0.33)]
                double radius = 0.0325
            }
        }
    }

