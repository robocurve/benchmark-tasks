#usda 1.0
(
    defaultPrim = "Wringer"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Wringer"
{
    def Material "rubber" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.75
        float physics:restitution = 0
        float physics:staticFriction = 0.9
    }

    def Xform "frame" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxContactReportAPI"]
    )
    {
        bool physics:kinematicEnabled = 1
        custom float physxContactReport:threshold = 0
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "foot" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Wringer/rubber>
            color3f[] primvars:displayColor = [(0.38, 0.47, 0.54)]
            double size = 1
            float3 xformOp:scale = (0.12, 0.19, 0.016)
            double3 xformOp:translate = (0, 0, 0.008)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "cheek_R" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
