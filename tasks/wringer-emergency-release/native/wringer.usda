            double size = 1
            float3 xformOp:scale = (0.036, 0.008, 0.084)
            double3 xformOp:translate = (0, -0.069, 0.049)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

