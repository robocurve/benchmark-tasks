    def "Looks"
    {
        def Material "orange"
        {
            token outputs:surface.connect = </chainsaw/Looks/orange/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.93, 0.4, 0.05)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "dark"
        {
            token outputs:surface.connect = </chainsaw/Looks/dark/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15, 0.16, 0.17)
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "mid"
        {
            token outputs:surface.connect = </chainsaw/Looks/mid/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.34, 0.35, 0.37)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "steel"
        {
            token outputs:surface.connect = </chainsaw/Looks/steel/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.64, 0.67)
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "chain"
        {
            token outputs:surface.connect = </chainsaw/Looks/chain/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.09, 0.09, 0.1)
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "red"
        {
            token outputs:surface.connect = </chainsaw/Looks/red/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.82, 0.1, 0.07)
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "warning"
        {
            token outputs:surface.connect = </chainsaw/Looks/warning/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </chainsaw/Looks/warning/texture.outputs:rgb>
                float inputs:roughness = 0.6
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/warning.png@
                float2 inputs:st.connect = </chainsaw/Looks/warning/st.outputs:result>
                float3 outputs:rgb
            }
        }

        def Material "brake"
        {
            token outputs:surface.connect = </chainsaw/Looks/brake/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </chainsaw/Looks/brake/texture.outputs:rgb>
                float inputs:roughness = 0.6
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "texture"
