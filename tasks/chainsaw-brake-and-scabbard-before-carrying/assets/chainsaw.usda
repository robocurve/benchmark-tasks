    def "joints"
    {
        def PhysicsRevoluteJoint "guard" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.08
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Z"
            rel physics:body0 = </chainsaw/saw>
            rel physics:body1 = </chainsaw/guard>
            point3f physics:localPos0 = (0.108, 0.052, 0.0425)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -35.523384
            float physics:upperLimit = 6.8754935
        }
    }
