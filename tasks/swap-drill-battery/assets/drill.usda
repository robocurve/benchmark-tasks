#usda 1.0
(
    defaultPrim = "drill"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "drill" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 1.3
    quatf xformOp:orient = (1, 0, 0, 0)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

    def "Looks"
    {
        def Material "grey"
        {
            token outputs:surface.connect = </drill/Looks/grey/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.16, 0.17, 0.18)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "accent"
        {
            token outputs:surface.connect = </drill/Looks/accent/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.45, 0.08)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "steel"
        {
            token outputs:surface.connect = </drill/Looks/steel/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.55, 0.57)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
    }

    def Cube "flange_front" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </drill/Looks/steel>
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
        double size = 1
        float3 xformOp:scale = (0.006, 0.012, 0.048)
        double3 xformOp:translate = (0.030000000000000002, 0.003500000000000005, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "flange_rear" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </drill/Looks/steel>
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
        double size = 1
        float3 xformOp:scale = (0.006, 0.036, 0.048)
        double3 xformOp:translate = (0.030000000000000002, 0.03950000000000001, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "stem" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </drill/Looks/steel>
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
        double size = 1
        float3 xformOp:scale = (0.008, 0.06, 0.034)
        double3 xformOp:translate = (0.037000000000000005, 0.027500000000000004, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "foot" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </drill/Looks/grey>
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
        double size = 1
        float3 xformOp:scale = (0.019, 0.071, 0.076)
        double3 xformOp:translate = (0.0505, 0.033, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "stop" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </drill/Looks/grey>
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
        double size = 1
        float3 xformOp:scale = (0.014, 0.009, 0.076)
        double3 xformOp:translate = (0.034, 0.064, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "handle" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </drill/Looks/grey>
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
        double size = 1
        float3 xformOp:scale = (0.11, 0.05, 0.035)
        double3 xformOp:translate = (0.11499999999999999, 0.03, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "grip_pad" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </drill/Looks/accent>
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
        double size = 1
        float3 xformOp:scale = (0.09, 0.002, 0.029)
        double3 xformOp:translate = (0.11499999999999999, 0.056, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "motor" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </drill/Looks/accent>
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
        double size = 1
        float3 xformOp:scale = (0.07, 0.195, 0.068)
        double3 xformOp:translate = (0.205, -0.0325, -0.003999999999999997)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cylinder "chuck" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        uniform token axis = "Y"
        double height = 0.07
        rel material:binding = </drill/Looks/grey>
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
        double radius = 0.021
        double3 xformOp:translate = (0.205, -0.165, -0.003999999999999997)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "bit" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Y"
        double height = 0.05
        rel material:binding = </drill/Looks/steel>
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
        double radius = 0.003
        double3 xformOp:translate = (0.205, -0.225, -0.003999999999999997)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "trigger" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </drill/Looks/grey>
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
        double size = 1
        float3 xformOp:scale = (0.023, 0.012, 0.016)
        double3 xformOp:translate = (0.14649999999999996, -0.001, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

