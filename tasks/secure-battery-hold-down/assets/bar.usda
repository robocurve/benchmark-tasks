        double3 xformOp:translate = (0.096, -0.00885, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "end_n_visual"
    {
        color3f[] primvars:displayColor = [(0.017744508, 0.017744508, 0.02027625)]
        double size = 1
        float3 xformOp:scale = (0.008, 0.0254, 0.004)
        double3 xformOp:translate = (-0.11, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
