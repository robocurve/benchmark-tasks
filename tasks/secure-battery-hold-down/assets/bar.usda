            float3 xformOp:scale = (0.02, 0.0077, 0.004)
            double3 xformOp:translate = (0.096, -0.00885, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "end_n" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            custom float physxCollision:contactOffset = 0.0002
            custom float physxCollision:restOffset = 0
            double size = 1
            token visibility = "invisible"
            float3 xformOp:scale = (0.008, 0.0254, 0.004)
            double3 xformOp:translate = (-0.11, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "cheek_n_l" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            custom float physxCollision:contactOffset = 0.0002
            custom float physxCollision:restOffset = 0
            double size = 1
