#usda 1.0
(
    defaultPrim = "Nut"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Nut" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
)
{
    rel material:binding:physics = </Nut/Material> (
        bindMaterialAs = "weakerThanDescendants"
    )
    point3f physics:centerOfMass = (0, 0, 0.00572)
    float physics:mass = 0.025

    def Cylinder "flange_visual"
    {
        uniform token axis = "Z"
        double height = 0.002
        color3f[] primvars:displayColor = [(0.45626345, 0.45626345, 0.40086365)]
        double radius = 0.0127
        double3 xformOp:translate = (0, 0, 0.001)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "body_visual"
    {
        uniform token axis = "Z"
        double height = 0.0123
        color3f[] primvars:displayColor = [(0.45626345, 0.45626345, 0.40086365)]
        double radius = 0.0085
        double3 xformOp:translate = (0, 0, 0.008150000000000001)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "bore_visual"
    {
        uniform token axis = "Z"
        double height = 0.0145
        color3f[] primvars:displayColor = [(0.003861873, 0.003861873, 0.005004187)]
        double radius = 0.004
        double3 xformOp:translate = (0, 0, 0.00735)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def "collision"
    {
        def Cube "flange_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            custom float physxCollision:contactOffset = 0.0002
            custom float physxCollision:restOffset = 0
            double size = 1
            token visibility = "invisible"
            float3 xformOp:scale = (0.006565, 0.02413, 0.002)
            double3 xformOp:translate = (-0.008782499999999999, 0, 0.001)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "flange_1" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            custom float physxCollision:contactOffset = 0.0002
            custom float physxCollision:restOffset = 0
            double size = 1
            token visibility = "invisible"
            float3 xformOp:scale = (0.006565, 0.02413, 0.002)
            double3 xformOp:translate = (0.008782499999999999, 0, 0.001)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "flange_2" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            custom float physxCollision:contactOffset = 0.0002
            custom float physxCollision:restOffset = 0
            double size = 1
            token visibility = "invisible"
            float3 xformOp:scale = (0.011, 0.006565, 0.002)
            double3 xformOp:translate = (0, -0.008782499999999999, 0.001)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "flange_3" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            custom float physxCollision:contactOffset = 0.0002
            custom float physxCollision:restOffset = 0
            double size = 1
            token visibility = "invisible"
            float3 xformOp:scale = (0.011, 0.006565, 0.002)
            double3 xformOp:translate = (0, 0.008782499999999999, 0.001)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "body_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            custom float physxCollision:contactOffset = 0.0002
            custom float physxCollision:restOffset = 0
            double size = 1
            token visibility = "invisible"
            float3 xformOp:scale = (0.002575, 0.01615, 0.0123)
            double3 xformOp:translate = (-0.0067875, 0, 0.008150000000000001)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "body_1" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            custom float physxCollision:contactOffset = 0.0002
            custom float physxCollision:restOffset = 0
            double size = 1
            token visibility = "invisible"
            float3 xformOp:scale = (0.002575, 0.01615, 0.0123)
            double3 xformOp:translate = (0.0067875, 0, 0.008150000000000001)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "body_2" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            custom float physxCollision:contactOffset = 0.0002
            custom float physxCollision:restOffset = 0
            double size = 1
            token visibility = "invisible"
            float3 xformOp:scale = (0.011, 0.002575, 0.0123)
            double3 xformOp:translate = (0, -0.0067875, 0.008150000000000001)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "body_3" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            custom float physxCollision:contactOffset = 0.0002
            custom float physxCollision:restOffset = 0
            double size = 1
            token visibility = "invisible"
            float3 xformOp:scale = (0.011, 0.002575, 0.0123)
            double3 xformOp:translate = (0, 0.0067875, 0.008150000000000001)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Material "Material" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.3
        float physics:restitution = 0
        float physics:staticFriction = 0.4
    }
}

