#usda 1.0
(defaultPrim = "assembly"
 metersPerUnit = 1
 upAxis = "Z")
def Xform "assembly" {
def Scope "Materials" {
def Material "steel" (prepend apiSchemas = ["PhysicsMaterialAPI"]) {
 float physics:staticFriction = 0.12
 float physics:dynamicFriction = 0.1
 float physics:restitution = 0
 token outputs:surface.connect = </assembly/Materials/steel/shader.outputs:surface>
 def Shader "shader" { uniform token info:id = "UsdPreviewSurface"
 color3f inputs:diffuseColor = (0.5, 0.54, 0.58)
 float inputs:roughness = 0.5
 token outputs:surface
 }
 }
def Material "acetal" (prepend apiSchemas = ["PhysicsMaterialAPI"]) {
 float physics:staticFriction = 0.12
 float physics:dynamicFriction = 0.1
 float physics:restitution = 0
 token outputs:surface.connect = </assembly/Materials/acetal/shader.outputs:surface>
 def Shader "shader" { uniform token info:id = "UsdPreviewSurface"
 color3f inputs:diffuseColor = (0.83, 0.83, 0.76)
 float inputs:roughness = 0.5
 token outputs:surface
 }
 }
def Material "mount" (prepend apiSchemas = ["PhysicsMaterialAPI"]) {
 float physics:staticFriction = 0.4
 float physics:dynamicFriction = 0.3
 float physics:restitution = 0
 token outputs:surface.connect = </assembly/Materials/mount/shader.outputs:surface>
 def Shader "shader" { uniform token info:id = "UsdPreviewSurface"
 color3f inputs:diffuseColor = (0.18, 0.21, 0.24)
 float inputs:roughness = 0.5
 token outputs:surface
 }
 }
def Material "mark" (prepend apiSchemas = ["PhysicsMaterialAPI"]) {
 float physics:staticFriction = 0.12
 float physics:dynamicFriction = 0.1
 float physics:restitution = 0
 token outputs:surface.connect = </assembly/Materials/mark/shader.outputs:surface>
 def Shader "shader" { uniform token info:id = "UsdPreviewSurface"
 color3f inputs:diffuseColor = (0.8, 0.22, 0.035)
 float inputs:roughness = 0.5
 token outputs:surface
 }
 }
}
def Xform "base" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI", "PhysxContactReportAPI"]) {
 double3 xformOp:translate = (0, 0, 0)
 uniform token[] xformOpOrder = ["xformOp:translate"]
 bool physics:kinematicEnabled = true
 float physics:mass = 0.35
 float physxContactReport:threshold = 0
 bool physxRigidBody:enableCCD = true
 float physxRigidBody:linearDamping = 0.01
 float physxRigidBody:angularDamping = 0.001
 
def Mesh "stand" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]) {
 point3f[] points = [(-45, -45, -90), (45, -45, -90), (45, 45, -90), (-45, 45, -90), (-45, -45, 0), (45, -45, 0), (45, 45, 0), (-45, 45, 0)]
 int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
 int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
 uniform token subdivisionScheme = "none"
 token physics:approximation = "convexHull"
 float physxCollision:contactOffset = 0.00001
 float physxCollision:restOffset = 0
 double3 xformOp:scale = (0.001, 0.001, 0.001)
 uniform token[] xformOpOrder = ["xformOp:scale"]
 rel material:binding = </assembly/Materials/mount>
 }
