#usda 1.0
(
    defaultPrim = "calculator"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "calculator" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    bool physxArticulation:enabledSelfCollisions = 1

    def "Looks"
    {
        def Material "Purple" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </calculator/Looks/Purple/Surface.outputs:surface>
            float physics:dynamicFriction = 0.595
            float physics:restitution = 0
            float physics:staticFriction = 0.7

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.29, 0.052, 0.42)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

