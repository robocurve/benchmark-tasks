#usda 1.0
(
    defaultPrim = "tape"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "tape" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    customData = {
        string fidelity = "Physical case and hook; passive linear return spring; visual straight blade, no middle-blade contact or internal coil"
    }
)
{
    bool physxArticulation:enabledSelfCollisions = 1

    def "Looks"
    {
        def Material "Yellow" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </tape/Looks/Yellow/Surface.outputs:surface>
            float physics:dynamicFriction = 0.595
            float physics:restitution = 0
            float physics:staticFriction = 0.7

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.48, 0.015)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "Rubber" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </tape/Looks/Rubber/Surface.outputs:surface>
            float physics:dynamicFriction = 0.765
            float physics:restitution = 0
            float physics:staticFriction = 0.9

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.025, 0.027, 0.029)
                float inputs:metallic = 0
                float inputs:roughness = 0.75
                token outputs:surface
            }
        }

        def Material "Steel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </tape/Looks/Steel/Surface.outputs:surface>
            float physics:dynamicFriction = 0.595
            float physics:restitution = 0
            float physics:staticFriction = 0.7

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.58, 0.61, 0.65)
                float inputs:metallic = 0.85
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }

        def Material "MetricBlade" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </tape/Looks/MetricBlade/Surface.outputs:surface>
            float physics:dynamicFriction = 0.595
            float physics:restitution = 0
            float physics:staticFriction = 0.7

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 1)
                color3f inputs:diffuseColor.connect = </tape/Looks/MetricBlade/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/metric_blade.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </tape/Looks/MetricBlade/UV.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                color3f outputs:rgb
            }
        }
    }

    def Xform "case" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
    )
    {
        float physics:mass = 0.17
        bool physxRigidBody:enableCCD = 1
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

