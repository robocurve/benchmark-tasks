#usda 1.0
(
    defaultPrim = "panel"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "panel" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.12

    def "Looks"
    {
        def Material "black"
        {
            token outputs:surface.connect = </panel/Looks/black/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.055)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "groove"
        {
            token outputs:surface.connect = </panel/Looks/groove/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.015, 0.015, 0.017)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "clip"
        {
            token outputs:surface.connect = </panel/Looks/clip/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.82, 0.84)
                float inputs:metallic = 0
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }
    }

    def Cube "plate" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </panel/Looks/black>
        double size = 1
        float3 xformOp:scale = (0.006, 0.4826, 0.043)
        double3 xformOp:translate = (-0.003, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "groove_0" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </panel/Looks/groove>
        double size = 1
        float3 xformOp:scale = (0.0003, 0.34, 0.0022)
        double3 xformOp:translate = (-0.00615, 0, -0.015)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "groove_1" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </panel/Looks/groove>
        double size = 1
        float3 xformOp:scale = (0.0003, 0.34, 0.0022)
        double3 xformOp:translate = (-0.00615, 0, -0.01)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "groove_2" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </panel/Looks/groove>
        double size = 1
        float3 xformOp:scale = (0.0003, 0.34, 0.0022)
        double3 xformOp:translate = (-0.00615, 0, -0.005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "groove_3" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </panel/Looks/groove>
        double size = 1
        float3 xformOp:scale = (0.0003, 0.34, 0.0022)
        double3 xformOp:translate = (-0.00615, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "groove_4" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </panel/Looks/groove>
        double size = 1
        float3 xformOp:scale = (0.0003, 0.34, 0.0022)
        double3 xformOp:translate = (-0.00615, 0, 0.005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "groove_5" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </panel/Looks/groove>
        double size = 1
        float3 xformOp:scale = (0.0003, 0.34, 0.0022)
        double3 xformOp:translate = (-0.00615, 0, 0.01)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "groove_6" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </panel/Looks/groove>
        double size = 1
        float3 xformOp:scale = (0.0003, 0.34, 0.0022)
        double3 xformOp:translate = (-0.00615, 0, 0.015)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "left_clip" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </panel/Looks/clip>
        double size = 1
        float3 xformOp:scale = (0.009, 0.008, 0.008)
        double3 xformOp:translate = (0.0045000000000000005, 0.2325, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Mesh "left_clip_tip" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
    )
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
        rel material:binding = </panel/Looks/clip>
        uniform token physics:approximation = "convexHull"
        point3f[] points = [(0.009, 0.2285, -0.004), (0.009, 0.2365, -0.004), (0.009, 0.2365, 0.004), (0.009, 0.2285, 0.004), (0.012, 0.23, -0.0025), (0.012, 0.235, -0.0025), (0.012, 0.235, 0.0025), (0.012, 0.23, 0.0025)]
        uniform token subdivisionScheme = "none"
    }

    def Cube "right_clip" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </panel/Looks/clip>
        double size = 1
        float3 xformOp:scale = (0.009, 0.008, 0.008)
        double3 xformOp:translate = (0.0045000000000000005, -0.2325, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Mesh "right_clip_tip" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
    )
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
        rel material:binding = </panel/Looks/clip>
        uniform token physics:approximation = "convexHull"
        point3f[] points = [(0.009, -0.2365, -0.004), (0.009, -0.2285, -0.004), (0.009, -0.2285, 0.004), (0.009, -0.2365, 0.004), (0.012, -0.235, -0.0025), (0.012, -0.23, -0.0025), (0.012, -0.23, 0.0025), (0.012, -0.235, 0.0025)]
