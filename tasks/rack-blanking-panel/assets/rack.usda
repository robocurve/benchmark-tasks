#usda 1.0
(
    defaultPrim = "rack"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "rack" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
)
{
    def "Looks"
    {
        def Material "post"
        {
            token outputs:surface.connect = </rack/Looks/post/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.21, 0.23)
                float inputs:metallic = 0.3
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "inside"
        {
            token outputs:surface.connect = </rack/Looks/inside/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.03, 0.03, 0.035)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "strip"
        {
            token outputs:surface.connect = </rack/Looks/strip/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </rack/Looks/strip/texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/post_strip.png@
                float2 inputs:st.connect = </rack/Looks/strip/st.outputs:result>
                float3 outputs:rgb
            }
        }

        def Material "server"
        {
            token outputs:surface.connect = </rack/Looks/server/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </rack/Looks/server/texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/server.png@
                float2 inputs:st.connect = </rack/Looks/server/st.outputs:result>
                float3 outputs:rgb
            }
        }

        def Material "server_body"
        {
            token outputs:surface.connect = </rack/Looks/server_body/surface.outputs:surface>

            def Shader "surface"
            {
