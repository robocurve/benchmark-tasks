#usda 1.0
(
    defaultPrim = "hose"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "hose"
{
    def "Looks"
    {
        def Material "hose"
        {
            token outputs:surface.connect = </hose/Looks/hose/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.45, 0.2)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "clamp"
        {
            token outputs:surface.connect = </hose/Looks/clamp/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.45, 0.46, 0.48)
                float inputs:metallic = 0.6
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "brass"
        {
            token outputs:surface.connect = </hose/Looks/brass/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.6, 0.26)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "boot"
        {
            token outputs:surface.connect = </hose/Looks/boot/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.1, 0.11)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }
    }

    def Xform "clamp" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        float physics:mass = 0.3
        custom bool physxArticulation:enabledSelfCollisions = 0
        custom float physxArticulation:sleepThreshold = 0
        custom float physxArticulation:stabilizationThreshold = 0
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Xform "block"
        {
            double3 xformOp:translate = (-0.01, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "shape" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                rel material:binding = </hose/Looks/clamp>
                custom float physxCollision:contactOffset = 0.0008
                custom float physxCollision:restOffset = 0
                double size = 1
                float3 xformOp:scale = (0.03, 0.05, 0.031)
                uniform token[] xformOpOrder = ["xformOp:scale"]
            }
        }
    }

    def Xform "h00" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.012
        float xformOp:rotateZ = -20
        double3 xformOp:translate = (0.005, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

        def Capsule "tube" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            uniform token axis = "X"
            double height = 0.026
            rel material:binding = </hose/Looks/hose>
            custom float physxCollision:contactOffset = 0.0008
            custom float physxCollision:restOffset = 0
            double radius = 0.0115
            double3 xformOp:translate = (0.0225, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

