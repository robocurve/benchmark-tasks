#usda 1.0
(
    defaultPrim = "coupler"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "coupler"
{
    def "Looks"
    {
        def Material "brass"
        {
            token outputs:surface.connect = </coupler/Looks/brass/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.6, 0.26)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "steel"
        {
            token outputs:surface.connect = </coupler/Looks/steel/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.72, 0.75)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "black"
        {
            token outputs:surface.connect = </coupler/Looks/black/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.1, 0.11)
                float inputs:metallic = 0.3
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "red"
        {
            token outputs:surface.connect = </coupler/Looks/red/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.08, 0.06)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "greased" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.1
            float physics:restitution = 0
            float physics:staticFriction = 0.1
            custom token physxMaterial:frictionCombineMode = "min"
        }
    }

