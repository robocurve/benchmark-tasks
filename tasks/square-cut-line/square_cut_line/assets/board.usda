#usda 1.0
(
    defaultPrim = "Board"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Board" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"])
{
    bool physics:rigidBodyEnabled = true
    bool physics:kinematicEnabled = true
    float physics:mass = 1.0
    float physxRigidBody:maxDepenetrationVelocity = 1
    int physxRigidBody:solverPositionIterationCount = 16
    int physxRigidBody:solverVelocityIterationCount = 4
    def Cube "Wood" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"])
    {
        double size = 1
        double3 xformOp:translate = (0, 0, 0)
        double3 xformOp:scale = (0.14, 0.28, 0.016)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.62, 0.42, 0.22)]
        float physxCollision:contactOffset = 0.001
        float physxCollision:restOffset = 0
    }
}
