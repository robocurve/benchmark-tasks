#usda 1.0
(
    defaultPrim = "Holder"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Holder" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    point3f physics:centerOfMass = (0, 0, 0.07)
    float3 physics:diagonalInertia = (0.0008, 0.0008, 0.0003)
    float physics:mass = 0.45

    def "Looks"
    {
        def Material "polymer" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Holder/Looks/polymer/surface.outputs:surface>
            float physics:dynamicFriction = 0.52
            float physics:restitution = 0
            float physics:staticFriction = 0.65

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.18, 0.28, 0.34)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }
    }

    def Cube "floor" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </Holder/Looks/polymer>
        rel material:binding:physics = </Holder/Looks/polymer>
        custom float physxCollision:contactOffset = 0.00025
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.065, 0.065, 0.006)
        double3 xformOp:translate = (0, 0, 0.003)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

