    def Cylinder "foot_0_0" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.004
        rel material:binding = </stand/Looks/rubber>
        rel material:binding:physics = </stand/Looks/rubber>
