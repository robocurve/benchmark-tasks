#usda 1.0
(
    defaultPrim = "stand"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "stand" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    customData = {
        string asset_description = "Free iron stand; threaded upright fixed to heavy base."
    }
)
{
    point3f physics:centerOfMass = (0, 0.01, 0.031)
    float3 physics:diagonalInertia = (0.014, 0.009, 0.016)
    float physics:mass = 2

    def "Looks"
    {
        def Material "paint" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </stand/Looks/paint/surface.outputs:surface>
            float physics:dynamicFriction = 0.56
            float physics:restitution = 0
            float physics:staticFriction = 0.7

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.038, 0.043, 0.05)
                float inputs:metallic = 0.35
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }

        def Material "steel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </stand/Looks/steel/surface.outputs:surface>
            float physics:dynamicFriction = 0.44
            float physics:restitution = 0
            float physics:staticFriction = 0.55

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.47, 0.5, 0.53)
                float inputs:metallic = 0.92
                float inputs:roughness = 0.22
                token outputs:surface
            }
        }

        def Material "rubber" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </stand/Looks/rubber/surface.outputs:surface>
            float physics:dynamicFriction = 0.88
            float physics:restitution = 0
            float physics:staticFriction = 1.1

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.021, 0.024, 0.026)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
    }

    def Mesh "plate" (
