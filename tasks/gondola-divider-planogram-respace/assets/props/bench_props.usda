{
    def Xform "barcode_scanner"
    {
        float xformOp:rotateX = 0
        float xformOp:rotateY = 0
        float xformOp:rotateZ:yaw = 200
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.6582145776223843, 0.38330066290867815, -7.27596455307733e-11)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ:yaw", "xformOp:rotateY", "xformOp:rotateX", "xformOp:scale"]

        def Xform "model" (
            prepend references = @./barcode_scanner/barcode_scanner.usdc@
        )
