    def Xform "prong_p" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Cotter/prong_p/Material> (
            bindMaterialAs = "weakerThanDescendants"
        )
        point3f physics:centerOfMass = (0.005555, 0.000725, 0)
        float3 physics:diagonalInertia = (8e-9, 8e-9, 8e-9)
        float physics:mass = 0.0002

        def Cylinder "visual"
