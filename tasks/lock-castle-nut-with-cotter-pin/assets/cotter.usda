        custom float cotter:plastic_moment = 0.044803284
        float drive:angular:physics:damping = 0.000044803284
        float drive:angular:physics:stiffness = 0.022401642
        float drive:angular:physics:targetPosition = 0
        uniform token drive:angular:physics:type = "force"
        uniform token physics:axis = "Z"
        rel physics:body0 = </Cotter>
        rel physics:body1 = </Cotter/prong_p>
        point3f physics:localPos0 = (0, 0.000725, 0)
        point3f physics:localPos1 = (0, 0.000725, 0)
        float physics:lowerLimit = -2
