#usda 1.0
(
    defaultPrim = "apple_watch"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "apple_watch"
{
    def "Looks"
    {
        def Material "physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.65
        }

        def Material "white"
        {
            token outputs:surface.connect = </apple_watch/Looks/white/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.88, 0.89, 0.9)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "black"
        {
            token outputs:surface.connect = </apple_watch/Looks/black/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.009, 0.012, 0.016)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "silver"
        {
            token outputs:surface.connect = </apple_watch/Looks/silver/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.58, 0.6)
                float inputs:metallic = 0.7
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }

        def Material "blue"
        {
            token outputs:surface.connect = </apple_watch/Looks/blue/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4, 0.51, 0.63)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "band"
        {
            token outputs:surface.connect = </apple_watch/Looks/band/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.018, 0.035, 0.05)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "sensor"
        {
            token outputs:surface.connect = </apple_watch/Looks/sensor/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.025, 0.03, 0.025)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "seam"
        {
            token outputs:surface.connect = </apple_watch/Looks/seam/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.35, 0.37, 0.39)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "display"
        {
            token outputs:surface.connect = </apple_watch/Looks/display/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.015, 0.015, 0.015)
                color3f inputs:emissiveColor.connect = </apple_watch/Looks/display/texture.outputs:rgb>
                float inputs:roughness = 0.45
                token outputs:surface
            }

            def Shader "uv"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./apple_watch_screen.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </apple_watch/Looks/display/uv.outputs:result>
                color3f outputs:rgb
            }
        }

        def Material "charge_light"
        {
            token outputs:surface.connect = </apple_watch/Looks/charge_light/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.015, 0.85, 0.1)
                color3f inputs:emissiveColor = (0.0225, 1.275, 0.15)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }
    }

