#usda 1.0
(
    defaultPrim = "DesiccantPacket"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "DesiccantPacket" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
    customData = {
        string assetDescription = "Sealed padded silica-gel sachet, 55 x 34 x 12 mm; rigid paper-pouch surrogate with readable standard packaging warning."
    }
)
{
    rel material:binding:physics = </DesiccantPacket/PhysicsMaterial>
    point3f physics:centerOfMass = (0, 0, 0.006)
    float3 physics:diagonalInertia = (8.6666665e-7, 0.0000021126666, 0.0000027873334)
    float physics:mass = 0.008
    bool physics:rigidBodyEnabled = 1
    custom int physxRigidBody:solverPositionIterationCount = 32
    custom int physxRigidBody:solverVelocityIterationCount = 8

    def "Looks"
    {
        def Material "Paper"
        {
            token outputs:surface.connect = </DesiccantPacket/Looks/Paper/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9114075, 0.8688994, 0.7293471)
                float inputs:metallic = 0
                float inputs:roughness = 0.86
                token outputs:surface
            }
        }

        def Material "Seam"
        {
            token outputs:surface.connect = </DesiccantPacket/Looks/Seam/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.67385954, 0.5704816, 0.39312312)
                float inputs:metallic = 0
                float inputs:roughness = 0.91
                token outputs:surface
            }
        }

        def Material "Print"
        {
            token outputs:surface.connect = </DesiccantPacket/Looks/Print/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 1)
                color3f inputs:diffuseColor.connect = </DesiccantPacket/Looks/Print/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.88
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/packet_label.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </DesiccantPacket/Looks/Print/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }
    }

