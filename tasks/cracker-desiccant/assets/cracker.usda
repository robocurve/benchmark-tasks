#usda 1.0
(
    defaultPrim = "Cracker"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Cracker" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
)
{
    rel material:binding:physics = </Cracker/PhysicsMaterial>
    point3f physics:centerOfMass = (0, 0, 0.0035)
    float3 physics:diagonalInertia = (9.065e-7, 9.065e-7, 0.000001764)
    float physics:mass = 0.006
    bool physics:rigidBodyEnabled = 1
    custom int physxRigidBody:solverPositionIterationCount = 32
    custom int physxRigidBody:solverVelocityIterationCount = 8

    def "Looks"
    {
        def Material "Baked"
        {
            token outputs:surface.connect = </Cracker/Looks/Baked/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6920711, 0.36724648, 0.09462962)
                float inputs:metallic = 0
                float inputs:roughness = 0.88
                token outputs:surface
            }
        }

        def Material "Top"
        {
            token outputs:surface.connect = </Cracker/Looks/Top/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 1)
                color3f inputs:diffuseColor.connect = </Cracker/Looks/Top/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.93
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/cracker.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Cracker/Looks/Top/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }
    }

