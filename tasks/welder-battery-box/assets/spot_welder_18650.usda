#usda 1.0
(
    defaultPrim = "SpotWelder"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "SpotWelder" (
    "Mini 18650 spot welder, 124 x 24 x 22 mm housing + 15 mm probes, USB-C at the rear end. Origin: rear end, bottom of the housing (feet 0.5 mm below), centre. +X toward the probes, +Z = top (lid side). Bodies: Body, Lid (hinged, spring opens it), Slider (latch), Battery_18650."
)
{
    def Scope "Looks"
    {
        def Material "Phys_Copper" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:restitution = 0
            float physics:staticFriction = 0.35
        }

        def Material "Phys_ABS" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.4
        }

        def Material "Phys_Rubber" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0
            float physics:staticFriction = 0.9
        }

        def Material "Phys_POM" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.2
            float physics:restitution = 0
            float physics:staticFriction = 0.2
        }

        def Material "Phys_Nickel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.25
            float physics:restitution = 0
            float physics:staticFriction = 0.3
        }

        def Material "Phys_Steel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.2
            float physics:restitution = 0
            float physics:staticFriction = 0.25
        }

        def Material "Plastic_Housing"
        {
            token outputs:surface.connect = </SpotWelder/Looks/Plastic_Housing/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.02, 0.02, 0.022)
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </SpotWelder/Looks/Plastic_Housing/NormalTexture.outputs:rgb>
                float inputs:roughness.connect = </SpotWelder/Looks/Plastic_Housing/RoughnessTexture.outputs:r>
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "RoughnessTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/plastic_grain_roughness.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </SpotWelder/Looks/Plastic_Housing/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }

            def Shader "NormalTexture"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-0.45, -0.45, -1, 0)
                asset inputs:file = @./textures/plastic_grain_normal.png@
                float4 inputs:scale = (0.9, 0.9, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </SpotWelder/Looks/Plastic_Housing/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "USB_Shell_Steel"
        {
