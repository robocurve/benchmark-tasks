    def Xform "Body" (
        "Plastic housing with electronics, probes, feet. Grip the long flat sides."
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0.069677114, 8.6523573e-7, 0.009717545)
