#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Z"
)
def Xform "Asset"
{
    def Xform "gauge" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 0.038
        float3 physics:diagonalInertia = (1e-05, 1.04e-05, 4.3e-06)
        def Cube "GaugeBlock" (
            prepend apiSchemas = ["PhysxCollisionAPI", "PhysicsCollisionAPI"]
        )
        {
        float physxCollision:contactOffset = 0.00047
        float physxCollision:restOffset = 0
            double size = 1
            double3 xformOp:translate = (0, 0, 0.012)
            float3 xformOp:scale = (0.026, 0.022, 0.024)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.04, 0.38, 0.62)]
        }
        def Cube "GraspHead" (
            prepend apiSchemas = ["PhysxCollisionAPI", "PhysicsCollisionAPI"]
        )
        {
        float physxCollision:contactOffset = 0.00047
        float physxCollision:restOffset = 0
            double size = 1
            double3 xformOp:translate = (0, 0, 0.031)
            float3 xformOp:scale = (0.024, 0.022, 0.02)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.04, 0.38, 0.62)]
        }
    }
}
