    def "Looks"
    {
        def Material "Wood"
        {
            token outputs:surface.connect = </Spatula/Looks/Wood/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Spatula/Looks/Wood/alb.outputs:rgb>
                float inputs:ior = 1.5
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </Spatula/Looks/Wood/nor.outputs:rgb>
                float inputs:roughness = 0.6
                float inputs:roughness.connect = </Spatula/Looks/Wood/orm.outputs:g>
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "alb"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/wood-alb.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Spatula/Looks/Wood/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "nor"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, 0)
                asset inputs:file = @textures/wood-nor.png@
                float4 inputs:scale = (2, 2, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Spatula/Looks/Wood/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "orm"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/wood-orm.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Spatula/Looks/Wood/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:g
            }
        }
    }

    def Material "PhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.5
        float physics:restitution = 0.4
        float physics:staticFriction = 0.5
    }

