    def Scope "Looks"
    {
        def Material "black"
        {
            token outputs:surface.connect = </Pan/Looks/black/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.025, 0.025, 0.03)
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }
        def Material "steel"
        {
            token outputs:surface.connect = </Pan/Looks/steel/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.9
                color3f inputs:diffuseColor = (0.38, 0.4, 0.42)
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
    }

