#usda 1.0
(
    defaultPrim = "Knob"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Knob" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    float physics:mass = 1.0000
    int physxRigidBody:solverPositionIterationCount = 32
    int physxRigidBody:solverVelocityIterationCount = 4
    float physxRigidBody:maxDepenetrationVelocity = 1

    def Material "PhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:staticFriction = 0.6000
        float physics:dynamicFriction = 0.5000
        float physics:restitution = 0
    }

    def Cylinder "mount_col" (prepend apiSchemas=["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]) {
 rel material:binding:physics=</Knob/PhysicsMaterial>
 uniform token purpose="guide"
 double radius=0.031
 double height=0.01
 uniform token axis="Z"
 double3 xformOp:translate=(0,0,0.005)
 uniform token[] xformOpOrder=["xformOp:translate"]
 float physxCollision:contactOffset=.004
 float physxCollision:restOffset=0
 }


    def Scope "Looks"
    {
        def Material "green"
        {
            token outputs:surface.connect = </Knob/Looks/green/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.03, 0.4, 0.04)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
        def Material "panel"
        {
            token outputs:surface.connect = </Knob/Looks/panel/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.5
                color3f inputs:diffuseColor.connect = </Knob/Looks/panel/color_tex.outputs:rgb>
                float inputs:roughness = 0.4
                token outputs:surface
            }
            def Shader "uv"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "color_tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/knob-panel.png@
                float2 inputs:st.connect = </Knob/Looks/panel/uv.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                token inputs:sourceColorSpace = "sRGB"
                float4 inputs:scale = (1, 1, 1, 1)
                float3 outputs:rgb
            }
        }
        def Material "steel"
        {
            token outputs:surface.connect = </Knob/Looks/steel/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.9
                color3f inputs:diffuseColor = (0.38, 0.4, 0.42)
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
        def Material "white"
        {
            token outputs:surface.connect = </Knob/Looks/white/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.85, 0.85, 0.8)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

    def Xform "visual"
