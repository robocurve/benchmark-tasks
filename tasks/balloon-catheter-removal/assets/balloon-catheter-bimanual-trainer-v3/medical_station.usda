#usda 1.0
(
    defaultPrim = "MedicalStation"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "MedicalStation"
{
    double3 xformOp:translate = (0, 0.1, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def "Looks"
    {
        def Material "white"
        {
            token outputs:surface.connect = </MedicalStation/Looks/white/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8688994, 0.9114075, 0.84808826)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "teal"
        {
            token outputs:surface.connect = </MedicalStation/Looks/teal/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.010022826, 0.17064494, 0.18731667)
                float inputs:metallic = 0
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }

        def Material "glass"
        {
            token outputs:surface.connect = </MedicalStation/Looks/glass/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4064483, 0.71056646, 0.8073459)
                float inputs:metallic = 0
                float inputs:opacity = 0.23
                float inputs:roughness = 0.16
                token outputs:surface
            }
        }

        def Material "blue"
        {
            token outputs:surface.connect = </MedicalStation/Looks/blue/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.027211782, 0.1788675, 0.6382832)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "balloon"
        {
            token outputs:surface.connect = </MedicalStation/Looks/balloon/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9114075, 0.36724648, 0.039681908)
                float inputs:metallic = 0
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "silicone"
        {
            token outputs:surface.connect = </MedicalStation/Looks/silicone/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7484141, 0.5704816, 0.33034372)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "steel"
        {
            token outputs:surface.connect = </MedicalStation/Looks/steel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.38005632, 0.4769998, 0.52252156)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.24
                token outputs:surface
            }
        }

        def Material "ink"
        {
            token outputs:surface.connect = </MedicalStation/Looks/ink/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.008540382, 0.021980947, 0.027211782)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "rubber"
        {
            token outputs:surface.connect = </MedicalStation/Looks/rubber/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.021980947, 0.039681908, 0.043233637)
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "fluid"
        {
            token outputs:surface.connect = </MedicalStation/Looks/fluid/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.93310684, 0.67385954, 0.10653923)
                float inputs:metallic = 0
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }
    }

    def "Phantom"
    {
        def Cube "Base" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </MedicalStation/Looks/teal>
            custom float physxCollision:contactOffset = 0.001
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.183, 0.185, 0.009)
            double3 xformOp:translate = (0.375, 0.018, 0.794)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Support0" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
