#usda 1.0
(
    defaultPrim = "InstrumentRests"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "InstrumentRests"
{
    def Material "Polymer"
    {
        token outputs:surface.connect = </InstrumentRests/Polymer/Shader.outputs:surface>

        def Shader "Shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.68, 0.76, 0.75)
            float inputs:roughness = 0.65
            token outputs:surface
        }
    }

    def Cube "ValveFoot" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </InstrumentRests/Polymer>
        custom float physxCollision:contactOffset = 0.0003
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.045, 0.035, 0.006)
        double3 xformOp:translate = (0.336, -0.124, 0.768)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "ValveStem" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
