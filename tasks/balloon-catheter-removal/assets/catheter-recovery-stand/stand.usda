#usda 1.0
(
    defaultPrim = "RecoveryStand"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "RecoveryStand"
{
    def Cube "Plinth" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </RecoveryStand/Material>
        double size = 1
        float3 xformOp:scale = (0.1, 0.14, 0.0675)
        double3 xformOp:translate = (0, 0, 0.03375)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Material "Material"
    {
        token outputs:surface.connect = </RecoveryStand/Material/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.52, 0.58, 0.57)
            float inputs:roughness = 0.8
            token outputs:surface
        }
    }
}

