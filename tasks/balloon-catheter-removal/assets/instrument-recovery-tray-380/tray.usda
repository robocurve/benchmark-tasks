#usda 1.0
(defaultPrim="RecoveryTray"
 metersPerUnit=1
 upAxis="Z")
def Xform "RecoveryTray" {
 def Scope "Looks" {
  def Material "Steel" {
   token outputs:surface.connect=</RecoveryTray/Looks/Steel/Shader.outputs:surface>
   def Shader "Shader" {
    uniform token info:id="UsdPreviewSurface"
    color3f inputs:diffuseColor=(0.62,0.65,0.67)
    float inputs:metallic=0.8
    float inputs:roughness=0.28
    token outputs:surface
   }
  }
  def Material "Polypropylene" {
   token outputs:surface.connect=</RecoveryTray/Looks/Polypropylene/Shader.outputs:surface>
   def Shader "Shader" {
    uniform token info:id="UsdPreviewSurface"
    color3f inputs:diffuseColor=(0.77,0.79,0.78)
    float inputs:roughness=0.55
    token outputs:surface
   }
  }
 }
 def Cube "Riser" (prepend apiSchemas=["PhysicsCollisionAPI","PhysxCollisionAPI","MaterialBindingAPI"]) {
  double size=1
  double3 xformOp:translate=(0, 0, 0.033)
  double3 xformOp:scale=(0.1, 0.14, 0.066)
  uniform token[] xformOpOrder=["xformOp:translate","xformOp:scale"]
  bool physics:collisionEnabled=true
  float physxCollision:contactOffset=0.0005
  float physxCollision:restOffset=0
  rel material:binding=</RecoveryTray/Looks/Polypropylene>
 }
 def Cube "Floor" (prepend apiSchemas=["PhysicsCollisionAPI","PhysxCollisionAPI","MaterialBindingAPI"]) {
  double size=1
  double3 xformOp:translate=(0, 0, 0.06675)
  double3 xformOp:scale=(0.18, 0.38, 0.0015)
  uniform token[] xformOpOrder=["xformOp:translate","xformOp:scale"]
  bool physics:collisionEnabled=true
  float physxCollision:contactOffset=0.0005
  float physxCollision:restOffset=0
  rel material:binding=</RecoveryTray/Looks/Steel>
 }
 def Cube "SideLeft" (prepend apiSchemas=["PhysicsCollisionAPI","PhysxCollisionAPI","MaterialBindingAPI"]) {
  double size=1
  double3 xformOp:translate=(-0.089, 0, 0.0765)
  double3 xformOp:scale=(0.002, 0.38, 0.018)
  uniform token[] xformOpOrder=["xformOp:translate","xformOp:scale"]
  bool physics:collisionEnabled=true
