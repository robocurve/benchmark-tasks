 }
 def Cube "EndRear" (prepend apiSchemas=["PhysicsCollisionAPI","PhysxCollisionAPI","MaterialBindingAPI"]) {
  double size=1
  double3 xformOp:translate=(0, -0.189, 0.0765)
  double3 xformOp:scale=(0.176, 0.002, 0.018)
  uniform token[] xformOpOrder=["xformOp:translate","xformOp:scale"]
