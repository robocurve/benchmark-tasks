#usda 1.0
(
    defaultPrim = "InstrumentRests"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "InstrumentRests" (
    prepend references = @assets/catheter-staging-rests-v2/rests.usda@</InstrumentRests>
)
{
    over "ValveFoot"
    {
        float xformOp:rotateZ = -35
        double3 xformOp:translate = (0.3476416817635377, -0.10307730262799727, 0.768)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]
    }

    over "ValveStem"
    {
        float xformOp:rotateZ = -35
        double3 xformOp:translate = (0.35493213495770976, -0.10818213291152158, 0.80575)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]
    }

    over "ValveTop"
    {
        float xformOp:rotateZ = -35
        double3 xformOp:translate = (0.35493213495770976, -0.10818213291152158, 0.8435)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]
    }
}

