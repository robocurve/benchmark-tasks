#usda 1.0
(
    defaultPrim = "MedicalStation"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "MedicalStation" (
    prepend references = @assets/balloon-catheter-bimanual-trainer-v3/medical_station.usda@</MedicalStation>
)
{
    over "RecoveryDish" (
        active = false
    )
    {
    }

    over "Valve"
    {
        float xformOp:rotateZ = -35
        double3 xformOp:translate = (0.339038035218272, -0.21536458329233216, 0.851)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
    }

    over "SyringePad"
    {
        double3 xformOp:translate = (0.30000000000000004, 0.20800000000000002, 0.782)
    }

    over "SyringeCradle"
    {
        over "S0"
        {
            double3 xformOp:translate = (0.259, 0.2, 0.797)
        }

        over "S1"
        {
            double3 xformOp:translate = (0.339, 0.2, 0.797)
        }
    }

    over "Syringe"
    {
        over "Barrel"
        {
            double3 xformOp:translate = (0.30000000000000004, 0.2, 0.82)
        }

        over "Plunger"
        {
            double3 xformOp:translate = (0.30000000000000004, 0.2, 0.82)
        }
    }
}

