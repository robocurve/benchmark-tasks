        }
        over "J_09" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:armature = 2e-7
        }
        over "J_10" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:armature = 2e-7
        }
        over "J_11" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:armature = 2e-7
        }
        over "J_12" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:armature = 2e-7
        }
        over "J_13" (
