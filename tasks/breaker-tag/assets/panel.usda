#usda 1.0
(
    defaultPrim = "panel"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "panel" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 1
    custom float physxArticulation:sleepThreshold = 0
    custom float physxArticulation:stabilizationThreshold = 0

    def "Looks"
    {
        def Material "wall"
        {
            token outputs:surface.connect = </panel/Looks/wall/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.838799, 0.82278574, 0.7758222)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "pine"
        {
            token outputs:surface.connect = </panel/Looks/pine/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.67244315, 0.4677838, 0.23839757)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "steel"
        {
            token outputs:surface.connect = </panel/Looks/steel/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.18782078, 0.19461784, 0.20863687)
                float inputs:metallic = 0.6
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "grey"
        {
            token outputs:surface.connect = </panel/Looks/grey/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.40197778, 0.4125426, 0.4125426)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "atlas"
        {
            token outputs:surface.connect = </panel/Looks/atlas/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </panel/Looks/atlas/texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/bt_atlas_2.png@
                float2 inputs:st.connect = </panel/Looks/atlas/st.outputs:result>
                float3 outputs:rgb
            }
        }

        def Material "handle"
        {
            token outputs:surface.connect = </panel/Looks/handle/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.008023193, 0.008023193, 0.009134059)
                float inputs:metallic = 0
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "brass"
        {
            token outputs:surface.connect = </panel/Looks/brass/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55201143, 0.3515326, 0.08437621)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "tie"
        {
            token outputs:surface.connect = </panel/Looks/tie/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.80695224, 0.80695224, 0.7605245)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "tag_edge"
        {
            token outputs:surface.connect = </panel/Looks/tag_edge/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.92158186, 0.92158186, 0.8879231)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "phone"
        {
            token outputs:surface.connect = </panel/Looks/phone/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.009134059, 0.009134059, 0.011612245)
                float inputs:metallic = 0
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "neck"
        {
            token outputs:surface.connect = </panel/Looks/neck/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.02121901, 0.02121901, 0.02518686)
                float inputs:metallic = 0.4
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

    def Xform "base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsFilteredPairsAPI"]
    )
    {
        rel physics:filteredPairs = [
            </panel/h1>,
            </panel/h2>,
            </panel/h3>,
            </panel/h4>,
            </panel/h5>,
            </panel/h6>,
            </panel/h7>,
            </panel/h8>,
        ]
        float physics:mass = 20
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "wall" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </panel/Looks/wall>
            custom float physxCollision:contactOffset = 0.001
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.019, 1.22, 0.61)
            double3 xformOp:translate = (0.4395, 0, 0.305)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

