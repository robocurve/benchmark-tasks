    def Material "OrderInk"
    {
        token outputs:surface.connect = </Trainer/OrderInk/surface.outputs:surface>

        def Shader "surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </Trainer/OrderInk/texture.outputs:rgb>
            token outputs:surface
        }

        def Shader "texture"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @order.png@
            float2 inputs:st.connect = </Trainer/OrderInk/coords.outputs:result>
            color3f outputs:rgb
        }

        def Shader "coords"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            token inputs:varname = "st"
            float2 outputs:result
        }
    }

    def PhysicsPrismaticJoint "slide"
    {
        uniform token physics:axis = "Z"
        rel physics:body0 = </Trainer/mast>
        rel physics:body1 = </Trainer/carriage>
        point3f physics:localPos0 = (0.36, 0, 1.06)
        point3f physics:localPos1 = (0, 0, 0)
        float physics:lowerLimit = -0.15
        float physics:upperLimit = 0.03
    }

    def PhysicsPrismaticJoint "brakeSlide" (
        prepend apiSchemas = ["PhysicsDriveAPI:linear"]
    )
    {
        float drive:linear:physics:damping = 3
        float drive:linear:physics:stiffness = 550
        float drive:linear:physics:targetPosition = -0.002
        uniform token physics:axis = "X"
        rel physics:body0 = </Trainer/carriage>
        rel physics:body1 = </Trainer/brake>
        point3f physics:localPos0 = (0, -0.065, 0.045)
        point3f physics:localPos1 = (0, 0, 0)
        float physics:lowerLimit = 0
        float physics:upperLimit = 0.008
    }

    def PhysicsRevoluteJoint "tapHinge" (
        prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI"]
    )
    {
        float drive:angular:physics:damping = 0.00025
        float drive:angular:physics:maxForce = 0.035
        float drive:angular:physics:stiffness = 0.006
        float drive:angular:physics:targetPosition = 0
        uniform token physics:axis = "X"
        rel physics:body0 = </Trainer/carriage>
        rel physics:body1 = </Trainer/tap>
        point3f physics:localPos0 = (-0.015, -0.085, -0.05)
        point3f physics:localPos1 = (0, 0, 0)
        float physics:lowerLimit = -90
        float physics:upperLimit = 0
        custom float physxJoint:jointFriction = 0.4
    }
}

