#usda 1.0
(
    defaultPrim = "stand"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "stand" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    bool physics:kinematicEnabled = 1
    float physics:mass = 0.03
    custom int physxRigidBody:solverPositionIterationCount = 16
    custom int physxRigidBody:solverVelocityIterationCount = 4

    def Material "pla" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.4
        float physics:restitution = 0
        float physics:staticFriction = 0.4
    }

    def Cube "ya" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </stand/pla> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.0005
        custom float physxCollision:restOffset = 0
        color3f[] primvars:displayColor = [(0.3, 0.3, 0.32)]
        double size = 1
        float3 xformOp:scale = (0.03, 0.018, 0.012)
        double3 xformOp:translate = (0, 0.018, 0.006)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "yb" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </stand/pla> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.0005
        custom float physxCollision:restOffset = 0
        color3f[] primvars:displayColor = [(0.3, 0.3, 0.32)]
        double size = 1
        float3 xformOp:scale = (0.03, 0.018, 0.012)
        double3 xformOp:translate = (0, -0.018, 0.006)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "xa" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </stand/pla> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.0005
        custom float physxCollision:restOffset = 0
        color3f[] primvars:displayColor = [(0.3, 0.3, 0.32)]
        double size = 1
        float3 xformOp:scale = (0.007, 0.018, 0.012)
        double3 xformOp:translate = (0.0115, 0, 0.006)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "xb" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </stand/pla> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.0005
        custom float physxCollision:restOffset = 0
        color3f[] primvars:displayColor = [(0.3, 0.3, 0.32)]
        double size = 1
        float3 xformOp:scale = (0.007, 0.018, 0.012)
        double3 xformOp:translate = (-0.0115, 0, 0.006)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

