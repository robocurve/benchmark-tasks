#usda 1.0
(
    defaultPrim = "wafer"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "wafer" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    float physics:mass = 0.0013170158
    custom float physxRigidBody:maxDepenetrationVelocity = 0.02
    custom int physxRigidBody:solverPositionIterationCount = 64
    custom int physxRigidBody:solverVelocityIterationCount = 16

    def Material "si" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.3
        float physics:restitution = 0
        float physics:staticFriction = 0.3
    }

    def Cylinder "disc" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        uniform token axis = "Y"
        double height = 0.0005
        rel material:binding:physics = </wafer/si> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.0004
        custom float physxCollision:restOffset = 0
        color3f[] primvars:displayColor = [(0.42, 0.44, 0.55)]
        double radius = 0.0254
    }
}

