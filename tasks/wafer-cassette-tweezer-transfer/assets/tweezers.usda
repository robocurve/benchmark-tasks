#usda 1.0
(
    defaultPrim = "tweezers"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "tweezers" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 0
    custom int physxArticulation:solverPositionIterationCount = 32
    custom int physxArticulation:solverVelocityIterationCount = 8

    def Material "tips" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.5
        float physics:restitution = 0
        float physics:staticFriction = 0.5
    }

    def Xform "half_a" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
    )
    {
        float physics:mass = 0.007
        custom float physxRigidBody:maxDepenetrationVelocity = 0.02
        custom int physxRigidBody:solverPositionIterationCount = 32
        custom int physxRigidBody:solverVelocityIterationCount = 8

        def Cube "body" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </tweezers/tips> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.0005
            custom float physxCollision:restOffset = 0
            color3f[] primvars:displayColor = [(0.6, 0.62, 0.66)]
            double size = 1
            float3 xformOp:scale = (0.0015, 0.006, 0.1245)
            double3 xformOp:translate = (-0.0022500000000000003, 0, -0.06225000000000001)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "tip" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </tweezers/tips> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.0005
            custom float physxCollision:restOffset = 0
            color3f[] primvars:displayColor = [(0.15, 0.15, 0.15)]
            double size = 1
            float3 xformOp:scale = (0.0007, 0.006, 0.012)
            double3 xformOp:translate = (-0.00185, 0, -0.1305)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Xform "half_b" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
    )
    {
        float physics:mass = 0.007
        custom float physxRigidBody:maxDepenetrationVelocity = 0.02
        custom int physxRigidBody:solverPositionIterationCount = 32
        custom int physxRigidBody:solverVelocityIterationCount = 8

        def Cube "body" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </tweezers/tips> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.0005
            custom float physxCollision:restOffset = 0
            color3f[] primvars:displayColor = [(0.6, 0.62, 0.66)]
            double size = 1
            quatf xformOp:orient = (0.9998322, 0, -0.018318092, 0)
            float3 xformOp:scale = (0.0015, 0.006, 0.1245)
            double3 xformOp:translate = (0.0045287097940086875, 0, -0.06212580613240886)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }

        def Cube "tip" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </tweezers/tips> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.0005
            custom float physxCollision:restOffset = 0
            color3f[] primvars:displayColor = [(0.15, 0.15, 0.15)]
            double size = 1
            quatf xformOp:orient = (0.9998322, 0, -0.018318092, 0)
            float3 xformOp:scale = (0.0007, 0.006, 0.012)
            double3 xformOp:translate = (0.006628978236001771, 0, -0.13034465523199107)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
    }

    def PhysicsRevoluteJoint "hinge" (
        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
    )
    {
        float drive:angular:physics:damping = 0.000034906585
        float drive:angular:physics:maxForce = 10000
        float drive:angular:physics:stiffness = 0.040142573
        float drive:angular:physics:targetPosition = 0
        uniform token drive:angular:physics:type = "force"
        uniform token physics:axis = "Y"
        rel physics:body0 = </tweezers/half_a>
        rel physics:body1 = </tweezers/half_b>
        point3f physics:localPos0 = (0, 0, 0)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
        float physics:lowerLimit = 0
        float physics:upperLimit = 3.3585653
    }
}

