#usda 1.0
(
    defaultPrim = "Phone"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Phone" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI", "PhysxContactReportAPI"]
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (0.00038756433, 0.00009005929, 0.00047499497)
    float physics:mass = 0.206
    quatf physics:principalAxes = (1, 0, 0, 0)
    float physxContactReport:threshold = 0
    float physxRigidBody:angularDamping = 0
    bool physxRigidBody:enableCCD = 1
    float physxRigidBody:linearDamping = 0
    quatf xformOp:orient = (1, 0, 0, 0)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

    def "Looks"
    {
        def Material "m00" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Phone/Looks/m00/Surface.outputs:surface>
            float physics:dynamicFriction = 0.52
            float physics:restitution = 0
            float physics:staticFriction = 0.65

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 0)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
        }

        def Material "m01" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
