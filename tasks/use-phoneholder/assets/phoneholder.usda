            float physics:dynamicFriction = 0.52
            float physics:restitution = 0
            float physics:staticFriction = 0.65

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.44, 0.41, 0.54)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.27
                token outputs:surface
            }
        }

        def Material "Hub" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
