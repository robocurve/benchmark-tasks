#usda 1.0
(
    defaultPrim = "manikin"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "manikin"
{
    def "Looks"
    {
        def Material "skin"
        {
            token outputs:surface.connect = </manikin/Looks/skin/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.93, 0.76, 0.66)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "card"
        {
            token outputs:surface.connect = </manikin/Looks/card/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.97, 0.97, 0.95)
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "ink"
        {
            token outputs:surface.connect = </manikin/Looks/ink/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.03, 0.03, 0.03)
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
    }

    def Xform "torso" (
