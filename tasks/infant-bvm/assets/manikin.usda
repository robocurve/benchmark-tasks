            rel material:binding = </manikin/Looks/ink>
            double radius = 0.005
            double3 xformOp:translate = (0, -0.0005600000000000001, 0.02)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def PhysicsPrismaticJoint "rise" (
        prepend apiSchemas = ["PhysicsDriveAPI:linear"]
    )
    {
        float drive:linear:physics:damping = 20
        float drive:linear:physics:stiffness = 2000
        float drive:linear:physics:targetPosition = 0
        uniform token drive:linear:physics:type = "force"
        uniform token physics:axis = "Z"
        rel physics:body0 = </manikin/torso>
        rel physics:body1 = </manikin/chest>
        point3f physics:localPos0 = (0.21894422, 0, 0.11075531)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
        float physics:lowerLimit = 0
        float physics:upperLimit = 0.02
    }
}

