#usda 1.0
(
    defaultPrim = "bvm"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "bvm"
{
    def "Looks"
    {
        def Material "dome"
        {
            token outputs:surface.connect = </bvm/Looks/dome/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.9, 0.93)
                float inputs:opacity = 0.55
                float inputs:roughness = 0.15
                token outputs:surface
            }
        }

        def Material "cushion"
        {
            token outputs:surface.connect = </bvm/Looks/cushion/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.78, 0.92)
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "valve"
        {
            token outputs:surface.connect = </bvm/Looks/valve/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.8, 0.2)
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "bag"
        {
            token outputs:surface.connect = </bvm/Looks/bag/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.84, 0.9, 0.93)
                float inputs:opacity = 0.8
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }
    }

    def Xform "dome" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI", "PhysxArticulationAPI", "PhysxContactReportAPI", "PhysicsFilteredPairsAPI"]
    )
    {
        rel physics:filteredPairs = [
            </bvm/valve>,
            </bvm/wall_top>,
            </bvm/wall_left>,
            </bvm/wall_bottom>,
            </bvm/wall_right>,
            </bvm/seg_00>,
            </bvm/seg_01>,
            </bvm/seg_02>,
            </bvm/seg_03>,
            </bvm/seg_04>,
            </bvm/seg_05>,
            </bvm/seg_06>,
            </bvm/seg_07>,
            </bvm/seg_08>,
            </bvm/seg_09>,
            </bvm/seg_10>,
            </bvm/seg_11>,
        ]
        float physics:mass = 0.002
        custom bool physxArticulation:enabledSelfCollisions = 0
        custom float physxArticulation:sleepThreshold = 0
        custom float physxArticulation:stabilizationThreshold = 0
        custom float physxContactReport:threshold = 0
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Mesh "shell" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
