#usda 1.0
(
    defaultPrim = "wheelchair"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "wheelchair"
{
    def "Looks"
    {
        def Material "frame"
        {
            token outputs:surface.connect = </wheelchair/Looks/frame/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.13, 0.42)
                float inputs:metallic = 0.55
                float inputs:roughness = 0.32
                token outputs:surface
            }
        }

        def Material "chrome"
        {
            token outputs:surface.connect = </wheelchair/Looks/chrome/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.8, 0.82)
                float inputs:metallic = 1
                float inputs:roughness = 0.18
                token outputs:surface
            }
        }

        def Material "steel"
        {
            token outputs:surface.connect = </wheelchair/Looks/steel/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.56, 0.58)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "tyre"
        {
            token outputs:surface.connect = </wheelchair/Looks/tyre/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
