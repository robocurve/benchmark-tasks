#usda 1.0
(
    defaultPrim = "Stove"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Stove" (
    customData = {
        string assetDescription = "Static two-burner industrial hob with a readable CH4 34 percent LEL display; burners are initially OFF."
    }
)
{
    def "Looks"
    {
        def Material "Steel"
        {
            token outputs:surface.connect = </Stove/Looks/Steel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.34239164, 0.38005632, 0.4064483)
                float inputs:metallic = 0.87
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }

        def Material "Edge"
        {
            token outputs:surface.connect = </Stove/Looks/Edge/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.53823555, 0.5704816, 0.58701634)
                float inputs:metallic = 0.94
                float inputs:roughness = 0.21
                token outputs:surface
            }
        }

        def Material "CastIron"
        {
            token outputs:surface.connect = </Stove/Looks/CastIron/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.00440085, 0.0049991165, 0.0054228688)
                float inputs:metallic = 0.4
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }

        def Material "Rubber"
        {
            token outputs:surface.connect = </Stove/Looks/Rubber/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.0019349845, 0.0021671827, 0.0023219814)
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "Burner"
        {
            token outputs:surface.connect = </Stove/Looks/Burner/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.11928019, 0.10048151, 0.068384856)
                float inputs:metallic = 0.7
                float inputs:roughness = 0.48
                token outputs:surface
            }
        }

        def Material "Black"
        {
            token outputs:surface.connect = </Stove/Looks/Black/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.0011609907, 0.001625387, 0.0014705883)
                float inputs:metallic = 0
                float inputs:roughness = 0.36
                token outputs:surface
            }
        }

        def Material "Display"
        {
            token outputs:surface.connect = </Stove/Looks/Display/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.60382736, 0.7874123, 0.31854677)
                color3f inputs:diffuseColor.connect = </Stove/Looks/Display/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/gas_display.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Stove/Looks/Display/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "OffLabel"
        {
            token outputs:surface.connect = </Stove/Looks/OffLabel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 1)
                color3f inputs:diffuseColor.connect = </Stove/Looks/OffLabel/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/off_label.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Stove/Looks/OffLabel/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "MonitorLabel"
        {
            token outputs:surface.connect = </Stove/Looks/MonitorLabel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 1)
                color3f inputs:diffuseColor.connect = </Stove/Looks/MonitorLabel/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/gas_detector_label.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Stove/Looks/MonitorLabel/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }
    }

