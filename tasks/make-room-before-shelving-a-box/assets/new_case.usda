    def Scope "Looks"
    {
        def Material "new_case"
        {
            token outputs:surface.connect = </new_case/Looks/new_case/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor.connect = </new_case/Looks/new_case/color_tex.outputs:rgb>
                float inputs:roughness = 0.85
                token outputs:surface
            }
            def Shader "uv"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "color_tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/rice_case.png@
                float2 inputs:st.connect = </new_case/Looks/new_case/uv.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                token inputs:sourceColorSpace = "sRGB"
                float4 inputs:scale = (0.5, 0.5, 0.5, 1)
                float3 outputs:rgb
            }
        }
    }

