)
{
    def Xform "Handle"
    {
        def Scope "Looks"
        {
            def Material "SourceAtlas"
            {
                token outputs:surface.connect = </RatchetVisual/Handle/Looks/SourceAtlas/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor.connect = </RatchetVisual/Handle/Looks/SourceAtlas/alb.outputs:rgb>
                    float inputs:metallic = 0.8
                    float inputs:metallic.connect = </RatchetVisual/Handle/Looks/SourceAtlas/orm.outputs:b>
                    normal3f inputs:normal.connect = </RatchetVisual/Handle/Looks/SourceAtlas/nor.outputs:rgb>
                    float inputs:occlusion.connect = </RatchetVisual/Handle/Looks/SourceAtlas/orm.outputs:r>
                    float inputs:roughness.connect = </RatchetVisual/Handle/Looks/SourceAtlas/orm.outputs:g>
                    token outputs:surface
                }

                def Shader "UV"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "alb"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @vendor/derived_textures/handTool_ratchet_b01/t_handTool_socket_a01_alb.png@
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </RatchetVisual/Handle/Looks/SourceAtlas/UV.outputs:result>
                    float outputs:b
                    float outputs:g
                    float outputs:r
                    float3 outputs:rgb
                }

                def Shader "nor"
                {
                    uniform token info:id = "UsdUVTexture"
                    float4 inputs:bias = (-1, -1, -1, 0)
                    asset inputs:file = @vendor/derived_textures/handTool_ratchet_b01/t_handTool_socket_a01_nor.png@
                    float4 inputs:scale = (2, 2, 2, 1)
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </RatchetVisual/Handle/Looks/SourceAtlas/UV.outputs:result>
                    float outputs:b
                    float outputs:g
                    float outputs:r
                    float3 outputs:rgb
                }

                def Shader "orm"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @vendor/derived_textures/handTool_ratchet_b01/t_handTool_socket_a01_orm.png@
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </RatchetVisual/Handle/Looks/SourceAtlas/UV.outputs:result>
                    float outputs:b
                    float outputs:g
                    float outputs:r
                    float3 outputs:rgb
                }
            }
        }

