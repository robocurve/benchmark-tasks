def Xform "Asset"
{
    def Cube "Foot" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </Asset/Materials/Foot>
        bool physics:collisionEnabled = 1
        color3f[] primvars:displayColor = [(0.12, 0.14, 0.16)]
        double size = 1
        float3 xformOp:scale = (0.23, 0.065, 0.008)
        double3 xformOp:translate = (0, 0, 0.004)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

