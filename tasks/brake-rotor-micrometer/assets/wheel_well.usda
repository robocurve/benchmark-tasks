#usda 1.0
(
    defaultPrim = "WheelWell"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "WheelWell" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "Fixed wheel-well surroundings of an installed front corner (representative of a 2001-05 VW Golf IV, estimates): wheel-arch liner and fender lip (inner radius 350 mm about a centre 50 mm above the hub, from 170 mm inboard to 100 mm outboard of the rotor's mid-plane), MacPherson strut and coil spring, lower control arm, tie rod, and the unbolted caliper hung on a wire. Origin: the rotor's hub centre (same as rotor.usda). Every part collides."
)
{
    point3f physics:centerOfMass = (0, -0.08, 0.2)
    float3 physics:diagonalInertia = (2, 2, 2)
    float physics:mass = 25

    def Scope "Looks"
    {
        def Material "Phys_plastic" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.45
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }

        def Material "m080809"
        {
            token outputs:surface.connect = </WheelWell/Looks/m080809/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.09, 0.09, 0.1)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "m353945"
        {
            token outputs:surface.connect = </WheelWell/Looks/m353945/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.36, 0.4, 0.46)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "m111112"
        {
            token outputs:surface.connect = </WheelWell/Looks/m111112/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.12, 0.13)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Phys_iron" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.45
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }

        def Material "m152137"
        {
            token outputs:surface.connect = </WheelWell/Looks/m152137/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.16, 0.22, 0.38)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "m656669"
        {
            token outputs:surface.connect = </WheelWell/Looks/m656669/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.66, 0.67, 0.7)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }

        def Material "m545457"
        {
            token outputs:surface.connect = </WheelWell/Looks/m545457/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.55, 0.58)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    def Cube "Liner1" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </WheelWell/Looks/m080809>
        rel material:binding:physics = </WheelWell/Looks/Phys_plastic> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float xformOp:rotateY = -67.5
        float3 xformOp:scale = (0.032882527, 0.27, 0.004)
        double3 xformOp:translate = (0.32520559544397293, -0.035, -0.08470456819251158)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY", "xformOp:scale"]
