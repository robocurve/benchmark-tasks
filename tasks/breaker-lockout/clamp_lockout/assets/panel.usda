    def "Looks"
    {
        def Material "plywood"
        {
            token outputs:surface.connect = </panel/Looks/plywood/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.58, 0.4)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "tub"
        {
            token outputs:surface.connect = </panel/Looks/tub/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.7, 0.69)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "deadfront"
        {
            token outputs:surface.connect = </panel/Looks/deadfront/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.78, 0.76)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "breaker_black"
        {
            token outputs:surface.connect = </panel/Looks/breaker_black/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.1, 0.11)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "window"
        {
            token outputs:surface.connect = </panel/Looks/window/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.2, 0.21)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "tex_brk_on"
        {
            token outputs:surface.connect = </panel/Looks/tex_brk_on/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </panel/Looks/tex_brk_on/tex.outputs:rgb>
                float inputs:roughness = 0.7
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
