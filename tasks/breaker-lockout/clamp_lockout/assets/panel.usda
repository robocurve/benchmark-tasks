    def "joints"
    {
        def PhysicsFixedJoint "world_fixed"
        {
            rel physics:body1 = </panel/base>
        }

        def PhysicsRevoluteJoint "handle_0_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </panel/base>
            rel physics:body1 = </panel/handle_0>
            point3f physics:localPos0 = (0.007, 0.044, 0.019)
            point3f physics:localPos1 = (0, 0, 0)
            float physics:lowerLimit = -26
            float physics:upperLimit = 24
        }

        def PhysicsRevoluteJoint "handle_1_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </panel/base>
            rel physics:body1 = </panel/handle_1>
            point3f physics:localPos0 = (0.007, -0.044, 0.019)
            point3f physics:localPos1 = (0, 0, 0)
            float physics:lowerLimit = -24
            float physics:upperLimit = 26
        }

        def PhysicsRevoluteJoint "handle_2_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
