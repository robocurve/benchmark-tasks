#usda 1.0
(
    defaultPrim = "panel"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "panel" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 0
    custom int physxArticulation:solverPositionIterationCount = 64
    custom int physxArticulation:solverVelocityIterationCount = 8

    def Xform "base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        rel material:binding:physics = </panel/PhysicsMaterials/steel> (
            bindMaterialAs = "weakerThanDescendants"
        )
        float physics:mass = 0.5

        def Cube "backboard" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </panel/Looks/plywood>
            custom float physxCollision:contactOffset = 0.002
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.018, 0.4, 0.33)
            double3 xformOp:translate = (0.089, 0, -0.035)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

