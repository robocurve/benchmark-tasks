#usda 1.0
(
    defaultPrim = "stands"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "stands"
{
    def "Looks"
    {
        def Material "stand"
        {
            token outputs:surface.connect = </stands/Looks/stand/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4, 0.4, 0.42)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

    def Cube "lockout_foot" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </stands/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.06, 0.05, 0.01)
        double3 xformOp:translate = (0.22649999999999998, -0.15300000000000002, 0.005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "lockout_post" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </stands/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.015, 0.018, 0.19055)
        double3 xformOp:translate = (0.22649999999999998, -0.15300000000000002, 0.095275)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "lever_rest" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </stands/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.016, 0.016, 0.19055)
        double3 xformOp:translate = (0.17088461064816746, -0.18393091308703496, 0.095275)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "mid_rest" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </stands/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.015, 0.018, 0.19055)
        double3 xformOp:translate = (0.22649999999999998, -0.127, 0.095275)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "padlock_foot" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </stands/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.05, 0.06, 0.01)
        double3 xformOp:translate = (0.262, 0.165, 0.005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "padlock_column" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </stands/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.009, 0.03, 0.11)
        double3 xformOp:translate = (0.262, 0.165, 0.055)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

