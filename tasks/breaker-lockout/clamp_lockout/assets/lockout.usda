    def "Looks"
    {
        def Material "lockout_red"
        {
            token outputs:surface.connect = </lockout/Looks/lockout_red/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.07, 0.05)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "zinc"
        {
            token outputs:surface.connect = </lockout/Looks/zinc/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.87, 0.88)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "steel"
        {
            token outputs:surface.connect = </lockout/Looks/steel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.74, 0.77)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "knob"
        {
