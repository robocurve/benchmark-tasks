    def "joints"
    {
        def PhysicsPrismaticJoint "jaw_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear"]
        )
        {
            uniform token physics:axis = "Y"
            rel physics:body0 = </lockout/body>
            rel physics:body1 = </lockout/jaw>
            point3f physics:localPos0 = (0, 0.008469958, 0)
            point3f physics:localPos1 = (0, 0, 0)
            float physics:lowerLimit = -0.0074699577
            float physics:upperLimit = 0.002
        }

        def PhysicsRevoluteJoint "knob_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
