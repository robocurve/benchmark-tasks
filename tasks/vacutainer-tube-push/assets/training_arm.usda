#usda 1.0
(
    defaultPrim = "TrainingArm"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "TrainingArm" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    doc = "An adult IV/venipuncture training arm lying palm up, about 575 mm long (upper arm to fingertips), silicone skin, with the median cubital vein marked. Origin: on the table under the needle's entry point at the elbow crease (skin 75 mm up); the arm runs along y, the hand at -y. Fixed. Created for this task by its authors, licensed CC-BY 4.0."
)
{
    bool physics:kinematicEnabled = 1

    def Scope "Looks"
    {
        def Material "Skin"
        {
            token outputs:surface.connect = </TrainingArm/Looks/Skin/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.66, 0.54)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Vein"
        {
            token outputs:surface.connect = </TrainingArm/Looks/Vein/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.38, 0.62)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Phys_Silicone_Skin" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.9
            float physics:restitution = 0
            float physics:staticFriction = 1
        }
    }

