#usda 1.0
(
    defaultPrim = "BloodColumn"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "BloodColumn" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "A 24 mm piece of the blood column the task shows inside a filling blood tube (r 5.58 mm, just inside the tube's wall): visual only, no collider and no gravity; it waits out of sight under the table and the task moves it into a tube, with the tube, as blood is drawn. Its mass is a placeholder (nothing touches it). Origin: its middle; +Z along the tube. Created for this task by its authors, licensed CC-BY 4.0."
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (5.57841e-8, 5.57841e-8, 1.55682e-8)
    float physics:mass = 0.001
    quatf physics:principalAxes = (1, 0, 0, 0)
    custom float physxRigidBody:angularDamping = 0
    custom bool physxRigidBody:disableGravity = 1
    custom float physxRigidBody:linearDamping = 0
    custom float physxRigidBody:sleepThreshold = 0

    def Scope "Looks"
    {
        def Material "Blood"
        {
            token outputs:surface.connect = </BloodColumn/Looks/Blood/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0, 0.01)
                float inputs:metallic = 0
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
    }

