            uniform token physics:axis = "Y"
            rel physics:body0 = </NeedleHolder/Track>
            rel physics:body1 = </NeedleHolder/Holder>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -0.015
            float physics:upperLimit = 0.012
        }

        def PhysicsPrismaticJoint "Sleeve" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear"]
            doc = "The rubber sleeve folding back along the needle (m; 0 free, + toward the hub). Spring 150 N/m with its target 8 mm past the free end: 1.2 N free, 2.4 N folded."
        )
        {
            float drive:linear:physics:damping = 0.5
            float drive:linear:physics:stiffness = 150
            float drive:linear:physics:targetPosition = -0.008
            uniform token drive:linear:physics:type = "force"
            uniform token physics:axis = "Y"
            rel physics:body0 = </NeedleHolder/Holder>
            rel physics:body1 = </NeedleHolder/Sleeve>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.008
        }
    }
}

