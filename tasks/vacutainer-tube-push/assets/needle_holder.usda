#usda 1.0
(
    defaultPrim = "NeedleHolder"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "NeedleHolder" (
    doc = "A single-use needle holder (polypropylene, 52.3 mm long, body 20 mm, base flange 30 mm, 17 mm bore with a 2 mm lead-in at its mouth) on a 21 G multi-sample needle whose patient end is in the training arm's vein. Articulation: Entry (the skin entry point, fixed by the task) - Pivot (about +X: the tissue resists levering the needle, 2 N m/rad) - Track - Slide (along +Y, the needle's axis into the arm: tissue drag 30 N s/m, a 100 N/m spring) - Holder. Origin: the entry point; +Y along the needle into the arm (the task tilts it 20 degrees, holder end up). Inside the holder the needle's non-patient end (16 mm) points back at the tube under its rubber sleeve (2.4 mm), which the tube's stopper folds back (the Sleeve link on a sprung slide, 1.2 to 2.4 N); a tube's stopper is fully on 44 mm from the entry point (against the needle hub's rear boss). Created for this task by its authors, licensed CC-BY 4.0."
)
{
    def Scope "Looks"
    {
        def Material "Holder_PP"
        {
            token outputs:mdl:displacement.connect = </NeedleHolder/Looks/Holder_PP/Glass.outputs:out>
            token outputs:mdl:surface.connect = </NeedleHolder/Looks/Holder_PP/Glass.outputs:out>
            token outputs:mdl:volume.connect = </NeedleHolder/Looks/Holder_PP/Glass.outputs:out>
            token outputs:surface.connect = </NeedleHolder/Looks/Holder_PP/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.88, 0.9)
                float inputs:metallic = 0
                float inputs:opacity = 0.25
                float inputs:roughness = 0.05
                token outputs:surface
            }

            def Shader "Glass"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniGlass.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniGlass"
                float inputs:frosting_roughness = 0
                color3f inputs:glass_color = (0.93, 0.94, 0.95)
                float inputs:glass_ior = 1.5
                bool inputs:thin_walled = 1
                token outputs:out
            }
        }

        def Material "Needle_Hub_Green"
        {
            token outputs:surface.connect = </NeedleHolder/Looks/Needle_Hub_Green/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.55, 0.25)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "Needle_Steel"
        {
            token outputs:surface.connect = </NeedleHolder/Looks/Needle_Steel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.76, 0.78)
                float inputs:metallic = 0
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }

        def Material "Needle_Sleeve"
        {
            token outputs:surface.connect = </NeedleHolder/Looks/Needle_Sleeve/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.92, 0.9, 0.82)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Phys_PP" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:restitution = 0
            float physics:staticFriction = 0.4
        }

        def Material "Phys_Steel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:restitution = 0
            float physics:staticFriction = 0.4
        }

        def Material "Phys_Rubber" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.7
            float physics:restitution = 0
            float physics:staticFriction = 0.8
        }
    }

    def Xform "Entry" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI"]
        doc = "The needle's skin entry point (fixed where the task places it). The articulation's root link."
    )
    {
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (1e-8, 1e-8, 1e-8)
        float physics:mass = 0.002
        quatf physics:principalAxes = (1, 0, 0, 0)
        custom bool physxArticulation:enabledSelfCollisions = 1
    }

    def Xform "Track" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        doc = "The needle's track through the tissue: it pivots at the entry point."
    )
    {
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (1e-8, 1e-8, 1e-8)
        float physics:mass = 0.001
        quatf physics:principalAxes = (1, 0, 0, 0)
    }

