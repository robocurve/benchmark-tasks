        int[] faceVertexIndices = [0, 1, 41, 0, 41, 40, 1, 2, 42, 1, 42, 41, 2, 3, 43, 2, 43, 42, 3, 4, 44, 3, 44, 43, 4, 5, 45, 4, 45, 44, 5, 6, 46, 5, 46, 45, 6, 7, 47, 6, 47, 46, 7, 8, 48, 7, 48, 47, 8, 9, 49, 8, 49, 48, 9, 10, 50, 9, 50, 49, 10, 11, 51, 10, 51, 50, 11, 12, 52, 11, 52, 51, 12, 13, 53, 12, 53, 52, 13, 14, 54, 13, 54, 53, 14, 15, 55, 14, 55, 54, 15, 16, 56, 15, 56, 55, 16, 17, 57, 16, 57, 56, 17, 18, 58, 17, 58, 57, 18, 19, 59, 18, 59, 58, 19, 20, 60, 19, 60, 59, 20, 21, 61, 20, 61, 60, 21, 22, 62, 21, 62, 61, 22, 23, 63, 22, 63, 62, 23, 24, 64, 23, 64, 63, 24, 25, 65, 24, 65, 64, 25, 26, 66, 25, 66, 65, 26, 27, 67, 26, 67, 66, 27, 28, 68, 27, 68, 67, 28, 29, 69, 28, 69, 68, 29, 30, 70, 29, 70, 69, 30, 31, 71, 30, 71, 70, 31, 32, 72, 31, 72, 71, 32, 33, 73, 32, 73, 72, 33, 34, 74, 33, 74, 73, 34, 35, 75, 34, 75, 74, 35, 36, 76, 35, 76, 75, 36, 37, 77, 36, 77, 76, 37, 38, 78, 37, 78, 77, 38, 39, 79, 38, 79, 78, 39, 0, 40, 39, 40, 79, 40, 41, 81, 40, 81, 80, 41, 42, 82, 41, 82, 81, 42, 43, 83, 42, 83, 82, 43, 44, 84, 43, 84, 83, 44, 45, 85, 44, 85, 84, 45, 46, 86, 45, 86, 85, 46, 47, 87, 46, 87, 86, 47, 48, 88, 47, 88, 87, 48, 49, 89, 48, 89, 88, 49, 50, 90, 49, 90, 89, 50, 51, 91, 50, 91, 90, 51, 52, 92, 51, 92, 91, 52, 53, 93, 52, 93, 92, 53, 54, 94, 53, 94, 93, 54, 55, 95, 54, 95, 94, 55, 56, 96, 55, 96, 95, 56, 57, 97, 56, 97, 96, 57, 58, 98, 57, 98, 97, 58, 59, 99, 58, 99, 98, 59, 60, 100, 59, 100, 99, 60, 61, 101, 60, 101, 100, 61, 62, 102, 61, 102, 101, 62, 63, 103, 62, 103, 102, 63, 64, 104, 63, 104, 103, 64, 65, 105, 64, 105, 104, 65, 66, 106, 65, 106, 105, 66, 67, 107, 66, 107, 106, 67, 68, 108, 67, 108, 107, 68, 69, 109, 68, 109, 108, 69, 70, 110, 69, 110, 109, 70, 71, 111, 70, 111, 110, 71, 72, 112, 71, 112, 111, 72, 73, 113, 72, 113, 112, 73, 74, 114, 73, 114, 113, 74, 75, 115, 74, 115, 114, 75, 76, 116, 75, 116, 115, 76, 77, 117, 76, 117, 116, 77, 78, 118, 77, 118, 117, 78, 79, 119, 78, 119, 118, 79, 40, 80, 79, 80, 119, 80, 81, 121, 80