#usda 1.0
(
    defaultPrim = "TubeTray"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "TubeTray" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    doc = "A blue polypropylene tube tray, 140 x 160 mm with 12 mm walls, with three lanes 40 mm apart, each with two V-rests (45 degrees a side) that hold a 13 mm tube level, its axis 25 mm above the table, along y with its stopper toward +y; the tube's closed end overhangs the rests, so fingers can close round it. Origin: on the table at the tray's middle. Fixed. Created for this task by its authors, licensed CC-BY 4.0."
)
{
    bool physics:kinematicEnabled = 1

    def Scope "Looks"
    {
        def Material "Tray_Blue"
        {
            token outputs:surface.connect = </TubeTray/Looks/Tray_Blue/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.42, 0.75)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "Rest_White"
        {
            token outputs:surface.connect = </TubeTray/Looks/Rest_White/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.9, 0.88)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Phys_PP" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:restitution = 0
            float physics:staticFriction = 0.4
        }
    }

    def Scope "Colliders"
    {
        def Cube "Box_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </TubeTray/Looks/Phys_PP> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.001
            custom float physxCollision:restOffset = 0
            uniform token purpose = "guide"
            double size = 1
            float3 xformOp:scale = (0.14, 0.16, 0.003)
            double3 xformOp:translate = (0, 0, 0.0015)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

