        def Material "abs_charcoal"
        {
            token outputs:surface.connect = </root/Looks/abs_charcoal/pbr.outputs:surface>
            def Shader "pbr"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </root/Looks/abs_charcoal/alb.outputs:rgb>
                normal3f inputs:normal.connect = </root/Looks/abs_charcoal/nor.outputs:rgb>
                float inputs:metallic = 0.0
                float inputs:roughness = 0.55
                token outputs:surface
            }
            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "alb"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/t_plastic_glossy_black_a01_tile_alb.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </root/Looks/abs_charcoal/st.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float4 inputs:scale = (0.2, 0.21, 0.23, 1.0)
                float4 inputs:bias = (0.0, 0.0, 0.0, 0.0)
                float3 outputs:rgb
                float outputs:r
