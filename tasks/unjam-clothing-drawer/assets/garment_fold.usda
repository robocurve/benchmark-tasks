#usda 1.0
(
    defaultPrim = "Fold"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Fold" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
    doc = "Wrinkled scarf-like visible fold. Underlying spring-supported rigid collision proxy, NOT simulated deformable cloth."
)
{
    float physics:mass = 0.04
    custom float physxRigidBody:linearDamping = 0.3

    def "Looks"
    {
        def Material "OrangeCotton" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Fold/Looks/OrangeCotton/Surface.outputs:surface>
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.45

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.68, 0.19, 0.055)
                color3f inputs:diffuseColor.connect = </Fold/Looks/OrangeCotton/Detail_color.outputs:rgb>
                normal3f inputs:normal.connect = </Fold/Looks/OrangeCotton/Detail_normal.outputs:rgb>
                float inputs:roughness = 0.92
                float inputs:roughness.connect = </Fold/Looks/OrangeCotton/Detail_roughness.outputs:r>
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Weave"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, 0)
                asset inputs:file = @textures/weave_normal.png@
                float4 inputs:scale = (2, 2, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Fold/Looks/OrangeCotton/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "Detail_color"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/cotton_color.png@
                float4 inputs:scale = (0.68, 0.19, 0.055, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Fold/Looks/OrangeCotton/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "Detail_normal"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, 0)
                asset inputs:file = @textures/cotton_normal.png@
                float4 inputs:scale = (2, 2, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Fold/Looks/OrangeCotton/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "Detail_roughness"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/cotton_roughness.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Fold/Looks/OrangeCotton/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }
        }

        def Material "RustLinen"
        {
            token outputs:surface.connect = </Fold/Looks/RustLinen/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.22, 0.12)
                color3f inputs:diffuseColor.connect = </Fold/Looks/RustLinen/Detail_color.outputs:rgb>
                normal3f inputs:normal.connect = </Fold/Looks/RustLinen/Detail_normal.outputs:rgb>
                float inputs:roughness = 0.92
                float inputs:roughness.connect = </Fold/Looks/RustLinen/Detail_roughness.outputs:r>
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Thread"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/thread.png@
                float4 inputs:scale = (0.55, 0.22, 0.12, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Fold/Looks/RustLinen/UV.outputs:result>
                float3 outputs:rgb
            }

            def Shader "Weave"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, 0)
                asset inputs:file = @textures/weave_normal.png@
                float4 inputs:scale = (2, 2, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Fold/Looks/RustLinen/UV.outputs:result>
                float3 outputs:rgb
            }

            def Shader "Detail_color"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/linen_color.png@
                float4 inputs:scale = (0.55, 0.22, 0.12, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Fold/Looks/RustLinen/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "Detail_normal"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, 0)
                asset inputs:file = @textures/linen_normal.png@
                float4 inputs:scale = (2, 2, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Fold/Looks/RustLinen/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "Detail_roughness"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/linen_roughness.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Fold/Looks/RustLinen/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }
        }

        def Material "RustStitch"
        {
            token outputs:surface.connect = </Fold/Looks/RustStitch/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.76, 0.51, 0.3)
                color3f inputs:diffuseColor.connect = </Fold/Looks/RustStitch/Detail_color.outputs:rgb>
                normal3f inputs:normal.connect = </Fold/Looks/RustStitch/Detail_normal.outputs:rgb>
                float inputs:roughness = 0.92
                float inputs:roughness.connect = </Fold/Looks/RustStitch/Detail_roughness.outputs:r>
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Thread"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/thread.png@
                float4 inputs:scale = (0.76, 0.51, 0.3, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Fold/Looks/RustStitch/UV.outputs:result>
                float3 outputs:rgb
            }

            def Shader "Weave"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, 0)
                asset inputs:file = @textures/weave_normal.png@
                float4 inputs:scale = (2, 2, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Fold/Looks/RustStitch/UV.outputs:result>
                float3 outputs:rgb
            }

            def Shader "Detail_color"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/cotton_color.png@
                float4 inputs:scale = (0.76, 0.51, 0.3, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Fold/Looks/RustStitch/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "Detail_normal"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, 0)
                asset inputs:file = @textures/cotton_normal.png@
                float4 inputs:scale = (2, 2, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Fold/Looks/RustStitch/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "Detail_roughness"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/cotton_roughness.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Fold/Looks/RustStitch/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }
        }
    }

    def Cube "BunchedFabric" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Fold/Looks/OrangeCotton>
        custom float physxCollision:contactOffset = 0.0008
        custom float physxCollision:restOffset = 0
        double size = 1
        token visibility = "invisible"
        float3 xformOp:scale = (0.044, 0.05, 0.026)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "LeadingFlap" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Fold/Looks/OrangeCotton>
        custom float physxCollision:contactOffset = 0.0008
        custom float physxCollision:restOffset = 0
        double size = 1
        token visibility = "invisible"
        float3 xformOp:scale = (0.078, 0.05, 0.006)
        double3 xformOp:translate = (-0.043, 0, -0.009)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Mesh "TrappedScarfSurface" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform bool doubleSided = 1
        float3[] extent = [(-0.082, -0.025, -0.007799777), (0.022, 0.025, 0.010072264)]
        int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3