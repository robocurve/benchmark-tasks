        int[] faceVertexIndices = [1, 12, 11, 1, 11, 0, 2, 13, 12, 2, 12, 1, 3, 14, 13, 3, 13, 2, 4, 15, 14, 4, 14, 3, 5, 16, 15, 5, 15, 4, 6, 17, 16, 6, 16, 5, 7, 18, 17, 7, 17, 6, 8, 19, 18, 8, 18, 7, 9, 20, 19, 9, 19, 8, 10, 21, 20, 10, 20, 9, 12, 23, 22, 12, 22, 11, 13, 24, 23, 13, 23, 12, 14, 25, 24, 14, 24, 13, 15, 26, 25, 15, 25, 14, 16, 27, 26, 16, 26, 15, 17, 28, 27, 17, 27, 16, 18, 29, 28, 18, 28, 17, 19, 30, 29, 19, 29, 18, 20, 31, 30, 20, 30, 19, 21, 32, 31, 21, 31, 20, 23, 34, 33, 23, 33, 22, 24, 35, 34, 24, 34, 23, 25, 36, 35, 25, 35, 24, 26, 37, 36, 26, 36, 25, 27, 38, 37, 27, 37, 26, 28, 39, 38, 28, 38, 27, 29, 40, 39, 29, 39, 28, 30, 41, 40, 30, 40, 29, 31, 42, 41, 31, 41, 30, 32, 43, 42, 32, 42, 31, 34, 45, 44, 34, 44, 33, 35, 46, 45, 35, 45, 34, 36, 47, 46, 36, 46, 35, 37, 48, 47, 37, 47, 36, 38, 49, 48, 38, 48, 37, 39, 50, 49, 39, 49, 38, 40, 51, 50, 40, 50, 39, 41, 52, 51, 41, 51, 40, 42, 53, 52, 42, 52, 41, 43, 54, 53, 43, 53, 42, 45, 56, 55, 45, 55, 44, 46, 57, 56, 46, 56, 45, 47, 58, 57, 47, 57, 46, 48, 59, 58, 48, 58, 47, 49, 60, 59, 49, 59, 48, 50, 61, 60, 50, 60, 49, 51, 62, 61, 51, 61, 50, 52, 63, 62, 52, 62, 51, 53, 64, 63, 53, 63, 52, 54, 65, 64, 54, 64, 53, 56, 67, 66, 56, 66, 55, 57, 68, 67, 57, 67, 56, 58, 69, 68, 58, 68, 57, 59, 70, 69, 59, 69, 58, 60, 71, 70, 60, 70, 59, 61, 72, 71, 61, 71, 60, 62, 73, 72, 62, 72, 61, 63, 74, 73, 63, 73, 62, 64, 75, 74, 64, 74, 63, 65, 76, 75, 65, 75, 64, 67, 78, 77, 67, 77, 66, 68, 79, 78, 68, 78, 67, 69, 80, 79, 69, 79, 68, 70, 81, 80, 70, 80, 69, 71, 82, 81, 71, 81, 70, 72, 83, 82, 72, 82, 71, 73, 84, 83, 73, 83, 72, 74, 85, 84, 74, 84, 73, 75, 86, 85, 75, 85, 74, 76, 87, 86, 76, 86, 75, 78, 89, 88, 78, 88, 77, 79, 90, 89, 79, 89, 78, 80, 91, 90, 80, 90, 79, 81, 92, 91, 81, 91, 80, 82, 93, 92, 82, 92, 81, 83, 94, 93, 83, 93, 82, 84, 95, 94, 84, 94, 83, 85, 96, 95, 85, 95, 84, 86, 97, 96, 86, 96, 85, 87, 98, 97, 87, 97, 86, 89, 100, 99, 89, 99, 88, 90, 101, 100, 90, 100, 89, 91, 102, 101, 91, 101