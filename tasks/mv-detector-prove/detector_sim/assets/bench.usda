        double size = 1
        float xformOp:rotateZ = -90
        float3 xformOp:scale = (0.125, 0.066, 0.033)
        double3 xformOp:translate = (0.22000000000000003, -0.32250000000000006, 0.15)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]
