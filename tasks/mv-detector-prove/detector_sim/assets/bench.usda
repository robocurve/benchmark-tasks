#usda 1.0
(
    defaultPrim = "bench"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "bench"
{
    def "Looks"
    {
        def Material "tester_black"
        {
            token outputs:surface.connect = </bench/Looks/tester_black/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.07, 0.07, 0.08)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "test_red"
        {
            token outputs:surface.connect = </bench/Looks/test_red/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.08, 0.06)
                float inputs:roughness = 0.5
