#usda 1.0
(
    defaultPrim = "detector"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "detector" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    point3f physics:centerOfMass = (0, 0, 0.38079268)
    float physics:mass = 0.7175

    def "Looks"
    {
        def Material "hde_red"
        {
            token outputs:surface.connect = </detector/Looks/hde_red/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.88, 0.1, 0.07)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "label_black"
        {
            token outputs:surface.connect = </detector/Looks/label_black/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.08, 0.09)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "stick_yellow"
        {
            token outputs:surface.connect = </detector/Looks/stick_yellow/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.93, 0.78, 0.12)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "alu"
        {
            token outputs:surface.connect = </detector/Looks/alu/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.72, 0.75)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "white"
        {
            token outputs:surface.connect = </detector/Looks/white/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.95, 0.95)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "led_off"
        {
            token outputs:surface.connect = </detector/Looks/led_off/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.18, 0.13, 0.12)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "led_red"
        {
            token outputs:surface.connect = </detector/Looks/led_red/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0.05, 0.02)
                color3f inputs:emissiveColor = (1, 0.05, 0.02)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "led_green"
        {
            token outputs:surface.connect = </detector/Looks/led_green/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 1, 0.2)
                color3f inputs:emissiveColor = (0.1, 1, 0.2)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "lens"
        {
            token outputs:surface.connect = </detector/Looks/lens/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.79, 0.82)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

    def Cube "head" (
