#usda 1.0
(
    defaultPrim = "Scale"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Scale"
{
    def "Looks"
    {
        def Material "Body"
        {
            token outputs:surface.connect = </Scale/Looks/Body/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.009, 0.011, 0.014)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }

        def Material "Plate"
        {
            token outputs:surface.connect = </Scale/Looks/Plate/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Scale/Looks/Plate/Texture.outputs:rgb>
                float inputs:metallic = 0.75
                float inputs:roughness = 0.37
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/scale-panel.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Scale/Looks/Plate/UV.outputs:result>
                color3f outputs:rgb
            }
        }

        def Material "Screen"
        {
            token outputs:surface.connect = </Scale/Looks/Screen/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.004, 0.006, 0.008)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "Digits"
        {
            token outputs:surface.connect = </Scale/Looks/Digits/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.76, 0.86, 0.84)
                color3f inputs:emissiveColor = (0.76, 0.86, 0.84)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }

        def Material "UnlitDigits"
        {
            token outputs:surface.connect = </Scale/Looks/UnlitDigits/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 0)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:ior = 1
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 1
                token outputs:surface
            }
        }
    }

