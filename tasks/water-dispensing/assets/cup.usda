#usda 1.0
(
    defaultPrim = "Cup"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Cup"
{
    def "Looks"
    {
        def Material "Glass"
        {
            token outputs:mdl:surface.connect = </Cup/Looks/Glass/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniGlass.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniGlass"
