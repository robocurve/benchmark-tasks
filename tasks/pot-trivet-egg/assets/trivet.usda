#usda 1.0
(
    defaultPrim = "Trivet"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Trivet" (
    customData = {
        string assetDescription = "216 mm cork trivet, 18 mm thick. Static support in this visual prototype."
    }
)
{
    def "Looks"
    {
        def Material "Cork"
        {
            token outputs:surface.connect = </Trivet/Looks/Cork/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 1)
                color3f inputs:diffuseColor.connect = </Trivet/Looks/Cork/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.88
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/cork.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Trivet/Looks/Cork/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "Edge"
        {
            token outputs:surface.connect = </Trivet/Looks/Edge/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15487249, 0.05925352, 0.017389102)
                float inputs:metallic = 0
                float inputs:roughness = 0.86
                token outputs:surface
            }
        }
    }

