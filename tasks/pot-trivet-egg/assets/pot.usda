#usda 1.0
(
    defaultPrim = "Pot"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Pot" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
    customData = {
        string assetDescription = "Empty 196 mm saucepan with red enamel exterior and open steel interior; 550 g."
        double3 graspCenterLocal = (-0.173, 0, 0.077)
        double graspUndersideClearanceMeters = 0.0645
        double graspWidthMeters = 0.029
    }
)
{
    rel material:binding:physics = </Pot/PhysicsMaterial>
    point3f physics:centerOfMass = (-0.01, 0, 0.043)
    float physics:mass = 0.55
    bool physics:rigidBodyEnabled = 1
    custom int physxRigidBody:solverPositionIterationCount = 16
    custom int physxRigidBody:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "Enamel"
        {
            token outputs:surface.connect = </Pot/Looks/Enamel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.39312312, 0.021980947, 0.013411749)
                float inputs:metallic = 0.22
                float inputs:roughness = 0.27
                token outputs:surface
            }
        }

        def Material "Steel"
        {
            token outputs:surface.connect = </Pot/Looks/Steel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.44798842, 0.5070785, 0.53823555)
                float inputs:metallic = 0.83
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "Handle"
        {
            token outputs:surface.connect = </Pot/Looks/Handle/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.003501016, 0.00440085, 0.00489631)
                float inputs:metallic = 0
                float inputs:roughness = 0.52
                token outputs:surface
            }
        }

        def Material "HandleEnd"
        {
            token outputs:surface.connect = </Pot/Looks/HandleEnd/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.0065714037, 0.007850573, 0.008540382)
                float inputs:metallic = 0
                float inputs:roughness = 0.48
                token outputs:surface
            }
        }
    }

    def "Geometry"
    {
        def Mesh "EnamelShell" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform bool doubleSided = 1
            float3[] extent = [(-0.098, -0.098, 0.003), (0.098, 0.098, 0.101)]
