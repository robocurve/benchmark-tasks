#usda 1.0
(
    defaultPrim = "bracket"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "bracket"
{
    def "Looks"
    {
        def Material "plywood"
        {
            token outputs:surface.connect = </bracket/Looks/plywood/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.8, 0.68)
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "bracket"
        {
            token outputs:surface.connect = </bracket/Looks/bracket/Shader.outputs:surface>

