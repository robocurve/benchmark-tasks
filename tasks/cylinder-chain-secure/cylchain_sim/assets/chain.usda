#usda 1.0
(
    defaultPrim = "chain"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "chain" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 1
    custom int physxArticulation:solverPositionIterationCount = 32
    custom int physxArticulation:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "plywood"
        {
            token outputs:surface.connect = </chain/Looks/plywood/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.8, 0.68)
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "bracket"
        {
            token outputs:surface.connect = </chain/Looks/bracket/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.42, 0.47, 0.5)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "bumper"
        {
            token outputs:surface.connect = </chain/Looks/bumper/Shader.outputs:surface>

