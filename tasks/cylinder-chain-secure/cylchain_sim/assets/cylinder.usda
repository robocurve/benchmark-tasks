#usda 1.0
(
    defaultPrim = "cylinder"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "cylinder" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    point3f physics:centerOfMass = (0, 0, 0.2)
    float3 physics:diagonalInertia = (0.051988773, 0.051988773, 0.005100744)
    float physics:mass = 3.3
    quatf physics:principalAxes = (1, 0, 0, 0)
    custom int physxRigidBody:solverPositionIterationCount = 32

    def "Looks"
    {
        def Material "plywood"
        {
            token outputs:surface.connect = </cylinder/Looks/plywood/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.8, 0.68)
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "bracket"
        {
            token outputs:surface.connect = </cylinder/Looks/bracket/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.42, 0.47, 0.5)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "bumper"
        {
            token outputs:surface.connect = </cylinder/Looks/bumper/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.04, 0.04, 0.04)
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "alu"
        {
            token outputs:surface.connect = </cylinder/Looks/alu/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.81, 0.83)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "green"
        {
            token outputs:surface.connect = </cylinder/Looks/green/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.55, 0.2)
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "brass"
        {
            token outputs:surface.connect = </cylinder/Looks/brass/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.62, 0.25)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "black"
        {
            token outputs:surface.connect = </cylinder/Looks/black/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.05)
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "zinc"
        {
            token outputs:surface.connect = </cylinder/Looks/zinc/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.72, 0.75)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "red"
        {
            token outputs:surface.connect = </cylinder/Looks/red/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.02, 0.02)
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "white"
        {
            token outputs:surface.connect = </cylinder/Looks/white/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.95, 0.95)
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }
    }

    def Cylinder "hull" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.37
        rel material:binding = </cylinder/Looks/alu>
        rel material:binding:physics = </cylinder/PhysicsMaterials/alu> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double radius = 0.0556
        double3 xformOp:translate = (0, 0, 0.185)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

