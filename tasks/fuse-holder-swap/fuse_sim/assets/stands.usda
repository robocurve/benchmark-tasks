    )
    {
        uniform bool doubleSided = 1
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        rel material:binding = </stands/Looks/tex_cradle1>
        point3f[] points = [(0.225, -0.117, 0.0042), (0.225, -0.143, 0.0042), (0.245, -0.143, 0.0042), (0.245, -0.117, 0.0042)]
