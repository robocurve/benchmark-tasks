            double size = 1
            float3 xformOp:scale = (0.0075, 0.2, 0.035)
            double3 xformOp:translate = (0.32655, 0, 0.14900000000000002)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
