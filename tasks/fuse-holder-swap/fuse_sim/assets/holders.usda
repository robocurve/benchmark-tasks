#usda 1.0
(
    defaultPrim = "holders"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "holders" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    rel material:binding:physics = </holders/PhysicsMaterials/pbt> (
        bindMaterialAs = "weakerThanDescendants"
    )
    custom bool physxArticulation:enabledSelfCollisions = 0
    custom int physxArticulation:solverPositionIterationCount = 32
    custom int physxArticulation:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "body"
        {
            token outputs:surface.connect = </holders/Looks/body/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.86, 0.84)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "carrier"
        {
            token outputs:surface.connect = </holders/Looks/carrier/Shader.outputs:surface>

