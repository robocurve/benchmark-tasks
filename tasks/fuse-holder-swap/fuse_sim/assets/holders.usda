        def Material "tex_tab0"
        {
            token outputs:surface.connect = </holders/Looks/tex_tab0/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </holders/Looks/tex_tab0/tex.outputs:rgb>
                float inputs:roughness = 0.7
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/tab.png@
                float2 inputs:st.connect = </holders/Looks/tex_tab0/st.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }

