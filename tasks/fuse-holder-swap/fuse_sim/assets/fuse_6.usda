        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        rel material:binding = </fuse/Looks/tex_print>
        point3f[] points = [(0.00455, 0.0026, -0.00855), (0.00455, 0.0026, 0.00855), (0.00455, -0.0026, 0.00855), (0.00455, -0.0026, -0.00855)]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
