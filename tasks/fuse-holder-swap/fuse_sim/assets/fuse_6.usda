#usda 1.0
(
    defaultPrim = "fuse"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "fuse" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    rel material:binding:physics = </fuse/PhysicsMaterials/nickel> (
        bindMaterialAs = "weakerThanDescendants"
    )
    float physics:mass = 0.009
    custom float physxRigidBody:maxDepenetrationVelocity = 0.3
    custom int physxRigidBody:solverPositionIterationCount = 32

    def "Looks"
    {
        def Material "fuse_tube"
        {
            token outputs:surface.connect = </fuse/Looks/fuse_tube/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.88, 0.87, 0.82)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "fuse_cap"
        {
            token outputs:surface.connect = </fuse/Looks/fuse_cap/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.79, 0.81)
                float inputs:metallic = 0.6
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "tex_print"
        {
            token outputs:surface.connect = </fuse/Looks/tex_print/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </fuse/Looks/tex_print/tex.outputs:rgb>
                float inputs:roughness = 0.7
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/fuse_6.png@
                float2 inputs:st.connect = </fuse/Looks/tex_print/st.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }
    }

    def Mesh "cap_lo" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxCollisionAPI"]
