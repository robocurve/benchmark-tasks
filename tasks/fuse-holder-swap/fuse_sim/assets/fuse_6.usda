        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        point3f[] points = [(0.0050510443, 0.0010047151, -0.01905), (0.0042820685, 0.0028611866, -0.01905), (0.0028611866, 0.0042820685, -0.01905), (0.0010047151, 0.0050510443, -0.01905), (-0.0010047151, 0.0050510443, -0.01905), (-0.0028611866, 0.0042820685, -0.01905), (-0.0042820685, 0.0028611866, -0.01905), (-0.0050510443, 0.0010047151, -0.01905), (-0.0050510443, -0.0010047151, -0.01905), (-0.0042820685, -0.0028611866, -0.01905), (-0.0028611866, -0.0042820685, -0.01905), (-0.0010047151, -0.0050510443, -0.01905), (0.0010047151, -0.0050510443, -0.01905), (0.0028611866, -0.0042820685, -0.01905), (0.0042820685, -0.0028611866, -0.01905), (0.0050510443, -0.0010047151, -0.01905), (0.0050510443, 0.0010047151, -0.00905), (0.0042820685, 0.0028611866, -0.00905), (0.0028611866, 0.0042820685, -0.00905), (0.0010047151, 0.0050510443, -0.00905), (-0.0010047151, 0.0050510443, -0.00905), (-0.0028611866, 0.0042820685, -0.00905), (-0.0042820685, 0.0028611866, -0.00905), (-0.0050510443, 0.0010047151, -0.00905), (-0.0050510443, -0.0010047151, -0.00905), (-0.0042820685, -0.0028611866, -0.00905), (-0.0028611866, -0.0042820685, -0.00905), (-0.0010047151, -0.0050510443, -0.00905), (0.0010047151, -0.0050510443, -0.00905), (0.0028611866, -0.0042820685, -0.00905), (0.0042820685, -0.0028611866, -0.00905), (0.0050510443, -0.0010047151, -0.00905)]
