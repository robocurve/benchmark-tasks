#usda 1.0
(
    defaultPrim = "Scene"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Z"
)
def Xform "Scene"
{
    def Xform "rig" (
        prepend references = @./assets/rig.usda@
    )
    {
        double3 xformOp:translate = (0.304, -0.07, 0.7475)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "bumper" (
        prepend references = @./assets/bumper.usda@
    )
    {
        double3 xformOp:translate = (0.21, -0.224, 0.7529)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
