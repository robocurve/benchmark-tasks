#usda 1.0
(
    defaultPrim = "Holder_18650_2x2"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Holder_18650_2x2" (
    "2x2 18650 cell holder (ABS). 20 mm pitch, bore r9.3 (0.3 mm radial clearance on the r9.0 cell), 0.8 mm 45 deg lead-in, 8.0 mm cup, 1.5 mm ledge with r7.0 window, M3 centre hole. Origin at the outer ledge face centre, +Z into the cups. Use one upright as the bottom and one flipped as the top."
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    point3f physics:centerOfMass = (3.2029893e-11, 2.3832076e-12, 0.004234884)
