        int[] faceVertexIndices = [0, 10, 11, 1, 7, 17, 18, 8, 4, 14, 15, 5, 1, 11, 12, 2, 8, 18, 19, 9, 5, 15, 16, 6, 2, 12, 13, 3, 9, 19, 10, 0, 6, 16, 17, 7, 3, 13, 14, 4, 10, 20, 21, 11, 17, 27, 28, 18, 14, 24, 25, 15, 11, 21, 22, 12, 18, 28, 29, 19, 15, 25, 26, 16, 12, 22, 23, 13, 19, 29, 20, 10, 16, 26, 27, 17, 13, 23, 24, 14, 24, 34, 35, 25, 21, 31, 32, 22, 28, 38, 39, 29, 25, 35, 36, 26, 22, 32, 33, 23, 29, 39, 30, 20, 26, 36, 37, 27, 23, 33, 34, 24, 20, 30, 31, 21, 27, 37, 38, 28, 31, 41, 42, 32, 38, 48, 49, 39, 35, 45, 46, 36, 32, 42, 43, 33, 39, 49, 40, 30, 36, 46, 47, 37, 33, 43, 44, 34, 30, 40, 41, 31, 37, 47, 48, 38, 34, 44, 45, 35, 48, 58, 59, 49, 45, 55, 56, 46, 42, 52, 53, 43, 49, 59, 50, 40, 46, 56, 57, 47, 43, 53, 54, 44, 40, 50, 51, 41, 47, 57, 58, 48, 44, 54, 55, 45, 41, 51, 52, 42, 55, 65, 66, 56, 52, 62, 63, 53, 59, 69, 60, 50, 56, 66, 67, 57, 53, 63, 64, 54, 50, 60, 61, 51, 57, 67, 68, 58, 54, 64, 65, 55, 51, 61, 62, 52, 58, 68, 69, 59, 62, 72, 73, 63, 69, 79, 70, 60, 66, 76, 77, 67, 63, 73, 74, 64, 60, 70, 71, 61, 67, 77, 78, 68, 64, 74, 75, 65, 61, 71, 72, 62, 68, 78, 79, 69, 65, 75, 76, 66, 76, 86, 87, 77, 73, 83, 84, 74, 70, 80, 81, 71, 77, 87, 88, 78, 74, 84, 85, 75, 71, 81, 82, 72, 78, 88, 89, 79, 75, 85, 86, 76, 72, 82, 83, 73, 79, 89, 80, 70, 83, 93, 94, 84, 80, 90, 91, 81, 87, 97, 98, 88, 84, 94, 95, 85, 81, 91, 92, 82, 88, 98, 99, 89, 85, 95, 96, 86, 82, 92, 93, 83, 89, 99, 90, 80, 86, 96, 97, 87, 90, 100, 101, 91, 97, 107, 108, 98, 94, 104, 105, 95, 91, 101, 102, 92, 98, 108, 109, 99, 95, 105, 106, 96, 92, 102, 103, 93, 99, 109, 100, 90, 96, 106, 107, 97, 93, 103, 104, 94, 107, 117, 118, 108, 104, 114, 115, 105, 101, 111, 112, 102, 108, 118, 119, 109, 105, 115, 116, 106, 102, 112, 113, 103, 109, 119, 110, 100, 106, 116, 117, 107, 103, 113, 114, 104, 100, 110, 111, 101, 114, 124, 125, 115, 111, 121, 122, 112, 118, 128, 129, 119, 115, 125, 126, 116, 112, 122, 123, 113, 119, 129, 120, 110, 116, 126, 127, 117, 113, 123, 124, 114, 110, 