#usda 1.0
(
    defaultPrim = "StripTray"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "StripTray" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "PLA tray for the 2x2 nickel strip: a 40 x 40 x 8 mm block with a 29 x 29 x 1 mm pocket on top (0.5 mm play round the strip), the strip lying flat in it with its tab up. Origin at the underside centre. Collides as its five boxes."
)
{
    float physics:mass = 0.004448748

    def "Looks"
    {
        def Material "PLA_Grey"
        {
            token outputs:surface.connect = </StripTray/Looks/PLA_Grey/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.57, 0.6)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Phys_PLA" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.45
        }
    }

    def Mesh "Tray" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.02, -0.02, 0), (0.02, 0.02, 0.007999999)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 3, 2, 2, 3, 7, 6, 6, 7, 5, 4, 4, 5, 1, 0, 2, 6, 4, 0, 7, 3, 1, 5, 8, 9, 11, 10, 10, 11, 15, 14, 14, 15, 13, 12, 12, 13, 9, 8, 10, 14, 12, 8, 15, 11, 9, 13, 16, 17, 19, 18, 18, 19, 23, 22, 22, 23, 21, 20, 20, 21, 17, 16, 18, 22, 20, 16, 23, 19, 17, 21, 24, 25, 27, 26, 26, 27, 31, 30, 30, 31, 29, 28, 28, 29, 25, 24, 26, 30, 28, 24, 31, 27, 25, 29, 32, 33, 35, 34, 34, 35, 39, 38, 38, 39, 37, 36, 36, 37, 33, 32, 34, 38, 36, 32, 39, 35, 33, 37]
        rel material:binding = </StripTray/Looks/PLA_Grey>
        point3f[] points = [(-0.02, -0.02, 0), (-0.02, -0.02, 0.007), (-0.02, 0.02, 0), (-0.02, 0.02, 0.007), (0.02, -0.02, 0), (0.02, -0.02, 0.007), (0.02, 0.02, 0), (0.02, 0.02, 0.007), (-0.02, 0.0145, 0.0069999998), (-0.02, 0.0145, 0.007999999), (-0.02, 0.02, 0.0069999998), (-0.02, 0.02, 0.007999999), (0.02, 0.0145, 0.0069999998), (0.02, 0.0145, 0.007999999), (0.02, 0.02, 0.0069999998), (0.02, 0.02, 0.007999999), (-0.02, -0.02, 0.0069999998), (-0.02, -0.02, 0.007999999), (-0.02, -0.0145, 0.0069999998), (-0.02, -0.0145, 0.007999999), (0.02, -0.02, 0.0069999998), (0.02, -0.02, 0.007999999), (0.02, -0.0145, 0.0069999998), (0.02, -0.0145, 0.007999999), (0.014499996, -0.0145, 0.0069999998), (0.014499996, -0.0145, 0.007999999), (0.014499996, 0.0145, 0.0069999998), (0.014499996, 0.0145, 0.007999999), (0.02, -0.0145, 0.0069999998), (0.02, -0.0145, 0.007999999), (0.02, 0.0145, 0.0069999998), (0.02, 0.0145, 0.007999999), (-0.02, -0.0145, 0.0069999998), (-0.02, -0.0145, 0.007999999), (-0.02, 0.0145, 0.0069999998), (-0.02, 0.0145, 0.007999999), (-0.0145, -0.0145, 0.0069999998), (-0.0145, -0.0145, 0.007999999), (-0.0145, 0.0145, 0.0069999998), (-0.0145, 0.0145, 0.007999999)]
        uniform token subdivisionScheme = "none"
    }

    def Scope "Colliders"
    {
        def Cube "Base" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </StripTray/Looks/Phys_PLA> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.001
            custom float physxCollision:restOffset = 0
            uniform token purpose = "guide"
            double size = 1
            float3 xformOp:scale = (0.04, 0.04, 0.007)
            double3 xformOp:translate = (0, 0, 0.0035)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Rim_Back" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </StripTray/Looks/Phys_PLA> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.001
            custom float physxCollision:restOffset = 0
            uniform token purpose = "guide"
            double size = 1
            float3 xformOp:scale = (0.04, 0.0055, 0.001)
            double3 xformOp:translate = (0, 0.01725, 0.0075)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Rim_Front" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </StripTray/Looks/Phys_PLA> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.001
            custom float physxCollision:restOffset = 0
            uniform token purpose = "guide"
            double size = 1
            float3 xformOp:scale = (0.04, 0.0055, 0.001)
            double3 xformOp:translate = (0, -0.01725, 0.0075)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Rim_Right" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </StripTray/Looks/Phys_PLA> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.001
            custom float physxCollision:restOffset = 0
            uniform token purpose = "guide"
            double size = 1
            float3 xformOp:scale = (0.0055, 0.029, 0.001)
            double3 xformOp:translate = (0.01725, 0, 0.0075)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Rim_Left" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </StripTray/Looks/Phys_PLA> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.001
            custom float physxCollision:restOffset = 0
            uniform token purpose = "guide"
            double size = 1
            float3 xformOp:scale = (0.0055, 0.029, 0.001)
            double3 xformOp:translate = (-0.01725, 0, 0.0075)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }
}

