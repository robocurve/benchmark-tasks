    def Scope "Colliders"
    {
        def Cube "Bar_Left" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </NickelStrip/Looks/Phys_Nickel> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.0002
            custom float physxCollision:restOffset = 0
            uniform token purpose = "guide"
            double size = 1
            float3 xformOp:scale = (0.008, 0.028, 0.0003)
            double3 xformOp:translate = (-0.01, 0, 0.00015)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
