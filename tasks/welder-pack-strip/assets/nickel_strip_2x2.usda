    def Scope "Marks"
    {
        def Cylinder "Spot_1a" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.00003
            rel material:binding = </NickelStrip/Looks/WeldSpot>
            double radius = 0.0006
            token visibility = "invisible"
            double3 xformOp:translate = (-0.0116, -0.01, 0.000165)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

