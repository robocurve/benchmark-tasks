#usda 1.0
(
    defaultPrim = "NickelStrip"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "NickelStrip" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "Nickel strip for a 2x2 18650 pack, cells in parallel: an H of 0.15 mm pure nickel (two 8 x 28 mm bars over the two cell pairs, 20 mm apart, joined by an 8 mm bridge), 28 x 28 mm, with a grip tab bent up from the bridge's middle and folded into a loop (8 mm wide, 10 mm tall, 3 mm across). Origin at the plate's underside centre, the bars along y. Cells sit under (+-10, +-10) mm. Marks/: the eight weld spots (two per cell), hidden until a weld. Collides as boxes 0.3 mm thick (the plate) and the tab's walls and top."
)
{
    float physics:mass = 0.0009549243
    custom float physxRigidBody:maxDepenetrationVelocity = 0.2
    custom float physxRigidBody:sleepThreshold = 0.00005
    custom int physxRigidBody:solverPositionIterationCount = 32
    custom int physxRigidBody:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "Nickel"
        {
            token outputs:surface.connect = </NickelStrip/Looks/Nickel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.71, 0.68)
                float inputs:metallic = 1
                float inputs:roughness = 0.32
                token outputs:surface
            }
        }

        def Material "WeldSpot"
        {
            token outputs:surface.connect = </NickelStrip/Looks/WeldSpot/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.09, 0.11)
                float inputs:metallic = 0.6
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Phys_Nickel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }
    }

    def Mesh "Plate" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.014, -0.014, 0), (0.014, 0.014, 0.00015)]
