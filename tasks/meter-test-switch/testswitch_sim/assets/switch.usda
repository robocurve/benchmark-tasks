#usda 1.0
(
    defaultPrim = "switch"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "switch" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 0
    custom int physxArticulation:solverPositionIterationCount = 16
    custom int physxArticulation:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "phenolic"
        {
            token outputs:surface.connect = </switch/Looks/phenolic/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.04, 0.04, 0.045)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "tin"
        {
            token outputs:surface.connect = </switch/Looks/tin/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.8, 0.78)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

