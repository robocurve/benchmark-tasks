#usda 1.0
(
    defaultPrim = "lead"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "lead" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 0
    custom int physxArticulation:solverPositionIterationCount = 32
    custom int physxArticulation:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "test_set"
        {
            token outputs:surface.connect = </lead/Looks/test_set/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.72, 0.1)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "panel"
        {
            token outputs:surface.connect = </lead/Looks/panel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15, 0.15, 0.16)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "lead"
        {
            token outputs:surface.connect = </lead/Looks/lead/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.08, 0.08)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "red"
        {
            token outputs:surface.connect = </lead/Looks/red/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.06, 0.05)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "black"
        {
            token outputs:surface.connect = </lead/Looks/black/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.05)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "copper"
        {
            token outputs:surface.connect = </lead/Looks/copper/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.45, 0.2)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "white"
        {
            token outputs:surface.connect = </lead/Looks/white/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.95, 0.95)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

    def Xform "test_set" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 2
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Cube "case" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </lead/Looks/test_set>
            custom float physxCollision:contactOffset = 0.001
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.2, 0.15, 0.1)
            double3 xformOp:translate = (0.36, 0.46, 0.0475)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "panel" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </lead/Looks/panel>
            double size = 1
            float3 xformOp:scale = (0.18, 0.13, 0.001)
            double3 xformOp:translate = (0.36, 0.46, 0.098)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cylinder "socket" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token axis = "Y"
            double height = 0.008
            rel material:binding = </lead/Looks/black>
            double radius = 0.006
            double3 xformOp:translate = (0.32, 0.387, 0.025)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

