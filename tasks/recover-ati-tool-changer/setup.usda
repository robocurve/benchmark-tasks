#usda 1.0
(
    defaultPrim = "Scene"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Z"
)
def Xform "Scene"
{
    def Xform "rig" (
        prepend references = @./assets/rig.usda@
    )
    {
        double3 xformOp:translate = (0.286, 0, 0.7475)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "plate" (
        prepend references = @./assets/plate.usda@
    )
    {
        double3 xformOp:translate = (0.286, 0.025, 0.7695)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "stand" (
        prepend references = @./assets/stand.usda@
    )
    {
        double3 xformOp:translate = (0.286, 0.197, 0.7475)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
