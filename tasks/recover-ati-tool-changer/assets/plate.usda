#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Z"
)
def Xform "Asset"
{
    def Xform "plate" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 0.07
        def Cylinder "ToolPlate" (
            prepend apiSchemas = ["PhysxCollisionAPI", "PhysicsCollisionAPI"]
        )
        {
        float physxCollision:contactOffset = 0.0003
        float physxCollision:restOffset = 0
            double radius = 0.0185
            double height = 0.014
            uniform token axis = "Z"
            double3 xformOp:translate = (0, 0, 0.007)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(0.055, 0.082, 0.112)]
        }
        def Cube "TestTool" (
            prepend apiSchemas = ["PhysxCollisionAPI", "PhysicsCollisionAPI"]
        )
        {
        float physxCollision:contactOffset = 0.0003
        float physxCollision:restOffset = 0
            double size = 1
            double3 xformOp:translate = (0, 0.039, 0.012)
            float3 xformOp:scale = (0.018, 0.071, 0.01)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.56, 0.62, 0.66)]
        }
        def Cube "SupportGrip" (
            prepend apiSchemas = ["PhysxCollisionAPI", "PhysicsCollisionAPI"]
        )
        {
        float physxCollision:contactOffset = 0.0003
        float physxCollision:restOffset = 0
            double size = 1
            double3 xformOp:translate = (0, 0.077, 0.02)
            float3 xformOp:scale = (0.023, 0.025, 0.022)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.04, 0.38, 0.62)]
        }
    }
}
