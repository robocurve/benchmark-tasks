#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Z"
)
def Xform "Asset" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
)
{
    def Xform "base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 0.48
        def Cube "BenchFoot" (
            prepend apiSchemas = ["PhysxCollisionAPI", "PhysicsCollisionAPI"]
        )
        {
        float physxCollision:contactOffset = 0.0003
        float physxCollision:restOffset = 0
            double size = 1
            double3 xformOp:translate = (0, -0.04, 0.003)
            float3 xformOp:scale = (0.084, 0.147, 0.006)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.055, 0.082, 0.112)]
        }
        def Cube "Bracket" (
            prepend apiSchemas = ["PhysxCollisionAPI", "PhysicsCollisionAPI"]
        )
        {
        float physxCollision:contactOffset = 0.0003
        float physxCollision:restOffset = 0
            double size = 1
            double3 xformOp:translate = (0, -0.025, 0.026)
            float3 xformOp:scale = (0.036, 0.022, 0.048)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.055, 0.082, 0.112)]
        }
        def Cylinder "QCMasterEnvelope" (
            prepend apiSchemas = ["PhysxCollisionAPI", "PhysicsCollisionAPI"]
        )
        {
        float physxCollision:contactOffset = 0.0003
        float physxCollision:restOffset = 0
            double radius = 0.019
            double height = 0.009
            uniform token axis = "Z"
            double3 xformOp:translate = (0, 0.025, 0.047)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(0.055, 0.082, 0.112)]
        }
        def Cube "CoupledSupport" (
            prepend apiSchemas = ["PhysxCollisionAPI", "PhysicsCollisionAPI"]
        )
        {
        float physxCollision:contactOffset = 0.0003
        float physxCollision:restOffset = 0
            double size = 1
            double3 xformOp:translate = (0, 0.025, 0.02)
            float3 xformOp:scale = (0.037, 0.032, 0.004)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.56, 0.62, 0.66)]
        }
        def Cube "PortGuideSupport" (
            prepend apiSchemas = ["PhysxCollisionAPI", "PhysicsCollisionAPI"]
        )
        {
        float physxCollision:contactOffset = 0.0003
        float physxCollision:restOffset = 0
            double size = 1
            double3 xformOp:translate = (0, -0.063, 0.016)
            float3 xformOp:scale = (0.03, 0.062, 0.02)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.055, 0.082, 0.112)]
        }
        def Cylinder "PortBushing"
        {
            double radius = 0.006
            double height = 0.012
            uniform token axis = "X"
            double3 xformOp:translate = (0.007, -0.101, 0.04)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(0.56, 0.62, 0.66)]
        }
    }
    def PhysicsFixedJoint "mount"
    {
        rel physics:body1 = </Asset/base>
    }
    def Xform "key" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 0.026
        def Cylinder "BallEndStem" (
            prepend apiSchemas = ["PhysxCollisionAPI", "PhysicsCollisionAPI"]
        )
        {
        float physxCollision:contactOffset = 0.0003
        float physxCollision:restOffset = 0
            double radius = 0.00075
            double height = 0.028
            uniform token axis = "X"
            double3 xformOp:translate = (-0.006, -0.101, 0.04)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(0.56, 0.62, 0.66)]
        }
        def Cube "KeyHandle" (
            prepend apiSchemas = ["PhysxCollisionAPI", "PhysicsCollisionAPI"]
        )
        {
        float physxCollision:contactOffset = 0.0003
        float physxCollision:restOffset = 0
            double size = 1
            double3 xformOp:translate = (-0.024, -0.101, 0.04)
            float3 xformOp:scale = (0.021, 0.027, 0.01)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.92, 0.43, 0.12)]
        }
    }
    def PhysicsPrismaticJoint "release"
    {
        rel physics:body0 = </Asset/base>
        rel physics:body1 = </Asset/key>
        point3f physics:localPos0 = (0, 0, 0)
        point3f physics:localPos1 = (0, 0, 0)
        bool physics:collisionEnabled = false
        uniform bool physics:excludeFromArticulation = false
        uniform token physics:axis = "X"
        float physics:lowerLimit = 0
        float physics:upperLimit = 0.011
    }
}
