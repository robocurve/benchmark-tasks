    float physics:mass = 0.009
    custom int physxRigidBody:solverPositionIterationCount = 32
    custom int physxRigidBody:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "fuse_tube"
        {
            token outputs:surface.connect = </fuse/Looks/fuse_tube/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.84, 0.78)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "fuse_cap"
        {
            token outputs:surface.connect = </fuse/Looks/fuse_cap/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.79, 0.81)
                float inputs:metallic = 0.6
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }
    }

