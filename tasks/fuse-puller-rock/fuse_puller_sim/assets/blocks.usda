#usda 1.0
(
    defaultPrim = "blocks"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "blocks"
{
    def "Looks"
    {
        def Material "block"
        {
            token outputs:surface.connect = </blocks/Looks/block/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.06, 0.07)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "tin"
        {
            token outputs:surface.connect = </blocks/Looks/tin/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.81, 0.82)
                float inputs:metallic = 0.6
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "copper"
        {
            token outputs:surface.connect = </blocks/Looks/copper/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.45, 0.22)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "steel"
        {
            token outputs:surface.connect = </blocks/Looks/steel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.64, 0.67)
                float inputs:metallic = 0.6
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "pan"
        {
            token outputs:surface.connect = </blocks/Looks/pan/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.84, 0.85, 0.83)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "board"
        {
            token outputs:surface.connect = </blocks/Looks/board/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.42, 0.28)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "tex_fprock14r_circuit_tag_F1"
        {
            token outputs:surface.connect = </blocks/Looks/tex_fprock14r_circuit_tag_F1/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </blocks/Looks/tex_fprock14r_circuit_tag_F1/tex.outputs:rgb>
                float inputs:roughness = 0.7
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/fprock14r_circuit_tag_F1.png@
                float2 inputs:st.connect = </blocks/Looks/tex_fprock14r_circuit_tag_F1/st.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }

        def Material "tex_fprock14r_circuit_tag_F2"
        {
            token outputs:surface.connect = </blocks/Looks/tex_fprock14r_circuit_tag_F2/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </blocks/Looks/tex_fprock14r_circuit_tag_F2/tex.outputs:rgb>
                float inputs:roughness = 0.7
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/fprock14r_circuit_tag_F2.png@
                float2 inputs:st.connect = </blocks/Looks/tex_fprock14r_circuit_tag_F2/st.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }

        def Material "tex_fprock14r_circuit_tag_F3"
        {
            token outputs:surface.connect = </blocks/Looks/tex_fprock14r_circuit_tag_F3/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </blocks/Looks/tex_fprock14r_circuit_tag_F3/tex.outputs:rgb>
