            float3 xformOp:scale = (0.014, 0.0012, 0.0019826791)
            double3 xformOp:translate = (0.02, 0.004659081833977265, -0.0020743568796865812)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX", "xformOp:scale"]
        }
    }

    def "joints"
    {
        def PhysicsRevoluteJoint "arm_a_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </puller/hinge>
            rel physics:body1 = </puller/arm_a>
            point3f physics:localPos0 = (0, 0.0065, 0.0175)
            point3f physics:localPos1 = (0, 0.0065, 0.0175)
            float physics:lowerLimit = -2
            float physics:upperLimit = 8.5
        }

        def PhysicsRevoluteJoint "arm_b_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </puller/hinge>
            rel physics:body1 = </puller/arm_b>
            point3f physics:localPos0 = (0, -0.0065, 0.0175)
            point3f physics:localPos1 = (0, -0.0065, 0.0175)
            float physics:lowerLimit = -8.5
            float physics:upperLimit = 2
        }
    }

    def Xform "arm_b" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
