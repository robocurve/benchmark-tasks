#usda 1.0
(
    defaultPrim = "puller"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "puller" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    rel material:binding:physics = </puller/PhysicsMaterials/nylon> (
        bindMaterialAs = "weakerThanDescendants"
    )
    custom bool physxArticulation:enabledSelfCollisions = 0
    custom int physxArticulation:solverPositionIterationCount = 32
    custom int physxArticulation:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "nylon"
        {
            token outputs:surface.connect = </puller/Looks/nylon/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.96, 0.82, 0.1)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }
    }

    def Xform "hinge" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.01
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "loop" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </puller/Looks/nylon>
            custom float physxCollision:contactOffset = 0.002
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.008, 0.016, 0.012)
            double3 xformOp:translate = (-0.002, 0, 0.0175)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Xform "arm_a" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
    )
    {
        float physics:mass = 0.012
        custom int physxRigidBody:solverPositionIterationCount = 32
        custom int physxRigidBody:solverVelocityIterationCount = 4
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "arm" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </puller/Looks/nylon>
            rel material:binding:physics = </puller/PhysicsMaterials/smooth_nylon> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.002
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.0475, 0.003, 0.012)
            double3 xformOp:translate = (0.026250000000000002, 0.006500000000000001, 0.0175)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "handle" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </puller/Looks/nylon>
            rel material:binding:physics = </puller/PhysicsMaterials/notched_handle> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.002
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.071, 0.003, 0.012)
            double3 xformOp:translate = (0.08549999999999999, 0.006500000000000001, 0.0175)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "wing" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </puller/Looks/nylon>
            double size = 1
            float3 xformOp:scale = (0.006, 0.007, 0.017)
            double3 xformOp:translate = (0.043, 0.0085, 0.02)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "web" (
