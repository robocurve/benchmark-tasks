    def "PhysicsMaterials"
    {
        def Material "nylon" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.6
            float physics:staticFriction = 0.6
            custom token physxMaterial:frictionCombineMode = "average"
        }

        def Material "smooth_nylon" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.25
            float physics:staticFriction = 0.25
            custom token physxMaterial:frictionCombineMode = "min"
        }

        def Material "notched_handle" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.8
            float physics:staticFriction = 0.8
            custom token physxMaterial:frictionCombineMode = "max"
