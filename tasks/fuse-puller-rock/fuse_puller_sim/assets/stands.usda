        double size = 1
        float3 xformOp:scale = (0.015, 0.012, 0.0602)
        double3 xformOp:translate = (0.23550000000000004, -0.105, 0.030099999999999995)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "rest_foot" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
