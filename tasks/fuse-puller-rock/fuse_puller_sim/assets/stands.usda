#usda 1.0
(
    defaultPrim = "stands"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "stands"
{
    def "Looks"
    {
        def Material "stand"
        {
            token outputs:surface.connect = </stands/Looks/stand/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4, 0.4, 0.42)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "tray"
        {
            token outputs:surface.connect = </stands/Looks/tray/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15, 0.3, 0.7)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }
    }

    def Cube "rest_pad0" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </stands/Looks/stand>
        custom float physxCollision:contactOffset = 0.002
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.013, 0.044, 0.004)
        double3 xformOp:translate = (0.30150000000000005, -0.105, 0.06219999999999999)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "rest_post0" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </stands/Looks/stand>
        custom float physxCollision:contactOffset = 0.002
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.013, 0.012, 0.0602)
        double3 xformOp:translate = (0.30150000000000005, -0.105, 0.030099999999999995)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "rest_pad1" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </stands/Looks/stand>
        custom float physxCollision:contactOffset = 0.002
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.015, 0.044, 0.004)
        double3 xformOp:translate = (0.23550000000000004, -0.105, 0.06219999999999999)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

