#usda 1.0
(
    defaultPrim = "clamp"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "clamp" (
    customData = {
        string mechanism = "Native screw coupling and passive torsion spring; no thermometer attachment."
    }
)
{
    def "Looks"
    {
        def Material "chrome" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </clamp/Looks/chrome/surface.outputs:surface>
            float physics:dynamicFriction = 0.6
            float physics:restitution = 0
            float physics:staticFriction = 0.75

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.52, 0.55, 0.57)
                float inputs:metallic = 0.95
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }

        def Material "brass" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </clamp/Looks/brass/surface.outputs:surface>
            float physics:dynamicFriction = 0.56
            float physics:restitution = 0
            float physics:staticFriction = 0.7

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.47, 0.32, 0.13)
                float inputs:metallic = 0.83
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }

        def Material "knob" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </clamp/Looks/knob/surface.outputs:surface>
            float physics:dynamicFriction = 0.64
            float physics:restitution = 0
            float physics:staticFriction = 0.8

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.018, 0.02, 0.022)
                float inputs:metallic = 0.05
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "jaw_liner" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </clamp/Looks/jaw_liner/surface.outputs:surface>
            float physics:dynamicFriction = 1
            float physics:restitution = 0
            float physics:staticFriction = 1.25

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.13, 0.17, 0.16)
                float inputs:metallic = 0
                float inputs:roughness = 0.75
                token outputs:surface
            }
        }
    }

