#usda 1.0
(
    defaultPrim = "Thermometer"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Thermometer" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    customData = {
        string glass_optics = "Thin-walled optical envelope for real-time scale readability"
        string liquid_model = "Red spirit column; temperature supplied by task thermal model"
    }
)
{
    float physics:mass = 0.022
    custom double thermometer:celsius = 35

    def "Looks"
    {
        def Material "Glass"
        {
            token outputs:mdl:displacement.connect = </Thermometer/Looks/Glass/Shader.outputs:out>
            token outputs:mdl:surface.connect = </Thermometer/Looks/Glass/Shader.outputs:out>
            token outputs:mdl:volume.connect = </Thermometer/Looks/Glass/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniGlass.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniGlass"
                float inputs:depth = 0
                float inputs:frosting_roughness = 0.015
                color3f inputs:glass_color = (1, 1, 1)
                float inputs:glass_ior = 1.47
                color3f inputs:reflection_color = (0.72, 0.72, 0.72)
                bool inputs:thin_walled = 1
                token outputs:out
            }
        }

        def Material "Liquid"
        {
            token outputs:surface.connect = </Thermometer/Looks/Liquid/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.64, 0.005, 0.015)
                float inputs:roughness = 0.22
                token outputs:surface
            }
        }

        def Material "Backing"
        {
            token outputs:surface.connect = </Thermometer/Looks/Backing/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.92, 0.94, 0.91)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Cap"
        {
            token outputs:surface.connect = </Thermometer/Looks/Cap/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.025, 0.22, 0.39)
                float inputs:roughness = 0.27
                token outputs:surface
            }
        }

        def Material "Scale"
        {
            token outputs:surface.connect = </Thermometer/Looks/Scale/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Thermometer/Looks/Scale/Texture.outputs:rgb>
                float inputs:ior = 1
                float inputs:opacity.connect = </Thermometer/Looks/Scale/Texture.outputs:a>
                float inputs:opacityThreshold = 0.5
                float inputs:roughness = 0.7
                token outputs:surface
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @thermometer_scale.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Thermometer/Looks/Scale/UV.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float outputs:a
                color3f outputs:rgb
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
        }

        def Material "Capillary"
        {
            token outputs:surface.connect = </Thermometer/Looks/Capillary/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.74, 0.72)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }
    }

    def Mesh "GlassStem" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4]
