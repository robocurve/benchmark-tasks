    def Xform "stick" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        float physics:mass = 0.17
        custom bool physxArticulation:enabledSelfCollisions = 0
        custom int physxArticulation:solverPositionIterationCount = 32
        custom int physxArticulation:solverVelocityIterationCount = 4
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Cube "end_cap" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
            rel material:binding = </stick/Looks/black>
            rel material:binding:physics = </stick/PhysicsMaterials/grip> (
                bindMaterialAs = "weakerThanDescendants"
            )
            double size = 1
            float3 xformOp:scale = (0.055, 0.032, 0.032)
            double3 xformOp:translate = (-0.0575, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cylinder "tube" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "X"
            double height = 0.245
            rel material:binding = </stick/Looks/yellow>
            rel material:binding:physics = </stick/PhysicsMaterials/grip> (
                bindMaterialAs = "weakerThanDescendants"
            )
            double radius = 0.016
            double3 xformOp:translate = (0.0925, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cylinder "handgrip" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token axis = "X"
            double height = 0.094
