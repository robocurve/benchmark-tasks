#usda 1.0
(
    defaultPrim = "bench"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "bench"
{
    def "Looks"
    {
        def Material "case"
        {
            token outputs:surface.connect = </bench/Looks/case/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.66, 0.71, 0.74)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "case_top"
        {
            token outputs:surface.connect = </bench/Looks/case_top/Shader.outputs:surface>

            def Shader "Shader"
            {
