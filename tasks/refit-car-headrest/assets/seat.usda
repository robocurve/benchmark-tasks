#usda 1.0
(
    defaultPrim = "seat"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "seat"
{
    def Scope "Looks"
    {
        def Material "trim"
        {
            token outputs:surface.connect = </seat/Looks/trim/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.24, 0.23, 0.22)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "bezel"
        {
            token outputs:surface.connect = </seat/Looks/bezel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.06, 0.07)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "button"
        {
            token outputs:surface.connect = </seat/Looks/button/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.42, 0.42, 0.44)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "trim_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.6
        }

        def Material "plastic_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.25
            float physics:restitution = 0
            float physics:staticFriction = 0.3
        }

        def Material "pom_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.15
            float physics:restitution = 0
            float physics:staticFriction = 0.2
        }
    }

    def Scope "Geometry"
    {
        def Xform "seat" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "PhysicsMassAPI"]
        )
